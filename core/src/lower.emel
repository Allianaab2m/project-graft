## The lowered module, or what could not be lowered.
pub enum Lowered {
  LoweredModule(module: Module)
  LowerErrors(messages: List[String])
}

## A function instance to lower: its index in the module, the definition and the type arguments.
## `role` is 0 for a fn or const, and for a handler 1 for its init, 2 for the function making its
## handler value from its `self`, 3 for its release.
type Instance(id: Int, def: Int, args: List[Type], role: Int)

type Lowering(
  program: Program,
  checked: Typeck.Checked,
  module: Module,
  ## Instance keys → function indices.
  instances: Map[String, Int],
  ## Instances to lower, oldest first.
  queue: List[Instance],
  ## The type arguments of the instance being lowered.
  subst: List[Type],
  ## HIR locals → IR locals.
  locals: Map[Int, Int],
  next_local: Int,
  ## Newest first.
  errors: List[String],
  sources: Map[Int, Array[Int]],
  ## The built-in Bytes and Array types → their definitions.
  intrinsic_types: Map[String, Int],
  ## The local holding the evidence table where the expression being lowered runs.
  ev: Int,
  ## The `with` expressions of the definition around the expression, innermost first: the
  ## evidence table after the handler, and the keys of the effects it provides.
  withs: List[(Int, List[String])],
)

fn st() -> Lowering uses { State[Lowering] } {
  (use State[Lowering]).get()
}

fn upd(f: fn(Lowering) -> Lowering) -> () uses { State[Lowering] } {
  s = use State[Lowering]
  s.set(f(s.get()))
}

fn unsupported(what: String) -> Expr uses { State[Lowering] } {
  upd(|l| Lowering(errors: [what, ..l.errors], ..l))
  XLit(VUnit)
}

fn set_module(f: fn(Module) -> Module) -> () uses { State[Lowering] } {
  upd(|l| Lowering(module: f(l.module), ..l))
}

## Lowers the instances reachable from the entry's `main`.
pub fn lower(
  checked: Typeck.Checked,
  entry: Option[Int],
  sources: Map[Int, Array[Int]],
) -> Lowered {
  program = checked.program
  main = entry.and_then(|m| program.modules.get(m)).and_then(|items| {
    items.items.find(|d| def_of(program, d).name == "main" && def_of(program, d).kind == FnKind)
  })
  main match {
    None -> LowerErrors(["the entry has no `main`"])
    Some(root) -> {
      start = Lowering(
        program,
        checked,
        empty_module(),
        Map.empty(),
        [],
        [],
        Map.empty(),
        0,
        [],
        sources,
        Map.empty(),
        -1,
        [],
      )
      (_, done) = State.run(start, || {
        instance(root, [])
        drain()
      })
      if done.errors.is_empty() {
        LoweredModule(done.module)
      } else {
        LowerErrors(done.errors.reverse())
      }
    }
  }
}

fn drain() -> () uses { State[Lowering] } {
  st().queue match {
    [] -> ()
    [next, ..rest] -> {
      upd(|l| Lowering(queue: rest, ..l))
      lower_fn(next)
      drain()
    }
  }
}

# ---------------------------------------------------------------------------------------------
# Instances

## The function index of `def` instantiated with `args`, queued for lowering the first time.
fn instance(def: Int, args: List[Type]) -> Int uses { State[Lowering] } {
  instance_of(def, args, 0)
}

fn instance_of(def: Int, args: List[Type], role: Int) -> Int uses { State[Lowering] } {
  key = "#{role}:#{def}#{String.concat(args.map(|a| "/#{type_key(a)}"))}"
  st().instances.get(key) match {
    Some(id) -> id
    None -> {
      id = st().instances.size()
      upd(
        |l| Lowering(
          instances: l.instances.insert(key, id),
          queue: l.queue.append([Instance(id, def, args, role)]),
          ..l,
        ),
      )
      id
    }
  }
}

## The name of a definition in the output: its module's path and its name (`Std_Process_exit`).
fn def_name(def: Int) -> String {
  program = st().program
  data = def_of(program, def)
  module = data.module match {
    SourceModule(m) -> program.modules.get(m).map(|items| items.name).or([])
    _               -> []
  }
  String.join(module.append([data.name]), "_")
}

fn lower_fn(inst: Instance) -> () uses { State[Lowering] } {
  if inst.role != 0 {
    lower_handler_part(inst)
  } else {
    lower_plain_fn(inst)
  }
}

## Every function and lambda takes the evidence table as its last parameter (the reference passes
## it only to those whose R needs it); calls pass the caller's.
fn fresh_ev() -> Int uses { State[Lowering] } {
  ev = fresh_local("ev", Ir.CEvidence, None)
  upd(|l| Lowering(ev:, ..l))
  ev
}

## Runs `f` for the body of a closure, which takes its own evidence table. Returns its local.
## `use E` in a closure looks at the `with`s around it in the same definition first, then at its
## caller: the closure's evidence is the caller's with those handlers on top.
fn in_closure(f: fn() -> Expr uses { State[Lowering] }) -> (Int, Expr) uses { State[Lowering] } {
  outer = st().ev
  ev = fresh_ev()
  withs = st().withs
  (_, bindings) = withs.fold(([], []), |(seen, acc), (w, keys)| {
    keys.fold((seen, acc), |(s, a), k| {
      if s.any(|x| x == k) { (s, a) } else { (s.append([k]), a.append([(k, Ir.XUse(XVar(w), k))])) }
    })
  })
  out = if bindings.is_empty() {
    f()
  } else {
    inner = fresh_ev()
    body = f()
    XLet(inner, Ir.XProvide(Some(XVar(ev)), bindings), body)
  }
  upd(|l| Lowering(ev: outer, ..l))
  (ev, out)
}

fn ev_var() -> Expr uses { State[Lowering] } {
  XVar(st().ev)
}

fn lower_plain_fn(inst: Instance) -> () uses { State[Lowering] } {
  upd(|l| Lowering(withs: [], ..l))
  program = st().program
  def = inst.def
  parts = program.items.get(def) match {
    Some(IFn(f))          -> Some((f.sig.params, f.body))
    Some(Hir.IConst(c))   -> Some(([], Some(c.value)))
    Some(Hir.ITraitFn(f)) -> Some((f.sig.params, f.body))
    Some(_)               -> None
    None                  -> impl_fn(program, def).map(|(_, f)| (f.params, f.body))
  }
  external = program.items.get(def) match {
    Some(IFn(f)) if f.is_external -> Some(f)
    _                             -> None
  }
  (parts, external) match {
    (Some((params, _)), Some(f)) -> {
      upd(|l| Lowering(locals: Map.empty(), subst: inst.args, ..l))
      locals = params.map(|p| new_local(p.local))
      bindings = f.externals.map(|x| Ir.ExternalBinding(x.target, host_ref(def, x.args)))
      ret = Signature.get(st().checked.sigs, def).map(|sig| sig.scheme.ty) match {
        Some(TyFn(t)) -> lower_type(t.ret)
        _             -> CUnit
      }
      name = "#{def_name(def)}$#{inst.id}"
      fun = Function(
        name,
        False,
        locals,
        ret,
        0,
        False,
        XLit(VUnit),
        Some(Ir.External(bindings)),
        False,
        False,
        def_of(program, def).name,
      )
      set_module(|m| Module(functions: m.functions.insert(inst.id, fun), ..m))
    }
    (Some((params, Some(body))), None) -> {
      upd(|l| Lowering(locals: Map.empty(), subst: inst.args, ..l))
      main = def_of(program, def).name == "main" && inst.id == 0
      constant = def_of(program, def).kind == Hir.ConstKind
      plain = params.map(|p| new_local(p.local))
      ev = fresh_ev()
      # The launcher calls `main`, and a const is called, without an evidence table.
      locals = if main || constant { plain } else { plain.append([ev]) }
      ret = expr_type(body)
      body0 = lower_expr(body)
      lowered = if main || constant { XLet(ev, Ir.XProvide(None, []), body0) } else { body0 }
      name = if main { "main" } else { "#{def_name(def)}$#{inst.id}" }
      # The exit code `main` returns is set by `exit_with` of Std.Process.
      exit_with = if main { exit_code_setter(ret) } else { None }
      value = exit_with.map(|f| XCall(Direct(f, []), [lowered, ev_var()], False, False)).or(lowered)
      display = def_of(program, def).name
      fun = Function(name, main, locals, ret, 0, False, value, None, False, constant, display)
      set_module(|m| Module(functions: m.functions.insert(inst.id, fun), ..m))
    }
    _ -> {
      unsupported("a fn without a body: #{def_name(def)}")
      ()
    }
  }
}

## What an `@external` points to: a global name, or a name exported by a module. A module written
## `./x.mjs` in a bundled source is a bundled file (`std/x.mjs`); in a project source, a file next
## to it.
fn host_ref(def: Int, args: List[String]) -> Ir.HostRef uses { State[Lowering] } {
  args match {
    [module, name] -> {
      program = st().program
      bundled = def_of(program, def).module match {
        SourceModule(m) -> program.modules.get(m).map(|items| items.is_core).or(False)
        _               -> False
      }
      file = String.concat(module.code_points().drop(2).filter_map(String.from_code_point))
      host = if module.starts_with("./") && bundled {
        Ir.ModBundled("std/#{file}")
      } else if module.starts_with("./") || module.starts_with("../") {
        Ir.ModFile(module)
      } else {
        Ir.ModNamed(module)
      }
      Ir.HostImport(host, name)
    }
    [name] -> Ir.HostGlobal(name)
    _      -> Ir.HostGlobal("undefined")
  }
}

## For an `ExitCode` of Std.Process, the instance of its `exit_with`.
fn exit_code_setter(ret: Type) -> Option[Int] uses { State[Lowering] } {
  program = st().program
  ret match {
    CEnum(def, []) if def_name(def) == "Std_Process_ExitCode" -> {
      module = def_of(program, def).module match {
        SourceModule(m) -> program.modules.get(m)
        _               -> None
      }
      module.and_then(|items| items.items.find(|d| def_of(program, d).name == "exit_with")).map(
        |d| instance(d, []),
      )
    }
    _ -> None
  }
}

## Allocates the IR local for a HIR local.
fn new_local(local: Int) -> Int uses { State[Lowering] } {
  l = st()
  hint = l.program.locals.get(local).map(|d| d.name).or("v")
  ty = l.checked.types.locals.get(local).map(lower_type).or(CUnit)
  fresh_local(hint, ty, Some(local))
}

fn fresh_local(hint: String, ty: Type, hir: Option[Int]) -> Int uses { State[Lowering] } {
  id = st().next_local
  upd(|x| {
    locals = hir.map(|h| x.locals.insert(h, id)).or(x.locals)
    Lowering(
      next_local: id + 1,
      locals:,
      module: Module(locals: x.module.locals.insert(id, LocalData(hint, ty)), ..x.module),
      ..x,
    )
  })
  id
}

fn expr_type(expr: Int) -> Type uses { State[Lowering] } {
  st().checked.types.exprs.get(expr).map(lower_type).or(CUnit)
}

# ---------------------------------------------------------------------------------------------
# Types

## The IR type of a checked type, with the type parameters of the instance being lowered
## replaced by its type arguments.
fn lower_type(ty: Ty) -> Type uses { State[Lowering] } {
  convert(ty, st().subst)
}

## `TyBound(i)` becomes `subst[i]`, or `CParam(i)` past its end (in the field types of enums). A
## type variable left undetermined becomes `()`.
fn convert(ty: Ty, subst: List[Type]) -> Type uses { State[Lowering] } {
  c = |t: Ty| convert(t, subst)
  ty match {
    TyPrim(PInt)       -> CInt
    TyPrim(PInt64)     -> CInt64
    TyPrim(PFloat)     -> CFloat
    TyPrim(PBool)      -> CBool
    TyPrim(PString)    -> CString
    TyNever            -> CNever
    TyTuple(elems)     -> CTuple(elems.map(c))
    TyList(elem)       -> CList(c(elem))
    TyFn(f)            -> CFn(pure_fn(f.params.map(c), c(f.ret)))
    TyBound(i)         -> subst.get(i).or(CParam(i))
    TyNamed(con, args) -> named_type(con_def(st().checked.table, con), args.map(c))
    _                  -> CUnit
  }
}

## A named type: the built-in Bytes and Array, or an enum (registered on first use).
fn named_type(def: Int, args: List[Type]) -> Type uses { State[Lowering] } {
  program = st().program
  program.items.get(def) match {
    Some(IType(t)) if t.is_intrinsic -> {
      ty = args.head().map(CArray).or(CBytes)
      key = if args.is_empty() { "Bytes" } else { "Array" }
      upd(|l| Lowering(intrinsic_types: l.intrinsic_types.insert(key, def), ..l))
      ty
    }
    _ -> {
      enum_def(def)
      ty = CEnum(def, args)
      register_show(ty, def)
      ty
    }
  }
}

## A type with a written Show impl is shown through it. Option's impl in core shows the same as
## its structure.
fn register_show(ty: Type, def: Int) -> () uses { State[Lowering] } {
  key = type_key(ty)
  if !st().module.show_impls.contains(key) && def != option_def() {
    show_trait = Tylower.prelude_def(st().program, "Show")
    written = show_trait.and_then(|t| written_impl_fn(t, def, "show"))
    when_some(written, |(f, head)| {
      args = impl_args(head, ty)
      # Recorded before the instance, so a recursive type ends.
      set_module(|m| Module(show_impls: m.show_impls.insert(key, -1), ..m))
      id = instance(f, args)
      set_module(|m| Module(show_impls: m.show_impls.insert(key, id), ..m))
    })
  }
}

fn when_some[A](o: Option[A], f: fn(A) -> ()) -> () {
  o match {
    Some(x) -> f(x)
    None    -> ()
  }
}

# ---------------------------------------------------------------------------------------------
# Traits

## The written impl of `trait_def` for the type `head` and its fn `name`, with the impl's head.
## None for a derived impl, or an impl without that fn.
fn written_impl_fn(trait_def: Int, head: Int, name: String) -> Option[(Int, Traits.ImplHead)]
  uses { State[Lowering] } {
  traits = st().checked.traits
  if traits.derived.contains((trait_def, head)) {
    None
  } else {
    traits.impls.get((trait_def, head)).and_then(|impl_def| {
      found = st().program.items.get(impl_def) match {
        Some(Hir.IImpl(item)) -> item.fns.find(|f| f.name.name == name).map(|f| f.def)
        _                     -> None
      }
      found.and_then(|f| traits.heads.get(impl_def).map(|h| (f, h)))
    })
  }
}

## The impl's type arguments: what its type parameters stand for in the concrete type `ty`.
fn impl_args(head: Traits.ImplHead, ty: Type) -> List[Type] uses { State[Lowering] } {
  bound = match_type(head.self_ty, ty, Map.empty())
  List.range(0, head.params.length()).map(|i| bound.get(i).or(CUnit))
}

fn match_type(pattern: Ty, ty: Type, acc: Map[Int, Type]) -> Map[Int, Type] {
  (pattern, ty) match {
    (TyBound(i), _)                -> acc.insert(i, ty)
    (TyNamed(_, ps), CEnum(_, ts)) -> ps.zip(ts).fold(acc, |a, (p, t)| match_type(p, t, a))
    (TyNamed(_, ps), CArray(t))    -> ps.head().map(|p| match_type(p, t, acc)).or(acc)
    (TyList(p), CList(t))          -> match_type(p, t, acc)
    (TyTuple(ps), CTuple(ts))      -> ps.zip(ts).fold(acc, |a, (p, t)| match_type(p, t, a))
    _                              -> acc
  }
}

## The definition of the head of a type, as the type checker's impl table has it.
fn head_def(ty: Type) -> Option[Int] uses { State[Lowering] } {
  program = st().program
  prelude = |name: String| Tylower.prelude_def(program, name)
  ty match {
    CEnum(id, _) -> Some(id)
    CInt         -> prelude("Int")
    CInt64       -> prelude("Int64")
    CFloat       -> prelude("Float")
    CBool        -> prelude("Bool")
    CString      -> prelude("String")
    CList(_)     -> prelude("List")
    CArray(_)    -> st().intrinsic_types.get("Array")
    CBytes       -> st().intrinsic_types.get("Bytes")
    _            -> None
  }
}

## A call of the trait function `def` with the type arguments `targs` (Self first): the impl's fn
## for Self, the trait's default body, or what the compiler provides for built-in and derived
## impls (`==`, the structural comparison, the structural show).
fn trait_call(def: Int, targs: List[Type], args: List[Expr]) -> Expr uses { State[Lowering] } {
  program = st().program
  data = def_of(program, def)
  self_ty = targs.head().or(CUnit)
  trait_def = data.parent.or(-1)
  name = data.name
  written = head_def(self_ty).and_then(|h| written_impl_fn(trait_def, h, name))
  written match {
    Some((f, head)) -> {
      id = instance(f, impl_args(head, self_ty).append(targs.drop(1)))
      XCall(Direct(id, []), args.append([ev_var()]), False, False)
    }
    None -> {
      trait_name = def_of(program, trait_def).name
      prelude = trait_name == "Eq" || trait_name == "Ord" || trait_name == "Show"
      default = program.items.get(def) match {
        Some(Hir.ITraitFn(t)) -> t.body.is_some()
        _                     -> False
      }
      if default && !prelude {
        XCall(Direct(instance(def, targs), []), args.append([ev_var()]), False, False)
      } else {
        builtin_trait_call(trait_name, name, self_ty, args)
      }
    }
  }
}

## What the compiler provides for the Prelude's Eq, Ord and Show on built-in and derived impls.
fn builtin_trait_call(trait_name: String, name: String, ty: Type, args: List[Expr]) -> Expr
  uses { State[Lowering] } {
  a = args.get(0).or(XLit(VUnit))
  b = args.get(1).or(XLit(VUnit))
  (trait_name, name) match {
    ("Eq", "eq")     -> XBinary(BEq, op_ty(ty), a, b)
    ("Ord", "compare") -> {
      when_some(Tylower.prelude_def(st().program, "Ordering"), |o| {
        enum_def(o)
        set_module(|m| Module(ordering: Some(o), ..m))
      })
      XBuiltin("$compareValues", [ty], [a, b])
    }
    ("Show", "show") -> XBuiltin("$showValue", [ty], [a])
    _                -> unsupported("#{trait_name}.#{name} of a built-in or derived impl")
  }
}

## Registers the enum of a type, enum or error definition, with the field types of its variants
## in terms of its type parameters.
fn enum_def(def: Int) -> () uses { State[Lowering] } {
  if !st().module.enums.contains(def) {
    program = st().program
    # Registered first, so recursive types end.
    placeholder = EnumDef(def_name(def), 0, [], False, False, False)
    set_module(|m| Module(enums: m.enums.insert(def, placeholder), ..m))
    (params, ctors, is_error) = program.items.get(def) match {
      Some(IType(t))        -> (t.type_params.length(), t.ctor.map(|c| [c]).or([]), False)
      Some(IEnum(e))        -> (e.type_params.length(), e.variants, False)
      Some(Hir.IError(_))   -> (0, [def], True)
      Some(Hir.IHandler(h)) -> (0, h.ctor.map(|c| [c]).or([]), False)
      _                     -> (0, [], False)
    }
    variants = ctors.map(variant_def)
    name = if def == option_def() { "Option" } else { def_name(def) }
    external = program.items.get(def) match {
      Some(IType(t)) -> t.ctor.is_none()
      _              -> False
    }
    show_def = Tylower.prelude_def(program, "Show")
    shown = program.items.get(def) match {
      Some(Hir.IError(e)) -> e.derives.any(|(r, _)| Some(r) == show_def.map(ResDef))
      _                   -> False
    }
    done = EnumDef(name, params, variants, is_error, external, shown)
    set_module(|m| Module(enums: m.enums.insert(def, done), ..m))
  }
}

fn option_def() -> Int uses { State[Lowering] } {
  Tylower.prelude_def(st().program, "Option").or(-1)
}

fn ctor_fields(ctor: Int) -> Hir.Fields uses { State[Lowering] } {
  st().program.items.get(ctor) match {
    Some(ICtor(c))      -> c.fields
    Some(Hir.IError(e)) -> e.fields
    _                   -> NoFields
  }
}

fn variant_def(ctor: Int) -> VariantDef uses { State[Lowering] } {
  name = def_of(st().program, ctor).name
  sig_ty = Signature.get(st().checked.sigs, ctor).map(|s| s.scheme.ty)
  tys = sig_ty match {
    Some(TyFn(f)) -> f.params.map(|p| convert(p, []))
    _             -> []
  }
  fields = ctor_fields(ctor) match {
    NoFields            -> FieldsUnit
    NamedFields(fs)     -> FieldsNamed(fs.map(|f| f.name))
    PositionalFields(t) -> FieldsPositional(t.length())
  }
  VariantDef(name, fields, tys)
}

## The constructor reference of a constructor definition.
fn ctor_ref(ctor: Int) -> CtorRef uses { State[Lowering] } {
  program = st().program
  program.items.get(ctor) match {
    Some(ICtor(c)) -> {
      enum_def(c.owner)
      index = program.items.get(c.owner) match {
        Some(IEnum(e)) -> e.variants.enumerate().find(|(_, v)| v == ctor).map(|(i, _)| i).or(0)
        _              -> 0
      }
      CtorRef(c.owner, index)
    }
    _ -> {
      enum_def(ctor)
      CtorRef(ctor, 0)
    }
  }
}

# ---------------------------------------------------------------------------------------------
# Expressions

fn lower_expr(expr: Int) -> Expr uses { State[Lowering] } {
  program = st().program
  program.exprs.get(expr) match {
    None -> unsupported("a missing expression")
    Some(e) -> e.kind match {
      ELit(lit)             -> XLit(literal(lit, expr_type(expr)))
      EUnit                 -> XLit(VUnit)
      EPath(ResLocal(local)) -> st().locals.get(local).map(XVar).or(XLit(VUnit))
      EPath(ResDef(def))    -> def_value(expr, def)
      EInterpolated(parts) -> XConcat(
        parts.map(|p| {
          p match {
            SText(text) -> SLit(text)
            SInterp(x)  -> SValue(lower_expr(x), expr_type(x))
          }
        }),
      )
      ECall(callee, args)   -> lower_call(expr, callee, args.map(|a| a.value))
      EField(base, _)       -> field_value(expr, base)
      EBinary(OpPipe, lhs, rhs) -> program.exprs.get(rhs).map(|r| r.kind) match {
        Some(ECall(callee, args)) -> lower_call(expr, callee, [lhs, ..args.map(|a| a.value)])
        _                         -> lower_call(expr, rhs, [lhs])
      }
      EBinary(op, lhs, rhs) -> lower_binary(op, lhs, rhs)
      EUnary(OpNot, operand) -> XUnary(UNot, OpBool, lower_expr(operand))
      EUnary(OpNeg, operand) -> XUnary(UNeg, op_ty(expr_type(operand)), lower_expr(operand))
      ETuple(elems)         -> XTuple(elems.map(lower_expr))
      EList(elems, rest) -> {
        elem = expr_type(expr) match {
          CList(t) -> t
          _        -> CUnit
        }
        XList(elem, elems.map(lower_expr), rest.map(lower_expr))
      }
      EIf(c, t, el)         -> XIf(lower_expr(c), lower_expr(t), el.map(lower_expr).or(XLit(VUnit)))
      EBlock(block)         -> lower_block(block.stmts, block.tail)
      EMatch(scrutinee, arms) -> {
        s = lower_expr(scrutinee)
        XMatch(
          s,
          arms.map(|arm| {
            pat = lower_pat(arm.pat)
            Arm(pat, arm.guard.map(lower_expr), lower_expr(arm.body))
          }),
        )
      }
      ELambda(params, body) -> {
        locals = params.map(|p| new_local(p.local))
        (ev, lowered) = in_closure(|| lower_expr(body))
        XLambda(locals.append([ev]), expr_type(expr), lowered, False)
      }
      Hir.EUpdate(ctor, _, base) -> lower_update(expr, ctor, base)
      Hir.EAssert(cond)     -> lower_assert(cond)
      Hir.EFail(inner)      -> XFail(lower_expr(inner))
      Hir.EEscape(inner, arms) -> {
        body = lower_expr(inner)
        Ir.XEscape(
          body,
          arms.map(|arm| {
            pat = lower_pat(arm.pat)
            Arm(pat, arm.guard.map(lower_expr), lower_expr(arm.body))
          }),
        )
      }
      Hir.EUse(_, _) -> st().checked.types.exprs.get(expr) match {
        Some(Ty.TyCap(tags)) -> tags.head() match {
          Some(t) -> Ir.XUse(ev_var(), effect_key(t))
          None    -> unsupported("use")
        }
        Some(t) -> unsupported("use of #{type_key(lower_type(t))}")
        None    -> unsupported("use without a type")
      }
      Hir.EWith(items, body) -> lower_with(items, body)
      _                     -> unsupported("this kind of expression")
    }
  }
}

## `C(f: e, ..base)`: the written fields in order, then the others from `base`, evaluated once.
fn lower_update(expr: Int, ctor: Int, base: Int) -> Expr uses { State[Lowering] } {
  program = st().program
  written = program.exprs.get(expr).map(|e| e.kind) match {
    Some(Hir.EUpdate(_, fields, _)) -> fields
    _                               -> []
  }
  ctor_def = program.exprs.get(ctor).map(|c| c.kind) match {
    Some(EPath(ResDef(d))) -> Some(d)
    _                      -> None
  }
  ctor_def match {
    None -> unsupported("this record update")
    Some(d) -> {
      ref = ctor_ref(d)
      names = ctor_fields(d) match {
        NamedFields(fs) -> fs.map(|f| f.name)
        _               -> []
      }
      # The written fields are evaluated in source order, before `base`.
      values = written.map(|a| {
        label = a.label.map(|l| l.name).or("")
        local = fresh_local(label, expr_type(a.value), None)
        (label, local, lower_expr(a.value))
      })
      b = lower_expr(base)
      bound = fresh_local("base", expr_type(base), None)
      args = names.enumerate().map(|(i, n)| {
        values.find(|(l, _, _)| l == n).map(|(_, local, _)| XVar(local)).or(
          XField(XVar(bound), ref, i),
        )
      })
      made = XLet(bound, b, XCtor(ref, enum_args(expr), args))
      values.reverse().fold(made, |acc, (_, local, v)| XLet(local, v, acc))
    }
  }
}

## `assert`: a comparison shows both sides when it is false (spec 13.2).
fn lower_assert(cond: Int) -> Expr uses { State[Lowering] } {
  program = st().program
  text = program.exprs.get(cond).map(|e| source_text(e.span)).or("")
  comparison = program.exprs.get(cond).map(|e| e.kind) match {
    Some(EBinary(op, lhs, rhs)) -> {
      bin = op match {
        OpEq -> Some(BEq)
        OpNe -> Some(BNe)
        OpLt -> Some(BLt)
        OpLe -> Some(BLe)
        OpGt -> Some(BGt)
        OpGe -> Some(BGe)
        _    -> None
      }
      bin.map(|b| (b, lhs, rhs))
    }
    _ -> None
  }
  comparison match {
    Some((b, lhs, rhs)) -> {
      ty = expr_type(lhs)
      l = lower_expr(lhs)
      r = lower_expr(rhs)
      Ir.XAssertCmp(b, op_ty(ty), ty, l, r, text)
    }
    None -> Ir.XAssertBool(lower_expr(cond), text)
  }
}

## The source text of a span.
fn source_text(span: Hir.Span) -> String uses { State[Lowering] } {
  st().sources.get(span.module).map(|src| {
    String.concat(src.slice(span.start, span.end).to_list().filter_map(String.from_code_point))
  }).or("")
}

## A reference to a definition as a value: a constructor without fields, a constructor or fn as a
## function value, `True` and `False`.
fn def_value(expr: Int, def: Int) -> Expr uses { State[Lowering] } {
  program = st().program
  data = def_of(program, def)
  bool_value(def) match {
    Some(b) -> XLit(VBool(b))
    None -> if data.kind == CtorKind || data.kind == Hir.ErrorKind {
      ref = ctor_ref(def)
      if field_count(ctor_fields(def)) == 0 {
        XCtor(ref, enum_args(expr), [])
      } else {
        # A constructor used as a function value.
        fn_ty = expr_type(expr)
        ptys = fn_ty match {
          CFn(f) -> f.params
          _      -> []
        }
        locals = ptys.map(|t| fresh_local("x", t, None))
        ev = fresh_local("ev", Ir.CEvidence, None)
        XLambda(locals.append([ev]), fn_ty, XCtor(ref, enum_args(expr), locals.map(XVar)), False)
      }
    } else {
      callable(expr, def) match {
        Some(f) if data.kind == Hir.ConstKind -> XCall(Direct(f, []), [], False, False)
        Some(f)                               -> XFn(f, [])
        None -> {
          # An intrinsic as a function value: a closure calling the builtin.
          fn_ty = expr_type(expr)
          ptys = fn_ty match {
            CFn(f) -> f.params
            _      -> []
          }
          locals = ptys.map(|t| fresh_local("x", t, None))
          (ev, made) = in_closure(|| {
            builtin_call(expr, def, locals.map(XVar)) match {
              Some(b) -> b
              None if data.kind == Hir.TraitFnKind -> trait_call(
                def,
                type_args(expr),
                locals.map(XVar),
              )
              None    -> unsupported("a reference to #{def_name(def)}")
            }
          })
          XLambda(locals.append([ev]), fn_ty, made, False)
        }
      }
    }
  }
}

fn field_count(fields: Hir.Fields) -> Int {
  fields match {
    NoFields            -> 0
    NamedFields(fs)     -> fs.length()
    PositionalFields(t) -> t.length()
  }
}

## The type arguments of the enum a constructor reference makes, from its type.
fn enum_args(expr: Int) -> List[Type] uses { State[Lowering] } {
  expr_type(expr) match {
    CEnum(_, args) -> args
    CFn(f) -> f.ret match {
      CEnum(_, args) -> args
      _              -> []
    }
    _              -> []
  }
}

fn type_args(expr: Int) -> List[Type] uses { State[Lowering] } {
  st().checked.types.type_args.get(expr).or([]).map(lower_type)
}

## The function instance a reference to `def` at `expr` calls, for a fn with a body.
fn callable(expr: Int, def: Int) -> Option[Int] uses { State[Lowering] } {
  program = st().program
  kind = def_of(program, def).kind
  has_body = program.items.get(def) match {
    Some(Hir.IConst(_)) -> True
    Some(IFn(f))        -> f.body.is_some() || f.is_external
    None                -> kind == ImplFnKind
    _                   -> False
  }
  if has_body { Some(instance(def, type_args(expr))) } else { None }
}

fn lower_call(expr: Int, callee: Int, written: List[Int]) -> Expr uses { State[Lowering] } {
  program = st().program
  types = st().checked.types
  # The arguments by parameter position.
  slots = types.calls.get(expr).or(written.map(|w| Some(w)))
  args = slots.map(|s| s.map(lower_expr).or(XLit(VUnit)))
  callee_kind = program.exprs.get(callee).map(|c| c.kind)
  target = callee_kind match {
    Some(EPath(ResDef(def))) -> Some(def)
    Some(EField(_, _))       -> types.methods.get(callee)
    _                        -> None
  }
  # An operation of a capability: `c.next()`.
  op = types.ops.get(callee).and_then(|o| {
    callee_kind match {
      Some(EField(base, _)) -> Some((o, base))
      _                     -> None
    }
  })
  op match {
    Some((o, base)) -> {
      h = lower_expr(base)
      Ir.XOp(h, def_of(program, o).name, args, may_fail(callee))
    }
    None -> plain_call(expr, callee, target, args)
  }
}

fn plain_call(expr: Int, callee: Int, target: Option[Int], args: List[Expr]) -> Expr
  uses { State[Lowering] } {
  program = st().program
  target match {
    Some(def) -> {
      data = def_of(program, def)
      if data.kind == CtorKind || data.kind == Hir.ErrorKind {
        XCtor(ctor_ref(def), enum_args(expr), args)
      } else {
        builtin_call(callee, def, args) match {
          Some(b)                              -> b
          None if data.kind == Hir.TraitFnKind -> trait_call(def, type_args(callee), args)
          None -> callable(callee, def) match {
            Some(f) -> XCall(Direct(f, []), args.append([ev_var()]), may_fail(callee), False)
            None    -> unsupported("a call of #{def_name(def)}")
          }
        }
      }
    }
    None -> {
      value = lower_expr(callee)
      XCall(Indirect(value), args.append([ev_var()]), may_fail(callee), False)
    }
  }
}

## Whether a call of `callee` may fail: the E of its type is not empty. A set type parameter
## counts as not empty; checking a result that is not a failure costs only the check.
fn may_fail(callee: Int) -> Bool uses { State[Lowering] } {
  st().checked.types.exprs.get(callee) match {
    Some(TyFn(f)) -> !f.fails.elems.is_empty()
    _             -> False
  }
}

## A call of an `@intrinsic` fn: the builtin with the type arguments of the reference.
fn builtin_call(callee: Int, def: Int, args: List[Expr]) -> Option[Expr] uses { State[Lowering] } {
  program = st().program
  intrinsic = program.items.get(def) match {
    Some(IFn(f)) -> f.is_intrinsic
    _            -> False
  }
  if intrinsic {
    data = def_of(program, def)
    module = data.module match {
      SourceModule(m) -> program.modules.get(m).map(|items| String.join(items.name, ".")).or("")
      _               -> ""
    }
    Builtins.runtime_name(module, data.name) match {
      Some(name) -> Some(XBuiltin(name, type_args(callee), args))
      None       -> Some(unsupported("the intrinsic #{module}.#{data.name}"))
    }
  } else {
    None
  }
}

## A field of a record.
fn field_value(expr: Int, base: Int) -> Expr uses { State[Lowering] } {
  types = st().checked.types
  types.fields.get(expr) match {
    Some(index) -> {
      ref = types.exprs.get(base) match {
        Some(TyNamed(con, _)) -> {
          def = con_def(st().checked.table, con)
          st().program.items.get(def) match {
            Some(IType(t))        -> t.ctor.map(ctor_ref)
            Some(Hir.IError(_))   -> Some(ctor_ref(def))
            Some(Hir.IHandler(h)) -> h.ctor.map(ctor_ref)
            _                     -> None
          }
        }
        _ -> None
      }
      ref match {
        Some(r) -> XField(lower_expr(base), r, index)
        None    -> unsupported("a field of this type")
      }
    }
    None -> unsupported("this field access")
  }
}

## `True` and `False` of the Prelude's Bool, which is the primitive Bool.
fn bool_value(def: Int) -> Option[Bool] uses { State[Lowering] } {
  l = st()
  data = def_of(l.program, def)
  if data.kind == CtorKind && data.parent.is_some() && data.parent == l.checked.table.bool_def {
    Some(data.name == "True")
  } else {
    None
  }
}

fn literal(lit: Literal, ty: Type) -> Lit {
  lit match {
    LInt(text) -> ty match {
      CInt64 -> VInt64(text)
      CFloat -> VFloat(Float.parse(text) escape { _ -> 0.0 })
      _      -> VInt(int_value(text))
    }
    LFloat(text)  -> VFloat(Float.parse(text) escape { _ -> 0.0 })
    LString(text) -> VString(text)
  }
}

## The value of an Int literal: decimal, or `0x`, `0o`, `0b` (after an optional `-`), wrapped to
## 32 bits.
fn int_value(text: String) -> Int {
  cps = text.code_points()
  (negative, digits) = cps match {
    [45, ..rest] -> (True, rest)
    _            -> (False, cps)
  }
  (radix, body) = digits match {
    [48, 120, ..rest] -> (16, rest)
    [48, 88, ..rest]  -> (16, rest)
    [48, 111, ..rest] -> (8, rest)
    [48, 98, ..rest]  -> (2, rest)
    _                 -> (10, digits)
  }
  # Int arithmetic wraps to 32 bits, as the literal's value does.
  value = body.fold(0, |acc, c| acc * radix + Numbers.digit_value(c))
  if negative { 0 - value } else { value }
}

fn op_ty(ty: Type) -> OpTy {
  ty match {
    CInt    -> OpInt
    CInt64  -> OpInt64
    CFloat  -> OpFloat
    CBool   -> OpBool
    CString -> OpString
    _       -> OpStructural
  }
}

fn lower_binary(op: BinaryOp, lhs: Int, rhs: Int) -> Expr uses { State[Lowering] } {
  ty = op_ty(expr_type(lhs))
  bin = op match {
    OpAdd -> Some(BAdd)
    OpSub -> Some(BSub)
    OpMul -> Some(BMul)
    OpDiv -> Some(BDiv)
    OpRem -> Some(BRem)
    OpEq  -> Some(BEq)
    OpNe  -> Some(BNe)
    OpLt  -> Some(BLt)
    OpLe  -> Some(BLe)
    OpGt  -> Some(BGt)
    OpGe  -> Some(BGe)
    OpAnd -> Some(BAnd)
    OpOr  -> Some(BOr)
    _     -> None
  }
  bin match {
    Some(b) -> XBinary(b, ty, lower_expr(lhs), lower_expr(rhs))
    None    -> unsupported("this operator")
  }
}

## Statements become nested `XLet` and `XSeq`; a block without a value is `()`.
fn lower_block(stmts: List[Hir.Stmt], tail: Option[Int]) -> Expr uses { State[Lowering] } {
  stmts match {
    [] -> tail.map(lower_expr).or(XLit(VUnit))
    [stmt, ..rest] -> stmt match {
      SExpr(x) -> {
        first = lower_expr(x)
        XSeq(first, lower_block(rest, tail))
      }
      SLet(pat, _, value) -> {
        v = lower_expr(value)
        st().program.pats.get(pat).map(|p| p.kind) match {
          Some(PBind(local)) -> {
            bound = new_local(local)
            XLet(bound, v, lower_block(rest, tail))
          }
          Some(PWild) -> XSeq(v, lower_block(rest, tail))
          _ -> {
            p = lower_pat(pat)
            XMatch(v, [Arm(p, None, lower_block(rest, tail))])
          }
        }
      }
      # A local fn is a closure bound to its name before its body, so it can call itself.
      SLocalFn(f) -> {
        bound = new_local(f.local)
        params = f.sig.params.map(|p| new_local(p.local))
        ty = st().checked.types.locals.get(f.local).map(lower_type).or(CUnit)
        (ev, lowered) = in_closure(|| lower_expr(f.body))
        value = XLambda(params.append([ev]), ty, lowered, False)
        XLet(bound, value, lower_block(rest, tail))
      }
    }
  }
}

# ---------------------------------------------------------------------------------------------
# Patterns

fn lower_pat(pat: Int) -> Pat uses { State[Lowering] } {
  program = st().program
  ty = st().checked.types.pats.get(pat).map(lower_type).or(CUnit)
  program.pats.get(pat).map(|p| p.kind) match {
    Some(PWild)         -> QWild
    Some(PMissing)      -> QWild
    Some(PUnit)         -> QWild
    Some(PBind(local))  -> QBind(new_local(local))
    Some(PLit(lit))     -> QLit(literal(lit, ty))
    Some(PConst(ResDef(def))) -> ctor_pat(pat, def)
    Some(PCtor(ResDef(def), _, _)) -> ctor_pat(pat, def)
    Some(PTuple(elems)) -> QTuple(elems.map(lower_pat))
    Some(PList(elems, rest)) -> QList(
      elems.map(lower_pat),
      rest.map(|r| r.binding.map(|local| QBind(new_local(local))).or(QWild)),
    )
    _ -> {
      unsupported("this pattern")
      QWild
    }
  }
}

fn ctor_pat(pat: Int, def: Int) -> Pat uses { State[Lowering] } {
  bool_value(def) match {
    Some(b) -> QLit(VBool(b))
    None -> {
      slots = st().checked.types.pat_fields.get(pat).or([])
      args = slots.map(|s| s.map(lower_pat).or(QWild))
      QCtor(ctor_ref(def), args)
    }
  }
}

# ---------------------------------------------------------------------------------------------
# Effects

## The key of an effect in the evidence table: its name, with its type arguments.
fn effect_key(tag: Ty.Tag) -> String uses { State[Lowering] } {
  args = tag.args.map(|a| type_key(lower_type(a)))
  if args.is_empty() {
    def_name(tag.def)
  } else {
    "#{def_name(tag.def)}[#{String.join(args, ",")}]"
  }
}

## The parts of a handler: its init (1), the function making its handler value from its `self`
## (2), and its release (3).
fn lower_handler_part(inst: Instance) -> () uses { State[Lowering] } {
  upd(|l| Lowering(withs: [], ..l))
  program = st().program
  def = inst.def
  upd(|l| Lowering(locals: Map.empty(), subst: inst.args, ..l))
  handler_ty = named_type(def, [])
  name = "#{def_name(def)}$#{inst.role}$#{inst.id}"
  item = program.items.get(def) match {
    Some(Hir.IHandler(h)) -> Some(h)
    _                     -> None
  }
  made = item.map(|h| {
    inst.role match {
      1 -> {
        params = h.init_params.map(|p| new_local(p.local))
        ev = fresh_ev()
        body = h.init.map(lower_expr).or(h.ctor.map(|c| XCtor(ctor_ref(c), [], [])).or(XLit(VUnit)))
        (params.append([ev]), body)
      }
      2 -> {
        me = fresh_local("self", handler_ty, None)
        ev = fresh_ev()
        ops = h.ops.filter_map(|hop| {
          hop.body.map(|body| {
            op_name = hop.name.name
            params = hop.params.map(|p| new_local(p.local))
            self_local = new_local(hop.self_local)
            if hop.is_suspend {
              unsupported("a suspend fn implementation")
              ()
            }
            lowered = lower_expr(body)
            (op_name, XLambda(params, CUnit, XLet(self_local, XVar(me), lowered), False))
          })
        })
        ([me, ev], Ir.XHandler(ops))
      }
      _ -> {
        me = fresh_local("self", handler_ty, None)
        ev = fresh_ev()
        body = h.release.map(|(self_local, b)| {
          bound = new_local(self_local)
          XLet(bound, XVar(me), lower_expr(b))
        }).or(XLit(VUnit))
        ([me, ev], body)
      }
    }
  })
  when_some(made, |(params, body)| {
    fun = Function(name, False, params, CUnit, 0, False, body, None, False, False, name)
    set_module(|m| Module(functions: m.functions.insert(inst.id, fun), ..m))
  })
}

## A handler listed in a `with`, with the arguments of its init and the name it is bound to.
type Listed(hdl: Int, args: List[Hir.Arg], bind: Option[Int])

## `with H1, ..., Hn { body }`: each handler's init and handler value, in order, each seeing the
## evidence of the handlers before it; the body with all of them provided; then the releases in
## reverse order, however the body ends.
fn lower_with(items: List[Hir.WithItem], body: Int) -> Expr uses { State[Lowering] } {
  program = st().program
  listed = items.flat_map(|item| {
    item.res match {
      ResDef(d) -> program.items.get(d) match {
        Some(Hir.IHandler(_)) if item.by.is_none() -> [
          Listed(d, item.args.map(|a| a.args).or([]), item.bind),
        ]
        Some(Hir.ILayer(_)) -> flatten_layer(program, d).map(|h| {
          Listed(h, layer_args(d, h), None)
        })
        _ -> {
          unsupported("this item of `with`")
          []
        }
      }
      _ -> []
    }
  })
  outer = st().ev
  # (self local, handler local, evidence after it, the init call, the handler value) per handler.
  (steps, last_ev) = listed.fold(([], outer), |(acc, ev), l| {
    upd(|x| Lowering(ev:, ..x))
    args = init_args(l.hdl, l.args)
    init = instance_of(l.hdl, [], 1)
    maker = instance_of(l.hdl, [], 2)
    handler_ty = named_type(l.hdl, [])
    me = fresh_local("self", handler_ty, None)
    h = fresh_local("h", CUnit, None)
    next = fresh_local("ev", Ir.CEvidence, None)
    keys = Signature.effects_of_handler(st().checked.sigs, l.hdl).map(effect_key)
    init_call = XCall(Direct(init, []), args.append([XVar(ev)]), True, False)
    made = XCall(Direct(maker, []), [XVar(me), XVar(ev)], False, False)
    provide = Ir.XProvide(Some(XVar(ev)), keys.map(|k| (k, XVar(h))))
    (acc.append([(l, me, h, next, init_call, made, provide)]), next)
  })
  outer_withs = st().withs
  added = steps.map(|(l, _, _, next, _, _, _)| {
    (next, Signature.effects_of_handler(st().checked.sigs, l.hdl).map(effect_key))
  })
  upd(|x| Lowering(ev: last_ev, withs: added.reverse().append(outer_withs), ..x))
  inner = lower_expr(body)
  upd(|x| Lowering(ev: outer, withs: outer_withs, ..x))
  # Each handler is released, then retired, however the body ends; the last one first.
  guarded = steps.reverse().fold(inner, |acc, (l, me, h, _, _, _, _)| {
    has_release = program.items.get(l.hdl) match {
      Some(Hir.IHandler(item)) -> item.release.is_some()
      _                        -> False
    }
    release = if has_release {
      XCall(Direct(instance_of(l.hdl, [], 3), []), [XVar(me), XVar(outer)], False, False)
    } else {
      XLit(VUnit)
    }
    Ir.XFinally(acc, release, XVar(h), def_of(program, l.hdl).name)
  })
  # The binding names hold the handler values.
  bound = steps.reverse().fold(guarded, |acc, (l, _, h, _, _, _, _)| {
    l.bind.map(|b| XLet(new_local(b), XVar(h), acc)).or(acc)
  })
  steps.reverse().fold(bound, |acc, (_, me, h, next, init_call, made, provide)| {
    XLet(me, init_call, XLet(h, made, XLet(next, provide, acc)))
  })
}

## The arguments of a handler's init written on an item, by parameter: by label, or in order.
fn init_args(hdl: Int, written: List[Hir.Arg]) -> List[Expr] uses { State[Lowering] } {
  program = st().program
  names = program.items.get(hdl) match {
    Some(Hir.IHandler(h)) -> h.init_params.map(
      |p| program.locals.get(p.local).map(|d| d.name).or(""),
    )
    _ -> []
  }
  names.enumerate().map(|(i, n)| {
    by_label = written.find(|a| a.label.map(|l| l.name == n).or(False))
    found = by_label match {
      Some(a) -> Some(a)
      None    -> written.get(i)
    }
    found.map(|a| lower_expr(a.value)).or(XLit(VUnit))
  })
}

## The arguments a layer writes for one of its handlers.
fn layer_args(lay: Int, hdl: Int) -> List[Hir.Arg] uses { State[Lowering] } {
  st().program.items.get(lay) match {
    Some(Hir.ILayer(item)) -> item.members.find(|m| m.res == ResDef(hdl)).and_then(|m| m.args).map(
      |a| a.args,
    ).or([])
    _ -> []
  }
}

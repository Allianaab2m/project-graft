## The runtime functions that implement the `@intrinsic` fns of the bundled sources. Follows
## `intrinsics.rs` of emela-core and `emit/builtins.rs` of emela-codegen-js.

## The name of the runtime function for the intrinsic `name` of `module` (the module's path,
## empty for the Prelude). `$showNested` is not in the runtime: lowering replaces it.
pub fn runtime_name(module: String, name: String) -> Option[String] {
  key = if module == "" || module == "Prelude" { name } else { "#{module}.#{name}" }
  key match {
    "String.length"               -> Some("$strlen")
    "String.byte_size"            -> Some("$strbytes")
    "String.append"               -> Some("$strcat")
    "String.contains"             -> Some("$strhas")
    "String.starts_with"          -> Some("$strstarts")
    "String.ends_with"            -> Some("$strends")
    "String.split"                -> Some("$strsplit")
    "String.chars"                -> Some("$strchars")
    "String.trim"                 -> Some("$strtrim")
    "String.code_points"          -> Some("$strcodepoints")
    "String.from_code_point"      -> Some("$strfromcodepoint")
    "String.show_nested"          -> Some("$showNested")
    "List.join"                   -> Some("$strjoin")
    "Int.to_string"               -> Some("$showInt")
    "Int.parse_or_none"           -> Some("$iparse")
    "Int.checked_add"             -> Some("$icheckedAdd")
    "Int.bit_and"                 -> Some("$iand")
    "Int.bit_or"                  -> Some("$ior")
    "Int.bit_xor"                 -> Some("$ixor")
    "Int.bit_not"                 -> Some("$inot")
    "Int.shift_left"              -> Some("$ishl")
    "Int.shift_right"             -> Some("$ishr")
    "Int.shift_right_unsigned"    -> Some("$iushr")
    "Int64.from_int"              -> Some("$itol")
    "Int64.to_string"             -> Some("$showInt64")
    "Int64.to_int"                -> Some("$ltoi")
    "Int64.bit_and"               -> Some("$land")
    "Int64.bit_or"                -> Some("$lor")
    "Int64.bit_xor"               -> Some("$lxor")
    "Int64.bit_not"               -> Some("$lnot")
    "Int64.shift_left"            -> Some("$lshl")
    "Int64.shift_right"           -> Some("$lshr")
    "Int64.shift_right_unsigned"  -> Some("$lushr")
    "Float.to_string"             -> Some("$showFloat")
    "Float.from_int"              -> Some("$itof")
    "Float.parse_or_none"         -> Some("$fparse")
    "Float.floor"                 -> Some("$ffloor")
    "Float.ceil"                  -> Some("$fceil")
    "Float.round"                 -> Some("$fround")
    "Float.truncate"              -> Some("$ftrunc")
    "Std.Bytes.from_list"         -> Some("$bytesFromList")
    "Std.Bytes.to_list"           -> Some("$bytesToList")
    "Std.Bytes.size"              -> Some("$bytesSize")
    "Std.Bytes.get"               -> Some("$bytesGet")
    "Std.Bytes.slice"             -> Some("$bytesSlice")
    "Std.Bytes.concat"            -> Some("$bytesConcat")
    "Std.Bytes.encode_utf8"       -> Some("$bytesEncodeUtf8")
    "Std.Bytes.decode_valid_utf8" -> Some("$bytesDecodeValidUtf8")
    "Std.Array.from_list"         -> Some("$arrayFromList")
    "Std.Array.to_list"           -> Some("$arrayToList")
    "Std.Array.size"              -> Some("$arraySize")
    "Std.Array.get"               -> Some("$arrayGet")
    "Std.Array.set"               -> Some("$arraySet")
    "Std.Array.slice"             -> Some("$arraySlice")
    "Std.Array.concat"            -> Some("$arrayConcat")
    "panic"                       -> Some("$panic")
    "todo"                        -> Some("$todo")
    "dbg"                         -> Some("$dbg")
    "inspect"                     -> Some("$inspect")
    _                             -> None
  }
}

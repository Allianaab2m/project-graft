## Emits JS from the Core IR. Follows `emit.rs` of emela-codegen-js, and uses its runtime
## (`emela_runtime.mjs`), so values have the same representation:
##
## ```text
## Int      number, wrapped to 32 bits after every operation
## Int64    BigInt
## Float    number
## Bool     boolean
## String   string
## ()       undefined
## tuple    array [a, b]
## List     cons cells { h, t }, the empty list is null
## enum     { $tag: variant index, $0, $1, … or named fields }; a variant without fields is one
##          frozen value (`$None` for Option's None)
## ```
##
## The output is an ES module that exports `main` for the launcher.
import Std.Map.{Map}
import Std.State.{State}
import Core.Ir
import Core.Ir.{
  Module,
  Function,
  EnumDef,
  VariantFields,
  FieldsUnit,
  FieldsPositional,
  FieldsNamed,
  Type,
  CInt,
  CInt64,
  CFloat,
  CBool,
  CString,
  CBytes,
  CArray,
  CUnit,
  CNever,
  CTuple,
  CList,
  CEnum,
  CParam,
  CFn,
  CtorRef,
  Lit,
  VInt,
  VInt64,
  VFloat,
  VBool,
  VString,
  VUnit,
  Expr,
  XLit,
  XVar,
  XFn,
  XLet,
  XCall,
  XBuiltin,
  XCtor,
  XField,
  XTuple,
  XList,
  XIf,
  XMatch,
  XBinary,
  XUnary,
  XLambda,
  XConcat,
  XSeq,
  XFail,
  XEscape,
  Direct,
  Indirect,
  Arm,
  Pat,
  QWild,
  QBind,
  QLit,
  QCtor,
  QTuple,
  QList,
  SLit,
  SValue,
  BinOp,
  BAdd,
  BSub,
  BMul,
  BDiv,
  BRem,
  BEq,
  BNe,
  BLt,
  BLe,
  BGt,
  BGe,
  BAnd,
  BOr,
  UNot,
  UNeg,
  OpTy,
  OpInt,
  OpInt64,
  OpFloat,
  OpString,
  OpStructural,
}

## The runtime functions the output may call.
const RUNTIME: List[String] = [
  "$None",
  "$panic",
  "$todo",
  "$unreachable",
  "$dbg",
  "$inspect",
  "$list",
  "$eq",
  "$scmp",
  "$idiv",
  "$irem",
  "$ldiv",
  "$lrem",
  "$showInt",
  "$showInt64",
  "$showFloat",
  "$showBool",
  "$showString",
  "$showUnit",
  "$showFn",
  "$showList",
  "$showTuple",
  "$showArray",
  "$showBytes",
  "$strlen",
  "$strbytes",
  "$strcat",
  "$strhas",
  "$strstarts",
  "$strends",
  "$strsplit",
  "$strchars",
  "$strjoin",
  "$strtrim",
  "$strcodepoints",
  "$strfromcodepoint",
  "$iparse",
  "$icheckedAdd",
  "$iand",
  "$ior",
  "$ixor",
  "$inot",
  "$ishl",
  "$ishr",
  "$iushr",
  "$itol",
  "$ltoi",
  "$land",
  "$lor",
  "$lxor",
  "$lnot",
  "$lshl",
  "$lshr",
  "$lushr",
  "$itof",
  "$fparse",
  "$ffloor",
  "$fceil",
  "$fround",
  "$ftrunc",
  "$bytesFromList",
  "$bytesToList",
  "$bytesSize",
  "$bytesGet",
  "$bytesSlice",
  "$bytesConcat",
  "$bytesEncodeUtf8",
  "$bytesDecodeValidUtf8",
  "$arrayFromList",
  "$arrayToList",
  "$arraySize",
  "$arrayGet",
  "$arraySet",
  "$arraySlice",
  "$arrayConcat",
  "$foreign",
  "$constant",
  "$Fail",
  "$assertFail",
  "$assertCmp",
]

## The comparison of derived and built-in Ord impls: by `<` on primitive values, element by
## element on tuples and lists, and by variant, then field by field, on enums. -1, 0 or 1.
const COMPARE: List[String] = [
  "function $graftCompare(a, b) {",
  "  if (typeof a === \"string\") { const c = $scmp(a, b); return c < 0 ? -1 : c > 0 ? 1 : 0; }",
  "  if (typeof a !== \"object\" || a === null || b === null) {",
  "    if (a === b) return 0;",
  "    if (a === null) return -1;",
  "    if (b === null) return 1;",
  "    return a < b ? -1 : 1;",
  "  }",
  "  if (Array.isArray(a)) {",
  "    for (let i = 0; i < a.length; i++) { const c = $graftCompare(a[i], b[i]); if (c !== 0) return c; }",
  "    return 0;",
  "  }",
  "  if (\"h\" in a) {",
  "    const c = $graftCompare(a.h, b.h);",
  "    return c !== 0 ? c : $graftCompare(a.t, b.t);",
  "  }",
  "  if (a.$tag !== b.$tag) return a.$tag < b.$tag ? -1 : 1;",
  "  for (const k of Object.keys(a)) {",
  "    if (k === \"$tag\") continue;",
  "    const c = $graftCompare(a[k], b[k]);",
  "    if (c !== 0) return c;",
  "  }",
  "  return 0;",
  "}",
  "",
]

## The JS module of `module`.
pub fn emit(module: Module) -> String {
  imports = "import { #{String.join(RUNTIME, ", ")} } from \"./emela_runtime.mjs\";"
  descriptors = module.enums.fold([], |acc, id, def| {
    if def.is_error {
      name = sanitize(def.name)
      variant = def.variants.head().map(|v| v.name).or(def.name)
      show = if def.show_structure { "(v) => $show$#{name}(v)" } else { "() => #{quote(variant)}" }
      acc.append(["const $err$#{name} = Object.freeze({ show: #{show} });"])
    } else {
      acc
    }
  })
  units0 = descriptors.append(
    module.enums.fold([], |acc, id, def| acc.append(unit_variants(id, def))),
  )
  shows = module.enums.fold([], |acc, id, def| acc.append(show_enum_fn(module, id, def)))
  hosts = host_imports(module)
  host_lines = hosts.enumerate().map(|(i, (path, name))| {
    "import { #{name} as $ext#{i} } from \"#{path}\";"
  })
  functions = module.functions.fold([], |acc, id, f| {
    acc.append(emit_fn(module, hosts, id, f)).append([""])
  })
  exported = module.functions.fold(
    [],
    |acc, _, f| if f.exported { acc.append([f.name]) } else { acc },
  )
  units = units0.append(COMPARE)
  ordering = module.ordering.map(|o| {
    name = enum_name(module, o)
    ["const $ordering = [#{name}$Less, #{name}$Equal, #{name}$Greater];", ""]
  }).or([])
  lines = ["// Generated by Graft.", imports].append(host_lines).append([""]).append(units).append(
    ordering,
  ).append([""]).append(shows).append(functions).append(
    ["export { #{String.join(exported, ", ")} };", ""],
  )
  String.join(lines, "\n")
}

fn enum_name(module: Module, id: Int) -> String {
  sanitize(module.enums.get(id).map(|d| d.name).or("Enum#{id}"))
}

fn sanitize(name: String) -> String {
  String.concat(
    name.code_points().map(|c| {
      ok = (
        (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
      )
      if ok { String.from_code_point(c).or("_") } else { "_" }
    }),
  )
}

## The frozen value of each variant without fields.
fn unit_variants(id: Int, def: EnumDef) -> List[String] {
  if def.name == "Option" {
    []
  } else {
    def.variants.enumerate().filter_map(|(k, v)| {
      if v.fields == FieldsUnit {
        tag_js = if def.is_error { "$err$#{sanitize(def.name)}" } else { "#{k}" }
        Some("const #{sanitize(def.name)}$#{v.name} = Object.freeze({ $tag: #{tag_js} });")
      } else {
        None
      }
    })
  }
}

fn unit_value(module: Module, ctor: CtorRef) -> String {
  def = module.enums.get(ctor.enum_id)
  if def.map(|d| d.name == "Option").or(False) {
    "$None"
  } else {
    variant = def.and_then(|d| d.variants.get(ctor.variant)).map(|v| v.name).or("?")
    "#{enum_name(module, ctor.enum_id)}$#{variant}"
  }
}

fn field_key(fields: VariantFields, i: Int) -> String {
  fields match {
    FieldsNamed(names) -> names.get(i).or("$#{i}")
    _                  -> "$#{i}"
  }
}

fn variant_fields(module: Module, ctor: CtorRef) -> VariantFields {
  module.enums.get(ctor.enum_id).and_then(|d| d.variants.get(ctor.variant)).map(|v| v.fields).or(
    FieldsUnit,
  )
}

## The js bindings of external functions that import from a module: (path, name), each once.
fn host_imports(module: Module) -> List[(String, String)] {
  module.functions.fold([], |acc, _, f| {
    js_binding(f) match {
      Some(Ir.HostImport(host, name)) -> {
        path = host_path(host)
        if acc.any(|(p, n)| p == path && n == name) { acc } else { acc.append([(path, name)]) }
      }
      _ -> acc
    }
  })
}

fn js_binding(f: Function) -> Option[Ir.HostRef] {
  f.external.and_then(|x| x.bindings.find(|b| b.target == "js")).map(|b| b.host)
}

## Bundled files are written under `emela_core/` next to the output.
fn host_path(host: Ir.HostModule) -> String {
  host match {
    Ir.ModNamed(name)   -> name
    Ir.ModFile(path)    -> path
    Ir.ModBundled(path) -> "./emela_core/#{path}"
  }
}

fn emit_fn(module: Module, hosts: List[(String, String)], id: Int, f: Function) -> List[String] {
  params = String.join(f.params.map(|p| local_name(module, p)), ", ")
  f.external match {
    Some(_) -> {
      target = js_binding(f) match {
        Some(Ir.HostGlobal(name)) -> name
        Some(Ir.HostImport(host, name)) -> {
          path = host_path(host)
          index = hosts.enumerate().find(|(_, (p, n))| p == path && n == name).map(|(i, _)| i).or(0)
          "$ext#{index}"
        }
        None                      -> "(() => { throw new Error(\"no js binding\"); })"
      }
      call = "#{target}(#{params})"
      inner = if f.ret == CUnit {
        ["    #{call};", "    return undefined;"]
      } else {
        ["    return #{call};"]
      }
      ["function #{f.name}(#{params}) {", "  try {"].append(inner).append(
        ["  } catch ($e) {", "    throw $foreign($e);", "  }", "}"],
      )
    }
    None if f.constant -> [
      "const #{f.name}$cell = { state: 0, value: undefined };",
      "function #{f.name}() {",
      "  return $constant(#{f.name}$cell, #{quote(f.display)}, #{f.name}$init);",
      "}",
      "",
      "function #{f.name}$init() {",
    ].append(body_lines(module, f.body, None)).append(["}"])
    None -> if self_tail(f.body, id) {
      # Self tail calls go round a loop: the parameters are `$p0`, `$p1`, ..., bound afresh to
      # the parameters' locals on each round, so closures keep the values of their round.
      temps = f.params.enumerate().map(|(i, _)| "$p#{i}")
      binds = f.params.zip(temps).map(|(p, t)| "    const #{local_name(module, p)} = #{t};")
      body = body_lines(module, f.body, Some(Tail(id, temps))).map(|l| "  #{l}")
      ["function #{f.name}(#{String.join(temps, ", ")}) {", "  $L: for (;;) {"].append(
        binds,
      ).append(body).append(["  }", "}"])
    } else {
      ["function #{f.name}(#{params}) {"].append(body_lines(module, f.body, None)).append(["}"])
    }
  }
}

## A function whose self calls in tail position become a loop: its index and the names of its
## parameters' variables.
type Tail(f: Int, temps: List[String])

## Whether `expr`, in tail position, calls the function `f` itself.
fn self_tail(expr: Expr, f: Int) -> Bool {
  expr match {
    XCall(Direct(g, _), _, _, _) -> g == f
    XLet(_, _, body)             -> self_tail(body, f)
    XSeq(_, rest)                -> self_tail(rest, f)
    XIf(_, t, e)                 -> self_tail(t, f) || self_tail(e, f)
    XMatch(_, arms)              -> arms.any(|arm| self_tail(arm.body, f))
    _                            -> False
  }
}

fn local_name(module: Module, local: Int) -> String {
  hint = module.locals.get(local).map(|l| l.hint).or("v")
  "#{sanitize(hint)}$#{local}"
}

fn fn_name(module: Module, f: Int) -> String {
  module.functions.get(f).map(|x| sanitize(x.name)).or("$missing")
}

# ---------------------------------------------------------------------------------------------
# Statements and values
#
# Expressions are emitted in two ways, as in the reference: `value` returns a JS expression and
# may emit statements before it; `stmt` emits statements that pass the value to a destination.
# Expressions that need statements are assigned to a temporary. Emitting statements first would
# move the evaluation of the arguments to their left after them, so those are bound to
# temporaries first (`values_in_order`).

## Where `stmt` puts a value.
enum Dest {
  DReturn
  DAssign(name: String)
} derive Eq

## The state of emitting one function body.
type Em(
  module: Module,
  ## Newest first, with their indentation.
  lines: List[String],
  indent: Int,
  next_tmp: Int,
  ## Failure targets, innermost first: the label of the escape's block and the cell for the
  ## failure. None means the caller (`return`).
  fail_targets: List[(String, String)],
  tail: Option[Tail],
)

fn em() -> Em uses { State[Em] } {
  (use State[Em]).get()
}

fn emu(f: fn(Em) -> Em) -> () uses { State[Em] } {
  s = use State[Em]
  s.set(f(s.get()))
}

fn line(text: String) -> () uses { State[Em] } {
  emu(
    |e| Em(
      lines: ["#{String.concat(List.range(0, e.indent).map(|_| "  "))}#{text}", ..e.lines],
      ..e,
    ),
  )
}

fn indented(f: fn() -> () uses { State[Em] }) -> () uses { State[Em] } {
  emu(|e| Em(indent: e.indent + 1, ..e))
  f()
  emu(|e| Em(indent: e.indent - 1, ..e))
}

fn tmp() -> String uses { State[Em] } {
  n = em().next_tmp
  emu(|e| Em(next_tmp: n + 1, ..e))
  "$t#{n}"
}

fn mdl() -> Module uses { State[Em] } {
  em().module
}

## The lines of a function body that returns `expr`, indented by one.
fn body_lines(module: Module, expr: Expr, tail: Option[Tail]) -> List[String] {
  (_, done) = State.run(Em(module, [], 1, 0, [], tail), || stmt(expr, DReturn))
  done.lines.reverse()
}

## Passes the failure `v` to the innermost escape, or returns it to the caller.
fn propagate(v: String) -> () uses { State[Em] } {
  em().fail_targets match {
    [(label, cell), ..] -> line("{ #{cell} = #{v}; break #{label}; }")
    []                  -> line("return #{v};")
  }
}

## Binds the result of a fallible call to a temporary and passes a failure on.
fn checked(call: String) -> String uses { State[Em] } {
  t = tmp()
  line("const #{t} = #{call};")
  line("if (#{t} instanceof $Fail) #{propagate_text(t)}")
  t
}

fn propagate_text(v: String) -> String uses { State[Em] } {
  em().fail_targets match {
    [(label, cell), ..] -> "{ #{cell} = #{v}; break #{label}; }"
    []                  -> "return #{v};"
  }
}

fn deliver(dest: Dest, v: String) -> () uses { State[Em] } {
  dest match {
    DReturn    -> line("return #{v};")
    DAssign(t) -> line("#{t} = #{v};")
  }
}

## Statements that pass the value of `expr` to `dest`.
fn stmt(expr: Expr, dest: Dest) -> () uses { State[Em] } {
  module = mdl()
  expr match {
    XLet(bound, value, body) -> {
      v = value_of(value)
      line("const #{local_name(module, bound)} = #{v};")
      stmt(body, dest)
    }
    XSeq(first, rest) -> {
      discard(first)
      stmt(rest, dest)
    }
    XIf(c, t, e) -> {
      cv = value_of(c)
      line("if (#{cv}) {")
      indented(|| stmt(t, dest))
      line("} else {")
      indented(|| stmt(e, dest))
      line("}")
    }
    XMatch(scrutinee, arms) -> match_stmt(scrutinee, arms, dest)
    XEscape(body, arms)     -> escape_stmt(body, arms, dest)
    XFail(e) -> {
      v = value_of(e)
      propagate("new $Fail(#{v})")
    }
    Ir.XAssertBool(cond, text) -> {
      c = value_of(cond)
      line("if (!#{c}) {")
      indented(|| line("$assertFail(#{quote(text)});"))
      line("}")
      deliver(dest, "undefined")
    }
    Ir.XAssertCmp(op, op_ty, ty, lhs, rhs, text) -> {
      # Both sides are used twice (compare and show), so they are bound to temporaries.
      operands = values_in_order([lhs, rhs]).map(|v| {
        t = tmp()
        line("const #{t} = #{v};")
        t
      })
      l = operands.get(0).or("undefined")
      r = operands.get(1).or("undefined")
      op_text = op match {
        BEq -> "=="
        BNe -> "!="
        BLt -> "<"
        BLe -> "<="
        BGt -> ">"
        _   -> ">="
      }
      line("if (!#{binary(op, op_ty, l, r)}) {")
      left = show_call(module, ty, l)
      right = show_call(module, ty, r)
      indented(|| line("$assertCmp(#{quote(text)}, #{quote(op_text)}, #{left}, #{right});"))
      line("}")
      deliver(dest, "undefined")
    }
    XCall(Direct(g, _), args, _, _) if dest == DReturn && em().tail.map(|t| t.f == g).or(False) -> {
      temps = em().tail.map(|t| t.temps).or([])
      vs = values_in_order(args)
      news = vs.map(|v| {
        n = tmp()
        line("const #{n} = #{v};")
        n
      })
      temps.zip(news).each(|(t, n)| line("#{t} = #{n};"))
      line("continue $L;")
    }
    _                       -> deliver(dest, value_of(expr))
  }
}

## Evaluates `expr` for its effects.
fn discard(expr: Expr) -> () uses { State[Em] } {
  expr match {
    XLit(_)   -> ()
    XVar(_)   -> ()
    XFn(_, _) -> ()
    _ if !is_simple(expr) && needs_statements(expr) -> {
      t = tmp()
      line("let #{t};")
      stmt(expr, DAssign(t))
    }
    _         -> line("#{value_of(expr)};")
  }
}

fn needs_statements(expr: Expr) -> Bool {
  expr match {
    XLet(_, _, _)                   -> True
    XSeq(_, _)                      -> True
    XIf(_, _, _)                    -> True
    XMatch(_, _)                    -> True
    XEscape(_, _)                   -> True
    XFail(_)                        -> True
    Ir.XAssertBool(_, _)            -> True
    Ir.XAssertCmp(_, _, _, _, _, _) -> True
    _                               -> False
  }
}

## A match: the arms in order; the first whose pattern matches (and guard holds) gives the value.
fn match_stmt(scrutinee: Expr, arms: List[Arm], dest: Dest) -> () uses { State[Em] } {
  module = mdl()
  sv = value_of(scrutinee)
  s = tmp()
  line("const #{s} = #{sv};")
  done = "#{s}$done"
  line("#{done}: {")
  indented(|| {
    arms.each(|arm| {
      tests = pat_tests(module, arm.pat, s)
      cond = if tests.is_empty() { "true" } else { String.join(tests, " && ") }
      line("if (#{cond}) {")
      indented(|| {
        pat_binds(module, arm.pat, s).each(|(l, v)| line("const #{local_name(module, l)} = #{v};"))
        arm.guard match {
          Some(g) -> {
            gv = value_of(g)
            line("if (#{gv}) {")
            indented(|| {
              stmt(arm.body, dest)
              line("break #{done};")
            })
            line("}")
          }
          None -> {
            stmt(arm.body, dest)
            line("break #{done};")
          }
        }
      })
      line("}")
    })
    line("$unreachable();")
  })
  line("}")
}

## `body escape { arms }`: two nested labeled blocks. A failure in the body is stored in a cell and
## breaks out of the inner block; the arms look at its error, and one no arm catches propagates.
fn escape_stmt(body: Expr, arms: List[Arm], dest: Dest) -> () uses { State[Em] } {
  module = mdl()
  result = dest match {
    DAssign(t) -> t
    DReturn -> {
      t = tmp()
      line("let #{t};")
      t
    }
  }
  cell = tmp()
  line("let #{cell};")
  done = "#{cell}$x"
  caught = "#{cell}$e"
  line("#{done}: {")
  indented(|| {
    line("#{caught}: {")
    indented(|| {
      outer = em().fail_targets
      emu(|e| Em(fail_targets: [(caught, cell), ..outer], ..e))
      stmt(body, DAssign(result))
      emu(|e| Em(fail_targets: outer, ..e))
      line("break #{done};")
    })
    line("}")
    err_v = tmp()
    line("const #{err_v} = #{cell}.error;")
    wildcard = arms.fold(False, |stopped, arm| {
      if stopped {
        stopped
      } else {
        arm.pat match {
          QWild if arm.guard.is_none() -> {
            stmt(arm.body, DAssign(result))
            line("break #{done};")
            True
          }
          QCtor(ctor, _) -> {
            tests = ["#{err_v}.$tag === #{error_descriptor(module, ctor.enum_id)}"].append(
              pat_tests(module, arm.pat, err_v),
            )
            line("if (#{String.join(tests, " && ")}) {")
            indented(|| {
              pat_binds(module, arm.pat, err_v).each(|(l, v)| {
                line("const #{local_name(module, l)} = #{v};")
              })
              arm.guard match {
                Some(g) -> {
                  gv = value_of(g)
                  line("if (#{gv}) {")
                  indented(|| {
                    stmt(arm.body, DAssign(result))
                    line("break #{done};")
                  })
                  line("}")
                }
                None -> {
                  stmt(arm.body, DAssign(result))
                  line("break #{done};")
                }
              }
            })
            line("}")
            False
          }
          _ -> False
        }
      }
    })
    # A failure no arm caught propagates outward.
    if !wildcard {
      propagate(cell)
    }
  })
  line("}")
  if dest == DReturn {
    line("return #{result};")
  }
}

## Whether `expr` can be emitted as an expression without statements before it.
fn is_simple(expr: Expr) -> Bool {
  expr match {
    XLit(_)                         -> True
    XVar(_)                         -> True
    XFn(_, _)                       -> True
    XLambda(_, _, _, _)             -> True
    XCall(_, _, True, _)            -> False
    XCall(Direct(_, _), args, _, _) -> args.all(is_simple)
    XCall(Indirect(c), args, _, _)  -> is_simple(c) && args.all(is_simple)
    XBuiltin(_, _, args)            -> args.all(is_simple)
    XCtor(_, _, args)               -> args.all(is_simple)
    XTuple(args)                    -> args.all(is_simple)
    XField(base, _, _)              -> is_simple(base)
    XList(_, elems, tail)           -> elems.all(is_simple) && tail.map(is_simple).or(True)
    XBinary(_, _, a, b)             -> is_simple(a) && is_simple(b)
    XUnary(_, _, a)                 -> is_simple(a)
    XIf(c, t, e)                    -> is_simple(c) && is_simple(t) && is_simple(e)
    XConcat(parts) -> parts.all(|p| {
      p match {
        SLit(_)      -> True
        SValue(v, _) -> is_simple(v)
      }
    })
    _                               -> False
  }
}

fn is_atom(expr: Expr) -> Bool {
  expr match {
    XLit(_)             -> True
    XVar(_)             -> True
    XFn(_, _)           -> True
    XLambda(_, _, _, _) -> True
    _                   -> False
  }
}

## The values of `exprs` evaluated left to right: those before the last one that needs statements
## are bound to temporaries.
fn values_in_order(exprs: List[Expr]) -> List[String] uses { State[Em] } {
  last_complex = exprs.enumerate().fold(-1, |acc, (i, x)| if is_simple(x) { acc } else { i })
  exprs.enumerate().map(|(i, x)| {
    v = value_of(x)
    if i < last_complex && !is_atom(x) {
      t = tmp()
      line("const #{t} = #{v};")
      t
    } else {
      v
    }
  })
}

## Binds an expression that needs statements to a temporary and returns its name.
fn via_tmp(expr: Expr) -> String uses { State[Em] } {
  t = tmp()
  line("let #{t};")
  stmt(expr, DAssign(t))
  t
}

## `expr` as a JS expression, after the statements it needs.
fn value_of(expr: Expr) -> String uses { State[Em] } {
  module = mdl()
  expr match {
    XLit(lit)                       -> emit_lit(lit)
    XVar(local)                     -> local_name(module, local)
    XFn(f, _)                       -> fn_name(module, f)
    XLet(bound, value, body) -> {
      v = value_of(value)
      line("const #{local_name(module, bound)} = #{v};")
      value_of(body)
    }
    XSeq(first, rest) -> {
      discard(first)
      value_of(rest)
    }
    XCall(callee, args, fails, _) -> {
      (head, vs) = callee match {
        Direct(f, _) -> (fn_name(module, f), values_in_order(args))
        Indirect(c) -> values_in_order([c, ..args]) match {
          [cv, ..rest] -> ("(#{cv})", rest)
          []           -> ("undefined", [])
        }
      }
      call = "#{head}(#{String.join(vs, ", ")})"
      if fails { checked(call) } else { call }
    }
    XBuiltin("$showNested", targs, args) -> {
      vs = values_in_order(args)
      show_call(module, targs.head().or(CUnit), String.join(vs, ", "))
    }
    XBuiltin("$showValue", targs, args) -> {
      vs = values_in_order(args)
      ty = targs.head().or(CUnit)
      v = String.join(vs, ", ")
      if ty == CString { v } else { show_call(module, ty, v) }
    }
    XBuiltin("$compareValues", _, args) -> {
      vs = values_in_order(args)
      "$ordering[$graftCompare(#{String.join(vs, ", ")}) + 1]"
    }
    XBuiltin(name, targs, args) -> {
      vs = values_in_order(args)
      shown = if name == "$dbg" || name == "$inspect" {
        [show_fn(module, targs.head().or(CUnit))]
      } else {
        []
      }
      "#{name}(#{String.join(vs.append(shown), ", ")})"
    }
    XCtor(ctor, _, args) -> {
      vs = values_in_order(args)
      if vs.is_empty() {
        unit_value(module, ctor)
      } else {
        fields = variant_fields(module, ctor)
        parts = vs.enumerate().map(|(i, v)| "#{field_key(fields, i)}: #{v}")
        "{ $tag: #{tag(module, ctor)}, #{String.join(parts, ", ")} }"
      }
    }
    XField(base, ctor, index) -> {
      b = value_of(base)
      "#{b}.#{field_key(variant_fields(module, ctor), index)}"
    }
    XTuple(elems)                   -> "[#{String.join(values_in_order(elems), ", ")}]"
    XList(_, elems, tail) -> {
      vs = values_in_order(elems.append(tail.map(|t| [t]).or([])))
      tail match {
        Some(_) -> {
          n = vs.length() - 1
          "$list([#{String.join(vs.take(n), ", ")}], #{vs.get(n).or("null")})"
        }
        None -> if vs.is_empty() { "null" } else { "$list([#{String.join(vs, ", ")}])" }
      }
    }
    XIf(c, t, e) if is_simple(expr) -> "(#{value_of(c)} ? #{value_of(t)} : #{value_of(e)})"
    XBinary(BAnd, _, lhs, rhs)      -> logical(True, lhs, rhs)
    XBinary(BOr, _, lhs, rhs)       -> logical(False, lhs, rhs)
    XBinary(op, ty, lhs, rhs) -> values_in_order([lhs, rhs]) match {
      [a, b] -> binary(op, ty, a, b)
      _      -> "undefined"
    }
    XUnary(UNot, _, operand)        -> "(!#{value_of(operand)})"
    XUnary(UNeg, ty, operand)       -> wrap(ty, "(-#{value_of(operand)})")
    XLambda(params, _, body, _) -> {
      ps = String.join(params.map(|p| local_name(module, p)), ", ")
      outer = em()
      inner = body_lines(module, body, None).map(
        |l| "#{String.concat(List.range(0, outer.indent).map(|_| "  "))}#{l}",
      )
      close = "#{String.concat(List.range(0, outer.indent).map(|_| "  "))}})"
      "((#{ps}) => {\n#{String.join(inner, "\n")}\n#{close}"
    }
    XConcat(parts) -> {
      values = values_in_order(
        parts.filter_map(|p| {
          p match {
            SValue(v, _) -> Some(v)
            _            -> None
          }
        }),
      )
      (pieces, _) = parts.fold(([], values), |(acc, vs), p| {
        p match {
          SLit(text) -> (acc.append([escape_template(text)]), vs)
          SValue(_, ty) -> {
            v = vs.head().or("undefined")
            shown = ty match {
              CString -> v
              CInt    -> v
              _       -> show_call(module, ty, v)
            }
            (acc.append(["${#{shown}}"]), vs.drop(1))
          }
        }
      })
      "`#{String.concat(pieces)}`"
    }
    _                               -> via_tmp(expr)
  }
}

## `a && b` and `a || b`. When the right side needs statements, it is evaluated only if the left
## side does not decide.
fn logical(is_and: Bool, lhs: Expr, rhs: Expr) -> String uses { State[Em] } {
  js_op = if is_and { "&&" } else { "||" }
  a = value_of(lhs)
  if is_simple(rhs) {
    "(#{a} #{js_op} #{value_of(rhs)})"
  } else {
    t = tmp()
    line("let #{t} = #{a};")
    line(if is_and { "if (#{t}) {" } else { "if (!#{t}) {" })
    indented(|| stmt(rhs, DAssign(t)))
    line("}")
    t
  }
}

## The `$tag` of a value: the descriptor for an error, the variant index otherwise.
fn tag(module: Module, ctor: CtorRef) -> String {
  if module.enums.get(ctor.enum_id).map(|d| d.is_error).or(False) {
    error_descriptor(module, ctor.enum_id)
  } else {
    "#{ctor.variant}"
  }
}

fn error_descriptor(module: Module, id: Int) -> String {
  "$err$#{enum_name(module, id)}"
}

## The conditions under which the value `v` matches the pattern.
fn pat_tests(module: Module, pat: Pat, v: String) -> List[String] {
  pat match {
    QWild         -> []
    QBind(_)      -> []
    QLit(lit)     -> ["#{v} === #{emit_lit(lit)}"]
    QCtor(ctor, args) -> {
      count = module.enums.get(ctor.enum_id).map(|d| d.variants.length()).or(1)
      test = if count > 1 { ["#{v}.$tag === #{ctor.variant}"] } else { [] }
      fields = variant_fields(module, ctor)
      test.append(
        args.enumerate().flat_map(|(i, p)| pat_tests(module, p, "#{v}.#{field_key(fields, i)}")),
      )
    }
    QTuple(elems) -> elems.enumerate().flat_map(|(i, p)| pat_tests(module, p, "#{v}[#{i}]"))
    QList(elems, rest) -> {
      n = elems.length()
      at = |i: Int| "#{v}#{String.concat(List.range(0, i).map(|_| ".t"))}"
      not_null = List.range(0, n).map(|i| "#{at(i)} !== null")
      end = rest match {
        Some(_) -> []
        None    -> ["#{at(n)} === null"]
      }
      heads = elems.enumerate().flat_map(|(i, p)| pat_tests(module, p, "#{at(i)}.h"))
      not_null.append(end).append(heads)
    }
  }
}

## The locals the pattern binds, with the JS expressions of their values.
fn pat_binds(module: Module, pat: Pat, v: String) -> List[(Int, String)] {
  pat match {
    QBind(l)      -> [(l, v)]
    QCtor(ctor, args) -> {
      fields = variant_fields(module, ctor)
      args.enumerate().flat_map(|(i, p)| pat_binds(module, p, "#{v}.#{field_key(fields, i)}"))
    }
    QTuple(elems) -> elems.enumerate().flat_map(|(i, p)| pat_binds(module, p, "#{v}[#{i}]"))
    QList(elems, rest) -> {
      n = elems.length()
      at = |i: Int| "#{v}#{String.concat(List.range(0, i).map(|_| ".t"))}"
      heads = elems.enumerate().flat_map(|(i, p)| pat_binds(module, p, "#{at(i)}.h"))
      heads.append(rest.map(|r| pat_binds(module, r, at(n))).or([]))
    }
    _             -> []
  }
}

# ---------------------------------------------------------------------------------------------
# Showing values by their structure

## The string showing the JS value `v` of type `ty`: through its written Show impl, or by its
## structure.
fn show_call(module: Module, ty: Type, v: String) -> String {
  written = module.show_impls.get(Ir.type_key(ty)).and_then(|f| module.functions.get(f))
  written match {
    Some(f) -> "#{sanitize(f.name)}(#{v})"
    None    -> structural_show(module, ty, v)
  }
}

fn structural_show(module: Module, ty: Type, v: String) -> String {
  ty match {
    CList(elem)   -> "$showList(#{v}, #{show_fn(module, elem)})"
    CArray(elem)  -> "$showArray(#{v}, #{show_fn(module, elem)})"
    CTuple(elems) -> "$showTuple(#{v}, [#{String.join(elems.map(|t| show_fn(module, t)), ", ")}])"
    CEnum(id, args) -> {
      fs = args.map(|t| ", #{show_fn(module, t)}")
      "$show$#{enum_name(module, id)}(#{v}#{String.concat(fs)})"
    }
    _             -> "#{show_fn(module, ty)}(#{v})"
  }
}

## A JS function showing values of type `ty`.
fn show_fn(module: Module, ty: Type) -> String {
  written = module.show_impls.get(Ir.type_key(ty)).and_then(|f| module.functions.get(f))
  written match {
    Some(f) -> sanitize(f.name)
    None    -> structural_show_fn(module, ty)
  }
}

fn structural_show_fn(module: Module, ty: Type) -> String {
  ty match {
    CInt          -> "$showInt"
    CInt64        -> "$showInt64"
    CFloat        -> "$showFloat"
    CBool         -> "$showBool"
    CString       -> "$showString"
    CBytes        -> "$showBytes"
    CUnit         -> "$showUnit"
    CNever        -> "$unreachable"
    CParam(i)     -> "$a#{i}"
    CFn(_)        -> "$showFn"
    CEnum(id, []) -> "$show$#{enum_name(module, id)}"
    _             -> "(($x) => #{show_call(module, ty, "$x")})"
  }
}

## The show function of an enum: constructors shown as written (`Circle(r: 2)`, `Empty`), with a
## show function per type parameter.
fn show_enum_fn(module: Module, id: Int, def: EnumDef) -> List[String] {
  params = ["v"].append(List.range(0, def.params).map(|i| "$a#{i}"))
  cases = def.variants.enumerate().map(|(k, variant)| {
    pieces = variant.tys.enumerate().map(|(i, t)| {
      label = variant.fields match {
        FieldsNamed(names) -> "#{names.get(i).or("")}: "
        _                  -> ""
      }
      access = "v.#{field_key(variant.fields, i)}"
      "#{if i == 0 { "(" } else { ", " }}#{escape_template(label)}${#{show_call(module, t, access)}}"
    })
    close = if variant.tys.is_empty() { "" } else { ")" }
    (k, "return `#{escape_template(variant.name)}#{String.concat(pieces)}#{close}`;")
  })
  head = "function $show$#{enum_name(module, id)}(#{String.join(params, ", ")}) {"
  # With one constructor (an error's `$tag` is its descriptor) there is nothing to switch on.
  body = if cases.length() == 1 {
    cases.map(|(_, c)| "  #{c}")
  } else {
    ["  switch (v.$tag) {"].append(cases.map(|(k, c)| "    case #{k}: #{c}")).append(
      ["  }", "  return $unreachable();"],
    )
  }
  [head].append(body).append(["}", ""])
}

# ---------------------------------------------------------------------------------------------
# Operators and literals

## Int is wrapped to 32 bits after every operation; Int64 to 64 bits.
fn wrap(ty: OpTy, js: String) -> String {
  ty match {
    OpInt   -> "(#{js} | 0)"
    OpInt64 -> "BigInt.asIntN(64, #{js})"
    _       -> js
  }
}

fn binary(op: BinOp, ty: OpTy, a: String, b: String) -> String {
  compare = |js_op: String| {
    if ty == OpString {
      "($scmp(#{a}, #{b}) #{js_op} 0)"
    } else {
      "(#{a} #{js_op} #{b})"
    }
  }
  op match {
    BAdd -> wrap(ty, "(#{a} + #{b})")
    BSub -> wrap(ty, "(#{a} - #{b})")
    BMul -> if ty == OpInt { "Math.imul(#{a}, #{b})" } else { wrap(ty, "(#{a} * #{b})") }
    BDiv -> ty match {
      OpInt   -> "$idiv(#{a}, #{b})"
      OpInt64 -> "$ldiv(#{a}, #{b})"
      _       -> "(#{a} / #{b})"
    }
    BRem -> ty match {
      OpInt   -> "$irem(#{a}, #{b})"
      OpInt64 -> "$lrem(#{a}, #{b})"
      _       -> "(#{a} % #{b})"
    }
    BEq  -> if ty == OpStructural { "$eq(#{a}, #{b})" } else { "(#{a} === #{b})" }
    BNe  -> if ty == OpStructural { "(!$eq(#{a}, #{b}))" } else { "(#{a} !== #{b})" }
    BLt  -> compare("<")
    BLe  -> compare("<=")
    BGt  -> compare(">")
    BGe  -> compare(">=")
    BAnd -> "(#{a} && #{b})"
    BOr  -> "(#{a} || #{b})"
  }
}

fn emit_lit(lit: Lit) -> String {
  lit match {
    VInt(n)    -> if n < 0 { "(#{n})" } else { "#{n}" }
    VInt64(t)  -> "#{t}n"
    VFloat(f)  -> "#{f}"
    VBool(b)   -> if b { "true" } else { "false" }
    VString(s) -> quote(s)
    VUnit      -> "undefined"
  }
}

## A JS string literal.
fn quote(s: String) -> String {
  "\"#{String.concat(s.code_points().map(|c| escape_char(c, 34)))}\""
}

fn escape_template(s: String) -> String {
  String.concat(
    s.code_points().map(|c| {
      if c == 36 { "\\$" } else if c == 96 { "\\`" } else { escape_char(c, 96) }
    }),
  )
}

## A code point inside a JS string delimited by `quote_char`.
fn escape_char(c: Int, quote_char: Int) -> String {
  if c == quote_char {
    "\\#{String.from_code_point(c).or("")}"
  } else if c == 92 {
    "\\\\"
  } else if c == 10 {
    "\\n"
  } else if c == 13 {
    "\\r"
  } else if c == 9 {
    "\\t"
  } else if c < 32 {
    "\\u#{hex4(c)}"
  } else {
    String.from_code_point(c).or("")
  }
}

fn hex4(c: Int) -> String {
  digits = "0123456789abcdef".code_points()
  String.concat(
    [12, 8, 4, 0].map(|shift| {
      d = (c / pow2(shift)) % 16
      digits.get(d).and_then(String.from_code_point).or("0")
    }),
  )
}

fn pow2(n: Int) -> Int {
  if n == 0 { 1 } else { 2 * pow2(n - 1) }
}

## Emits JS from the Core IR. Follows `emit.rs` of emela-codegen-js, and uses its runtime
## (`emela_runtime.mjs`), so values have the same representation:
##
## ```text
## Int      number, wrapped to 32 bits after every operation
## Int64    BigInt
## Float    number
## Bool     boolean
## String   string
## ()       undefined
## tuple    array [a, b]
## List     cons cells { h, t }, the empty list is null
## ```
##
## The output is an ES module that exports `main` for the launcher.
import Std.Map.{Map}
import Core.Ir.{
  Module,
  Function,
  Type,
  CInt,
  CInt64,
  CFloat,
  CString,
  Lit,
  VInt,
  VInt64,
  VFloat,
  VBool,
  VString,
  VUnit,
  Expr,
  XLit,
  XVar,
  XFn,
  XLet,
  XCall,
  XTuple,
  XIf,
  XBinary,
  XUnary,
  XConcat,
  XSeq,
  Direct,
  Indirect,
  SLit,
  SValue,
  BinOp,
  BAdd,
  BSub,
  BMul,
  BDiv,
  BRem,
  BEq,
  BNe,
  BLt,
  BLe,
  BGt,
  BGe,
  BAnd,
  BOr,
  UNot,
  UNeg,
  OpTy,
  OpInt,
  OpInt64,
  OpFloat,
}

## The JS module of `module`.
pub fn emit(module: Module) -> String {
  functions = module.functions.fold([], |acc, _, f| acc.append([emit_fn(module, f)]))
  exported = module.functions.fold(
    [],
    |acc, _, f| if f.exported { acc.append([f.name]) } else { acc },
  )
  lines = ["// Generated by Graft.", "import { $None } from \"./emela_runtime.mjs\";", ""].append(
    functions.flat_map(|f| f.append([""])),
  ).append(["export { #{String.join(exported, ", ")} };", ""])
  String.join(lines, "\n")
}

fn emit_fn(module: Module, f: Function) -> List[String] {
  params = String.join(f.params.map(|p| local_name(module, p)), ", ")
  ["function #{f.name}(#{params}) {"].append(returning(module, f.body, "  ")).append(["}"])
}

fn local_name(module: Module, local: Int) -> String {
  hint = module.locals.get(local).map(|l| l.hint).or("v")
  "#{hint}$#{local}"
}

fn fn_name(module: Module, f: Int) -> String {
  module.functions.get(f).map(|x| x.name).or("$missing")
}

## The statements that compute `expr` and return it.
fn returning(module: Module, expr: Expr, indent: String) -> List[String] {
  expr match {
    XLet(bound, value, body) -> [
      "#{indent}const #{local_name(module, bound)} = #{emit_expr(module, value)};",
    ].append(returning(module, body, indent))
    XSeq(first, rest) -> statement(module, first, indent).append(returning(module, rest, indent))
    XIf(c, t, e) -> ["#{indent}if (#{emit_expr(module, c)}) {"].append(
      returning(module, t, "#{indent}  "),
    ).append(["#{indent}} else {"]).append(returning(module, e, "#{indent}  ")).append(
      ["#{indent}}"],
    )
    _ -> ["#{indent}return #{emit_expr(module, expr)};"]
  }
}

## The statements that evaluate `expr` for its effects.
fn statement(module: Module, expr: Expr, indent: String) -> List[String] {
  expr match {
    XLit(_) -> []
    XVar(_) -> []
    _       -> ["#{indent}#{emit_expr(module, expr)};"]
  }
}

## `expr` as a JS expression.
fn emit_expr(module: Module, expr: Expr) -> String {
  e = |x: Expr| emit_expr(module, x)
  expr match {
    XLit(lit)                          -> emit_lit(lit)
    XVar(local)                        -> local_name(module, local)
    XFn(f, _)                          -> fn_name(module, f)
    XCall(Direct(f, _), args, _, _)    -> "#{fn_name(module, f)}(#{String.join(args.map(e), ", ")})"
    XCall(Indirect(value), args, _, _) -> "(#{e(value)})(#{String.join(args.map(e), ", ")})"
    XTuple(elems)                      -> "[#{String.join(elems.map(e), ", ")}]"
    XIf(c, t, f)                       -> "(#{e(c)} ? #{e(t)} : #{e(f)})"
    XBinary(op, ty, lhs, rhs)          -> binary(op, ty, e(lhs), e(rhs))
    XUnary(UNot, _, operand)           -> "(!#{e(operand)})"
    XUnary(UNeg, ty, operand)          -> wrap(ty, "(-#{e(operand)})")
    XConcat(parts) -> {
      inner = String.concat(
        parts.map(|p| {
          p match {
            SLit(text)   -> escape_template(text)
            SValue(v, _) -> "${#{e(v)}}"
          }
        }),
      )
      "`#{inner}`"
    }
    # Bindings and sequences inside an expression become a function called at once.
    _ -> {
      body = String.join(returning(module, expr, "  "), "\n")
      "(() => {\n#{body}\n})()"
    }
  }
}

## Int is wrapped to 32 bits after every operation; Int64 to 64 bits.
fn wrap(ty: OpTy, js: String) -> String {
  ty match {
    OpInt   -> "(#{js} | 0)"
    OpInt64 -> "BigInt.asIntN(64, #{js})"
    _       -> js
  }
}

fn binary(op: BinOp, ty: OpTy, a: String, b: String) -> String {
  op match {
    BAdd -> wrap(ty, "(#{a} + #{b})")
    BSub -> wrap(ty, "(#{a} - #{b})")
    BMul -> if ty == OpInt { "Math.imul(#{a}, #{b})" } else { wrap(ty, "(#{a} * #{b})") }
    BDiv -> wrap(ty, "(#{a} / #{b})")
    BRem -> wrap(ty, "(#{a} % #{b})")
    BEq  -> "(#{a} === #{b})"
    BNe  -> "(#{a} !== #{b})"
    BLt  -> "(#{a} < #{b})"
    BLe  -> "(#{a} <= #{b})"
    BGt  -> "(#{a} > #{b})"
    BGe  -> "(#{a} >= #{b})"
    BAnd -> "(#{a} && #{b})"
    BOr  -> "(#{a} || #{b})"
  }
}

fn emit_lit(lit: Lit) -> String {
  lit match {
    VInt(n)    -> if n < 0 { "(#{n})" } else { "#{n}" }
    VInt64(t)  -> "#{t}n"
    VFloat(f)  -> "#{f}"
    VBool(b)   -> if b { "true" } else { "false" }
    VString(s) -> quote(s)
    VUnit      -> "undefined"
  }
}

## A JS string literal.
fn quote(s: String) -> String {
  "\"#{String.concat(s.code_points().map(|c| escape_char(c, 34)))}\""
}

fn escape_template(s: String) -> String {
  String.concat(
    s.code_points().map(|c| {
      if c == 36 { "\\$" } else if c == 96 { "\\`" } else { escape_char(c, 96) }
    }),
  )
}

## A code point inside a JS string delimited by `quote_char`.
fn escape_char(c: Int, quote_char: Int) -> String {
  if c == quote_char {
    "\\#{String.from_code_point(c).or("")}"
  } else if c == 92 {
    "\\\\"
  } else if c == 10 {
    "\\n"
  } else if c == 13 {
    "\\r"
  } else if c == 9 {
    "\\t"
  } else if c < 32 {
    "\\u#{hex4(c)}"
  } else {
    String.from_code_point(c).or("")
  }
}

fn hex4(c: Int) -> String {
  digits = "0123456789abcdef".code_points()
  String.concat(
    [12, 8, 4, 0].map(|shift| {
      d = (c / pow2(shift)) % 16
      digits.get(d).and_then(String.from_code_point).or("0")
    }),
  )
}

fn pow2(n: Int) -> Int {
  if n == 0 { 1 } else { 2 * pow2(n - 1) }
}

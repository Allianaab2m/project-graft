## Builds the tree from the events of the parser, inserting trivia. Follows `sink.rs` of the
## reference implementation.
##
## Where trivia goes:
## - trivia right before a node goes outside it (on the parent's side), except that a doc comment
##   and what follows it go inside a node that takes a doc comment
## - leading and trailing trivia goes inside Root
import Std.Array.{Array}
import Std.Map.{Map}
import Parser.{Parser, Event, Open, Bump, Close, Report}
import Syntax.{NodeKind, Tree, Branch, Leaf, Diagnostic, Root, takes_doc}
import Token.{Token, is_trivia, DocComment}

## A node being built. `children` are newest first.
type Frame(kind: NodeKind, start: Int, children: List[Tree])

type Sink(
  ## The next token to place.
  pos: Int,
  ## The end of the last token placed.
  offset: Int,
  ## Innermost first.
  stack: List[Frame],
  ## Newest first.
  diagnostics: List[Diagnostic],
  root: Option[Tree],
)

## The tree, and the diagnostics of the parser sorted by position (keeping the order of the parser
## for ties).
pub type Built(tree: Tree, diagnostics: List[Diagnostic])

## `tokens` are all the tokens of `src`, trivia included; `p` is the parser after the grammar ran.
pub fn build(src: Array[Int], tokens: Array[Token], p: Parser) -> Built {
  # Parents attached by `precede` are opened with their first child, not where they were started.
  late = p.parents.fold(Map.empty(), |acc, _, parent| acc.insert(parent, True))
  initial = Sink(pos: 0, offset: 0, stack: [], diagnostics: [], root: None)
  sink = p.events.reverse().fold(initial, |s, event| {
    event match {
      Open(id) if late.contains(id) -> s
      Open(id) -> p.kinds.get(id) match {
        None       -> s
        Some(kind) -> open_nodes(tokens, s, chain(p, id, [kind]))
      }
      Bump                          -> push_token(tokens, eat_trivia(tokens, s, False))
      Close                         -> close_node(tokens, s)
      Report(code, message) -> {
        (start, end) = error_range(src, tokens, s.pos)
        Sink(diagnostics: [Diagnostic(code, start, end, message), ..s.diagnostics], ..s)
      }
    }
  })
  diagnostics = sink.diagnostics.reverse().sort_by(
    |a, b| Ord.compare((a.start, a.end), (b.start, b.end)),
  )
  Built(sink.root.or(Branch(Root, 0, 0, [])), diagnostics)
}

## The kinds of the node `id` and of the parents `precede` attached to it, outermost first.
fn chain(p: Parser, id: Int, acc: List[NodeKind]) -> List[NodeKind] {
  p.parents.get(id) match {
    None -> acc
    Some(parent) -> p.kinds.get(parent) match {
      None       -> acc
      Some(kind) -> chain(p, parent, [kind, ..acc])
    }
  }
}

fn open_nodes(tokens: Array[Token], s: Sink, kinds: List[NodeKind]) -> Sink {
  placed = if s.stack.is_empty() {
    s
  } else {
    # A doc comment goes inside the node that takes it.
    eat_trivia(tokens, s, kinds.any(takes_doc))
  }
  kinds.fold(placed, |acc, kind| {
    Sink(stack: [Frame(kind, acc.offset, []), ..acc.stack], ..acc)
  })
}

## Places the trivia before the next significant token, stopping at a doc comment if `before_doc`.
fn eat_trivia(tokens: Array[Token], s: Sink, before_doc: Bool) -> Sink {
  tokens.get(s.pos) match {
    Some(t) if is_trivia(t.kind) && !(before_doc && t.kind == DocComment) -> {
      eat_trivia(tokens, push_token(tokens, s), before_doc)
    }
    _ -> s
  }
}

fn push_token(tokens: Array[Token], s: Sink) -> Sink {
  tokens.get(s.pos) match {
    None -> s
    Some(t) -> s.stack match {
      [] -> s
      [frame, ..rest] -> {
        top = Frame(children: [Leaf(t), ..frame.children], ..frame)
        Sink(pos: s.pos + 1, offset: t.end, stack: [top, ..rest], ..s)
      }
    }
  }
}

fn push_rest(tokens: Array[Token], s: Sink) -> Sink {
  if s.pos < tokens.size() { push_rest(tokens, push_token(tokens, s)) } else { s }
}

fn close_node(tokens: Array[Token], s: Sink) -> Sink {
  done = if s.stack.length() == 1 { push_rest(tokens, s) } else { s }
  done.stack match {
    [] -> done
    [frame, ..rest] -> {
      node = Branch(frame.kind, frame.start, done.offset, frame.children.reverse())
      rest match {
        [] -> Sink(stack: [], root: Some(node), ..done)
        [parent, ..outer] -> {
          up = Frame(children: [node, ..parent.children], ..parent)
          Sink(stack: [up, ..outer], ..done)
        }
      }
    }
  }
}

## The range of the first significant token from `pos`, or an empty range at the end.
fn error_range(src: Array[Int], tokens: Array[Token], pos: Int) -> (Int, Int) {
  tokens.get(pos) match {
    None                         -> (src.size(), src.size())
    Some(t) if is_trivia(t.kind) -> error_range(src, tokens, pos + 1)
    Some(t)                      -> (t.start, t.end)
  }
}

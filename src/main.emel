## The command line of Graft.
##
## - `graft roundtrip <file>...` lexes each file and checks that its tokens concatenate back to
##   the file without gaps.
## - `graft tokens <file>` prints the tokens of a file as `Kind@start..end`, one per line, in the
##   format of `tools/oracle`.
## - `graft fmt <file> [width]` prints the file formatted (at `width`, 100 by default), `error`
##   if it has syntax errors, or `internal error`, in the format of `tools/oracle`.
## - `graft parse <file>...` parses each file and prints the number of diagnostics, to time the
##   parser.
## - `graft tree <file>` prints the syntax tree of a file and the diagnostics of the parser, in the
##   format of `tools/oracle`.
import Std.Array.{Array}
import Std.Console.{Console}
import Std.FileSystem.{FileSystem}
import Std.Process.{Process, Args, Stdout, ExitCode, EXIT_SUCCESS, EXIT_FAILURE}
import Format.{DEFAULT_WIDTH, Done, SyntaxErrors, Internal}
import Grammar
import Lexer
import Parser
import Sink
import Syntax

fn main() -> ExitCode {
  with Process {
    args = use Args
    console = use Console
    args.list() match {
      ["roundtrip", ..files] -> roundtrip(files)
      ["tokens", path]       -> tokens(path)
      ["fmt", path]          -> fmt(path, DEFAULT_WIDTH)
      ["fmt", path, width] -> Some(Int.parse(width)) escape { _ -> None } match {
        Some(w) -> fmt(path, w)
        None    -> usage()
      }
      ["parse", ..files]     -> parse(files)
      ["tree", path]         -> tree(path)
      _                      -> usage()
    }
  }
}

fn usage() -> ExitCode uses { Console } {
  (use Console).print_error_line(
    "usage: graft roundtrip <file>... | graft parse <file>... | graft tokens <file> | graft tree <file> | graft fmt <file> [width]",
  )
  Process.exit_code(2)
}

fn roundtrip(files: List[String]) -> ExitCode uses { Console, FileSystem } {
  console = use Console
  failed = files.filter(|path| !roundtrips(path))
  failed.each(|path| console.print_line("FAILED #{path}"))
  console.print_line("#{files.length() - failed.length()}/#{files.length()} files round-trip")
  if failed.is_empty() { EXIT_SUCCESS } else { EXIT_FAILURE }
}

fn roundtrips(path: String) -> Bool uses { FileSystem } {
  fs = use FileSystem
  Some(fs.read_text(path)) escape { _ -> None } match {
    None -> False
    Some(text) -> {
      src = Array.from_list(text.code_points())
      tokens = Lexer.tokens(src)
      end = tokens.fold(0, |pos, t| if t.start == pos && t.end > pos { t.end } else { -1 })
      end == src.size()
    }
  }
}

fn tokens(path: String) -> ExitCode uses { Console, FileSystem, Stdout } {
  console = use Console
  fs = use FileSystem
  Some(fs.read_text(path)) escape { _ -> None } match {
    None -> {
      console.print_error_line("cannot read #{path}")
      EXIT_FAILURE
    }
    Some(text) -> {
      lines = Lexer.lex(text).map(|t| "#{t.kind}@#{t.start}..#{t.end}\n")
      (use Stdout).print(String.concat(lines))
      EXIT_SUCCESS
    }
  }
}

fn parse(files: List[String]) -> ExitCode uses { Console, FileSystem } {
  console = use Console
  fs = use FileSystem
  counts = files.map(|path| {
    Some(fs.read_text(path)) escape { _ -> None } match {
      None       -> -1
      Some(text) -> build(text).diagnostics.length()
    }
  })
  unread = counts.filter(|n| n < 0).length()
  diagnostics = counts.fold(0, |sum, n| if n > 0 { sum + n } else { sum })
  console.print_line(
    "#{files.length() - unread} files parsed, #{diagnostics} diagnostics, #{unread} unreadable",
  )
  if unread == 0 { EXIT_SUCCESS } else { EXIT_FAILURE }
}

fn build(text: String) -> Sink.Built {
  src = Array.from_list(text.code_points())
  tokens = Lexer.tokens(src)
  p = Parser.run(src, tokens, Grammar.source_file)
  Sink.build(src, Array.from_list(tokens), p)
}

fn tree(path: String) -> ExitCode uses { Console, FileSystem, Stdout } {
  console = use Console
  fs = use FileSystem
  Some(fs.read_text(path)) escape { _ -> None } match {
    None -> {
      console.print_error_line("cannot read #{path}")
      EXIT_FAILURE
    }
    Some(text) -> {
      built = build(text)
      errors = built.diagnostics.map(|d| "error[#{d.code}]@#{d.start}..#{d.end}\n")
      (use Stdout).print(String.concat(List.append(Syntax.dump(built.tree), errors)))
      EXIT_SUCCESS
    }
  }
}

fn fmt(path: String, width: Int) -> ExitCode uses { Console, FileSystem, Stdout } {
  console = use Console
  fs = use FileSystem
  Some(fs.read_text(path)) escape { _ -> None } match {
    None -> {
      console.print_error_line("cannot read #{path}")
      EXIT_FAILURE
    }
    Some(text) -> {
      out = Format.format_with_width(text, width) match {
        Done(formatted) -> formatted
        SyntaxErrors    -> "error\n"
        Internal(_)     -> "internal error\n"
      }
      (use Stdout).print(out)
      EXIT_SUCCESS
    }
  }
}

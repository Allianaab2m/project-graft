## The state of inferring one group of definitions (`Body`), shared with the computation of
## their error and effect sets (`Errors`).
import Std.Map.{Map}
import Std.State.{State}
import Hir.{Program, DefModule, Span, Arm, Param, IFn, ITraitFn}
import Groups.{impl_fn}
import Ty.{Ty, Row, RowElem, Tag, TyParam, ParamKind, FnTy, SetKind}
import Tylower.{TyTable}
import Signature.{Signatures}
import Traits.{Traits}
import Layer.{Entry}

## A definition without a declared type: its monomorphic type within the group and its type
## parameters (written and invisible set ones).
pub type Pending(def: Int, ty: Ty, params: List[TyParam])

## A reference within the group to a pending definition with written type parameters, checked
## against the definition's final type once the group is inferred.
pub type DeferredRef(def: Int, args: List[Ty], rows: List[Row], instance: Ty, span: Span)

## Integer literals need Int or Int64 (`integer`); arithmetic operands a number.
pub type NumConstraint(ty: Ty, span: Span, integer: Bool, literal: Option[String])

## The state while inferring one group.
pub type BodyState(
  program: Program,
  table: TyTable,
  sigs: Signatures,
  current: Option[Int],
  ## The module of the definition being inferred, for whether opaque fields are accessible.
  module: DefModule,
  ## Type parameters of the fn being inferred and their kinds.
  type_params: List[Int],
  param_kinds: List[ParamKind],
  ## What `Self` stands for.
  self_ty: Option[Ty],
  pending: List[Pending],
  ## Newest first.
  deferred: List[DeferredRef],
  locals: Map[Int, Ty],
  ## Local fns → the labels of their named arguments.
  local_labels: Map[Int, List[Option[String]]],
  ## Newest first.
  numbers: List[NumConstraint],
  ## The handler whose init is being inferred.
  in_init: Option[Int],
  ## References to capability operations → the effect operation.
  ops: Map[Int, Int],
  ## Callees of calls, where a handler member may be opened inside an init.
  member_callees: Map[Int, Bool],
  traits: Traits,
  ## Derived impls that something required (W0303).
  used: Map[(Int, Int), Bool],
  ## Newest first.
  trait_obligations: List[TraitObligation],
  ## Newest first.
  self_obligations: List[SelfObligation],
  ## Matches and bindings to check for coverage once types are settled. Newest first.
  coverage: List[CoverageSite],
  ## Inferred definitions, in inference order.
  defs: List[Int],
  ## The type of each expression inferred.
  expr_tys: Map[Int, Ty],
  ## Lambda expressions → the set variables of their type's E and R, which contain the body's.
  lambda_rows: Map[Int, (Int, Int)],
  ## Local fns, by the local that names them.
  local_fns: Map[Int, LocalFnInfo],
  ## Set variables for the dependencies and the init E of the group's handlers:
  ## (handler, uses, fails).
  pending_handlers: List[(Int, Int, Int)],
  ## The dependencies and init E of handlers of earlier groups.
  facts: HandlerFacts,
  handler_bodies: List[HandlerBody],
  handler_parts: List[HandlerPart],
  ## The inferred E and R of pending definitions, placed at references from other definitions of
  ## the group once solved.
  instance_sets: List[InstanceSet],
  ## `with` expressions → the items that open handler members, with the types of opening them.
  with_members: Map[Int, List[(Int, FnTy)]],
  ## Each expression's E, computed after the body is inferred.
  expr_rows: Map[Int, Row],
  ## Set variables whose solution is another's minus the listed elements: (δ, v, elems).
  row_diffs: List[(Int, Int, List[RowElem])],
  ## Set variables whose solution is another's with the listed capabilities replaced by their
  ## effects.
  row_widens: List[(Int, Int, List[RowElem])],
  ## Newest first.
  escapes: List[EscapeInfo],
  ## The lambda expression or local fn body whose body is being inferred; `None` in the body of
  ## the definition itself.
  binder: Option[Int],
  ## The binder each local is bound in. A local used inside another binder is captured.
  local_binder: Map[Int, Option[Int]],
  ## The definition whose body each local belongs to.
  local_owner: Map[Int, Int],
  ## Calls (and method calls) → the arguments by parameter position.
  calls: Map[Int, List[Option[Int]]],
  ## Method call callees → the fn called.
  methods: Map[Int, Int],
  ## Locals bound to the capability a handler member item of `with` opens.
  member_bound: Map[Int, Bool],
  ## Locals bound to `use E`, or to a `with` item, or the `self` of a handler whose fields hold
  ## capabilities: at the end of their binding their capability is removed, not widened.
  use_bound: Map[Int, Bool],
  ## Each expression's R, computed after the body is inferred.
  expr_effects: Map[Int, Row],
  ## The call on the right of a pipe `x |> f(a)` → the pipe expression.
  piped_calls: Map[Int, Int],
  ## While computing R: the enclosing `with` expressions, innermost first, with the effects they
  ## provide.
  with_stack: List[(Int, List[Tag])],
  ## Locals bound to `use E` → the `with` that provides E there. Their capability is removed
  ## where it ends.
  cap_roots: Map[Int, Int],
  ## Definitions whose R must be empty apart from the host effects the entry provides.
  closed: Map[Int, Closed],
  ## Sets that instantiate set type parameters bounded by `Immediate`, checked once solved.
  immediates: List[ImmediateObligation],
  ## Set variables to be generalized that get the `Immediate` bound.
  immediate_vars: List[Int],
  ## Openings of handler members → the member.
  member_opens: Map[Int, Int],
  ## `with` expressions with their providers and dependencies, whose initialization order is
  ## decided once sets are solved.
  withs: List[PendingWith],
  fibers: Fibers,
)

## A `with` whose providers' initialization order is decided once sets are solved.
pub type PendingWith(expr: Int, body: Int, entries: List[Entry], deps: List[Row])

## The scope functions of the built-in effects (`Fiber.scope`) and the types their operations
## return (`Fiber`, `Deferred`), which cannot leave a scope (E0425).
pub type Fibers(scope_fns: List[Int], handles: List[Int])

## A set that must be Immediate (E0416): where it was required, and the definition whose type
## parameters it may name.
pub type ImmediateObligation(row: Row, span: Span, owner: Option[Int])

## Why a definition's R is closed.
pub enum Closed {
  ## The entry's `main` or a test: Async and ProcessHost are provided.
  ClosedMain
  ## An `@export` fn: Async and the given host effects are provided.
  ClosedExport(hosts: List[Int])
}

## A fresh state for a group.
pub fn new_state(
  program: Program,
  table: TyTable,
  traits: Traits,
  sigs: Signatures,
  facts: HandlerFacts,
  closed: Map[Int, Closed],
  fibers: Fibers,
) -> BodyState {
  BodyState(
    program:,
    table:,
    sigs:,
    current: None,
    module: Hir.BuiltinPrelude,
    type_params: [],
    param_kinds: [],
    self_ty: None,
    pending: [],
    deferred: [],
    locals: Map.empty(),
    local_labels: Map.empty(),
    numbers: [],
    in_init: None,
    ops: Map.empty(),
    member_callees: Map.empty(),
    traits:,
    used: Map.empty(),
    trait_obligations: [],
    self_obligations: [],
    coverage: [],
    defs: [],
    expr_tys: Map.empty(),
    lambda_rows: Map.empty(),
    local_fns: Map.empty(),
    pending_handlers: [],
    facts:,
    handler_bodies: [],
    handler_parts: [],
    instance_sets: [],
    with_members: Map.empty(),
    expr_rows: Map.empty(),
    row_diffs: [],
    row_widens: [],
    escapes: [],
    binder: None,
    local_binder: Map.empty(),
    local_owner: Map.empty(),
    calls: Map.empty(),
    methods: Map.empty(),
    member_bound: Map.empty(),
    use_bound: Map.empty(),
    expr_effects: Map.empty(),
    piped_calls: Map.empty(),
    with_stack: [],
    cap_roots: Map.empty(),
    closed:,
    immediates: [],
    immediate_vars: [],
    member_opens: Map.empty(),
    withs: [],
    fibers:,
  )
}

## A local fn of a body (`[fn.local]`), for computing its E and R once types are settled.
pub type LocalFnInfo(
  ## The definition it is in.
  owner: Option[Int],
  body: Int,
  ## The E and R of its type, which contain those of the body.
  fails: Row,
  uses: Row,
  ## Whether its E is declared (`-> T` is written); then the body's E is checked against it.
  fails_declared: Bool,
  ## Whether `uses` is written; then the body's R is checked against it.
  uses_written: Bool,
)

## The body of a handler's `index`-th operation.
pub type HandlerBody(
  owner: Int,
  index: Int,
  body: Int,
  ## The E of the operation's declaration.
  fails: Row,
  ## A suspend fn implementation that uses `resume` other than by calling it (spec 8.7).
  resume_later: Bool,
  is_suspend: Bool,
)

## A handler's init or release body.
pub type HandlerPart(owner: Int, body: Int, release: Bool)

## The dependencies (R) and the init E of handlers inferred in earlier groups.
pub type HandlerFacts(uses: Map[Int, Row], fails: Map[Int, Row])

## A reference from another definition of the group to a pending one whose E or R is inferred:
## the solved set, placed with the reference's arguments, is contained in `instance`.
pub type InstanceSet(inferred: Row, instance: Int, kind: SetKind, args: List[Ty], rows: List[Row])

## An `escape`, for the W0302 check once the error sets are solved: the inner expression, the
## arms above the first `_` that catch an error (pattern, error), and the pattern of that `_`.
pub type EscapeInfo(inner: Int, caught: List[(Int, Int)], wildcard: Option[Int])

## Places where coverage is checked.
pub enum CoverageSite {
  MatchSite(scrutinee: Int, ty: Ty, arms: List[Arm])
  ## A binding `pat = value`, whose pattern must always succeed (spec 6.3).
  BindingSite(pat: Int, ty: Ty)
  ## `escape` arms grouped by the caught error type; only redundant arms are checked.
  EscapeSite(groups: List[(Ty, List[Arm])])
}

## A type that must satisfy a trait: the instantiation of a constrained type parameter at a
## reference, or an operand of `==`, `<` or interpolation. `owner` is the definition whose type
## parameters `TyBound(i)` in `ty` are. A Float passes `float_ok` (the built-in comparison).
pub type TraitObligation(ty: Ty, trait_def: Int, span: Span, owner: Option[Int], float_ok: Bool)

## The `Self` of a trait function determined only by its result type (E0333).
pub type SelfObligation(ty: Ty, trait_def: Int, span: Span)

pub fn bs() -> BodyState uses { State[BodyState] } {
  (use State[BodyState]).get()
}

pub fn bupd(f: fn(BodyState) -> BodyState) -> () uses { State[BodyState] } {
  s = use State[BodyState]
  s.set(f(s.get()))
}

pub fn prog() -> Program uses { State[BodyState] } {
  bs().program
}

## The parameters and body of a function definition: a top-level fn, a trait's function or an
## impl's function.
pub fn fn_parts(program: Program, def: Int) -> Option[(List[Param], Option[Int])] {
  program.items.get(def) match {
    Some(IFn(f))      -> Some((f.sig.params, f.body))
    Some(ITraitFn(f)) -> Some((f.sig.params, f.body))
    Some(_)           -> None
    None              -> impl_fn(program, def).map(|(_, f)| (f.params, f.body))
  }
}

## The local `expr` refers to, if its capability is an element of R by itself: a variable bound
## outside the closure or local fn being inferred, or a parameter of the function being inferred.
pub fn named_capability(expr: Int) -> Option[Int] uses { State[BodyState] } {
  b = bs()
  b.program.exprs.get(expr).map(|e| e.kind) match {
    Some(Hir.EPath(Hir.ResLocal(local))) -> if b.member_bound.contains(local) {
      Some(local)
    } else {
      b.local_binder.get(local).and_then(|bound| {
        if bound != b.binder || is_fn_param(local) { Some(local) } else { None }
      })
    }
    _ -> None
  }
}

## Whether `local` is a parameter of the function definition being inferred.
pub fn is_fn_param(local: Int) -> Bool uses { State[BodyState] } {
  b = bs()
  b.current.map(|def| {
    owned = b.local_owner.get(local) == Some(def) && b.local_binder.get(local) == Some(None)
    owned && fn_parts(b.program, def).map(|(ps, _)| ps.any(|p| p.local == local)).or(False)
  }).or(False)
}

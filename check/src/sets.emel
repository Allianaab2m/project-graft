fn diag(span: Span, code: String, message: String) -> () uses { State[TyLower] } {
  report(Some(span), code, message)
}

fn expr_span(expr: Int) -> Span {
  prog().exprs.get(expr).map(|e| e.span).or(Span(0, 0, 0))
}

fn pat_span(pat: Int) -> Span {
  prog().pats.get(pat).map(|p| p.span).or(Span(0, 0, 0))
}

fn when_some[A](o: Option[A], f: fn(A) -> ()) -> () {
  o match {
    Some(x) -> f(x)
    None    -> ()
  }
}

# ---------------------------------------------------------------------------------------------
# Computing E

## Computes the E of the group's bodies and adds that they are contained in the declared E.
pub fn infer_errors() -> () uses { State[BodyState], State[Infer], State[TyLower] } {
  program = prog()
  bs().defs.each(|def| {
    bupd(|b| BodyState(current: Some(def), ..b))
    program.items.get(def) match {
      # A const's value cannot fail (spec 5.6).
      Some(IConst(c)) -> add_subset(expr_row(c.value), EMPTY_ROW, Infer.Body(def))
      # A handler operation body's E is contained in the operation's E (spec 8.1); init's E goes
      # into the E of `with` (spec 9.4); release's E is empty (spec 8.4).
      Some(IHandler(_)) -> {
        bs().handler_bodies.filter(|hb| hb.owner == def).each(|hb| {
          add_subset(expr_row(hb.body), hb.fails, Infer.HandlerOp(def, hb.index))
        })
        bs().handler_parts.filter(|p| p.owner == def).each(|p| {
          row = expr_row(p.body)
          if p.release {
            add_subset(row, EMPTY_ROW, Infer.Release(def))
          } else {
            add_subset(row, handler_init_fails(def), Infer.HandlerPart)
          }
        })
      }
      # The arguments of a layer's items cannot fail (`[effect.layer]`).
      Some(ILayer(item)) -> item.members.enumerate().each(|(member, m)| {
        m.args.map(|a| a.args).or([]).each(|arg| {
          add_subset(expr_row(arg.value), EMPTY_ROW, Infer.LayerArg(def, member, arg.value))
        })
      })
      _ -> fn_parts(program, def).and_then(|(_, body)| body) match {
        Some(body) -> def_ty(def).map(shallow_resolve) match {
          Some(TyFn(f)) -> add_subset(expr_row(body), f.fails, Infer.Body(def))
          _             -> ()
        }
        None -> ()
      }
    }
  })
}

## The declared type, or the monomorphic type within the group.
fn def_ty(def: Int) -> Option[Ty] {
  b = bs()
  Signature.get(b.sigs, def).map(|s| s.scheme.ty) match {
    Some(t) -> Some(t)
    None    -> b.pending.find(|p| p.def == def).map(|p| p.ty)
  }
}

## A handler's init E: computed in an earlier group, or a set variable within this group.
fn handler_init_fails(hdl: Int) -> Row {
  b = bs()
  b.facts.fails.get(hdl) match {
    Some(row) -> row
    None -> b.pending_handlers.find(|(h, _, _)| h == hdl).map(|(_, _, v)| var_row(v)).or(EMPTY_ROW)
  }
}

fn rows_of(exprs: List[Int]) -> Row {
  exprs.fold(EMPTY_ROW, |row, e| union(row, expr_row(e)))
}

## Sub-expressions' E flows into the parent (spec 9.4). Records each expression's E.
fn expr_row(expr: Int) -> Row {
  program = prog()
  row = program.exprs.get(expr) match {
    None -> EMPTY_ROW
    Some(e) -> e.kind match {
      EMissing             -> EMPTY_ROW
      ELit(_)              -> EMPTY_ROW
      EPath(_)             -> EMPTY_ROW
      EUnit                -> EMPTY_ROW
      EUse(_, _)           -> EMPTY_ROW
      EInterpolated(parts) -> rows_of(
        parts.filter_map(|p| {
          p match {
            SInterp(x) -> Some(x)
            _          -> None
          }
        }),
      )
      EField(base, _)      -> expr_row(base)
      ECall(callee, args) -> {
        row = union(expr_row(callee), rows_of(args.map(|a| a.value)))
        union(row, callee_fails(callee, e.span))
      }
      EUnary(_, operand)   -> expr_row(operand)
      # `x |> f(a)` is `f(x, a)`. The right side's call records E without the left side's.
      EBinary(OpPipe, lhs, rhs) -> {
        left = expr_row(lhs)
        right = program.exprs.get(rhs).map(|r| r.kind) match {
          Some(ECall(callee, args)) -> {
            r = union(
              union(expr_row(callee), rows_of(args.map(|a| a.value))),
              callee_fails(callee, e.span),
            )
            bupd(|b| BodyState(expr_rows: b.expr_rows.insert(rhs, r), ..b))
            r
          }
          _ -> union(expr_row(rhs), callee_fails(rhs, e.span))
        }
        union(left, right)
      }
      EBinary(_, lhs, rhs) -> union(expr_row(lhs), expr_row(rhs))
      ETuple(elems)        -> rows_of(elems)
      EList(elems, rest)   -> union(rows_of(elems), rest.map(expr_row).or(EMPTY_ROW))
      EBlock(block) -> {
        row = block.stmts.fold(EMPTY_ROW, |acc, stmt| {
          stmt match {
            SLet(_, _, value) -> union(acc, expr_row(value))
            SLocalFn(f) -> {
              local_fn_errors(f.local)
              acc
            }
            SExpr(x)          -> union(acc, expr_row(x))
          }
        })
        union(row, block.tail.map(expr_row).or(EMPTY_ROW))
      }
      EIf(c, t, el)        -> union(union(expr_row(c), expr_row(t)), el.map(expr_row).or(EMPTY_ROW))
      EMatch(scrutinee, arms) -> union(expr_row(scrutinee), arms_row(arms))
      EEscape(inner, arms) -> escape_row(inner, arms)
      EFail(inner) -> {
        row = expr_row(inner)
        ty = resolve(bs().expr_tys.get(inner).or(TyError))
        if is_error_ty(ty) {
          insert(row, ROf(ty))
        } else {
          diag(expr_span(inner), "E0319", "expected an error value")
          row
        }
      }
      EAssert(x)           -> expr_row(x)
      EUpdate(ctor, fields, base) -> union(
        union(expr_row(ctor), rows_of(fields.map(|f| f.value))),
        expr_row(base),
      )
      # The body's E plus the init E of the listed handlers and the E of the arguments of their
      # inits (spec 9.4). The arguments of a handler a later item overrides are not evaluated.
      EWith(items, body) -> {
        b = bs()
        entries = Layer.with_entries(program, b.table, b.sigs, items)
        args_row = items.enumerate().fold(EMPTY_ROW, |acc, (i, item)| {
          initialized = Layer.item_evaluated(program, entries, items, i)
          item_args(item).fold(acc, |a, arg| {
            r = expr_row(arg)
            if initialized { union(a, r) } else { a }
          })
        })
        with_body = union(args_row, expr_row(body))
        inits = entries.fold(with_body, |acc, entry| {
          Layer.entry_handler(entry).map(|h| union(acc, handler_init_fails(h))).or(acc)
        })
        # Opening a handler member fails as its init may.
        bs().with_members.get(expr).or([]).fold(inits, |acc, (_, f)| union(acc, f.fails))
      }
      # The body's E is enclosed in the lambda type's E; it surfaces when the lambda is called.
      ELambda(_, body) -> {
        body_row = expr_row(body)
        when_some(
          bs().lambda_rows.get(expr),
          |(v, _)| add_subset(body_row, var_row(v), Infer.Lambda),
        )
        EMPTY_ROW
      }
    }
  }
  bupd(|b| BodyState(expr_rows: b.expr_rows.insert(expr, row), ..b))
  row
}

fn arms_row(arms: List[Arm]) -> Row {
  arms.fold(EMPTY_ROW, |acc, arm| {
    union(union(acc, arm.guard.map(expr_row).or(EMPTY_ROW)), expr_row(arm.body))
  })
}

## `escape` removes from the inner expression's E the errors whose values the arms fully catch
## (spec 7.3). The first arm `_` without a guard catches everything that reaches it.
fn escape_row(inner: Int, arms: List[Arm]) -> Row {
  program = prog()
  inner_row = expr_row(inner)
  pat_kind = |arm: Arm| program.pats.get(arm.pat).map(|p| p.kind)
  wildcard = arms.enumerate().find(|(_, arm)| {
    wild = pat_kind(arm) match {
      Some(PWild) -> True
      _           -> False
    }
    arm.guard.is_none() && wild
  }).map(|(i, _)| i)
  reachable = wildcard.map(|i| arms.take(i)).or(arms)
  caught = reachable.filter_map(|arm| {
    pat_kind(arm) match {
      Some(PCtor(ResDef(def), _, _)) if def_of(program, def).kind == ErrorKind -> Some(
        (arm.pat, def),
      )
      _ -> None
    }
  })
  tags = escaped_tags(reachable, caught)
  # An arm that is a variable or a guarded `_` (E0320) counts as catching everything, so errors
  # do not cascade.
  broken = arms.any(|arm| {
    pat_kind(arm) match {
      Some(PCtor(_, _, _)) -> False
      Some(PMissing)       -> False
      Some(PWild)          -> arm.guard.is_some()
      _                    -> True
    }
  })
  kept = if broken || wildcard.is_some() { EMPTY_ROW } else { inner_row }
  minus = tags.map(|t| RTag(Tag(t, [])))
  row = resolve_row(kept).elems.fold(EMPTY_ROW, |acc, e| {
    e match {
      RTag(t) if tags.any(|d| d == t.def) -> acc
      # A set variable is replaced with one whose solution excludes the caught tags.
      RVar(v) if !tags.is_empty() -> {
        d = new_row_var()
        bupd(|b| BodyState(row_diffs: b.row_diffs.append([(d, v, minus)]), ..b))
        insert(acc, RVar(d))
      }
      _                                   -> insert(acc, e)
    }
  })
  info = EscapeInfo(inner, caught, wildcard.and_then(|i| arms.get(i)).map(|arm| arm.pat))
  bupd(|b| BodyState(escapes: [info, ..b.escapes], ..b))
  union(row, arms_row(arms))
}

## The errors whose values the arms fully catch: per error, the arms catching it leave no value
## missing.
fn escaped_tags(arms: List[Arm], caught: List[(Int, Int)]) -> List[Int] {
  b = bs()
  shapes = Coverage.Shapes(b.program, b.table, b.sigs)
  caught.fold([], |tags, (_, def)| {
    if tags.any(|t| t == def) {
      tags
    } else {
      self_ty(b.table, def) match {
        Some(ty) -> {
          group = arms.filter(|arm| caught.any(|(p, d)| p == arm.pat && d == def))
          if Coverage.check_arms(shapes, ty, group).missing { tags } else { tags.append([def]) }
        }
        None -> tags
      }
    }
  })
}

## The E of a local fn's body is enclosed in its type's E (`[fn.local]`).
fn local_fn_errors(local: Int) -> () {
  when_some(bs().local_fns.get(local), |info| {
    add_subset(expr_row(info.body), info.fails, Infer.LocalFnBody(local))
  })
}

## The callee function type's E. An error type parameter instantiated with a type that is not an
## error is E0319, at the call.
fn callee_fails(callee: Int, span: Span) -> Row {
  ty = bs().expr_tys.get(callee).or(TyError)
  shallow_resolve(ty) match {
    TyFn(f) -> f.fails.elems.fold(EMPTY_ROW, |row, e| {
      e match {
        ROf(t) -> {
          resolved = resolve(t)
          if is_error_ty(resolved) {
            insert(row, e)
          } else {
            diag(span, "E0319", "expected an error value")
            row
          }
        }
        _ -> insert(row, e)
      }
    })
    _ -> EMPTY_ROW
  }
}

## Whether the type can be an error type: a named error type, a type parameter or an undetermined
## type variable. Never and broken types add nothing, so errors do not cascade.
fn is_error_ty(ty: Ty) -> Bool {
  ty match {
    TyNamed(con, _) -> error_tag(con).is_some()
    TyBound(_)      -> True
    TyVar(_)        -> True
    TyNever         -> True
    TyError         -> True
    _               -> False
  }
}

# ---------------------------------------------------------------------------------------------
# Solving

## A lower bound of a set variable: the elements of `elem` minus those in `minus`. `widen`: a tag
## in `minus` also removes the capabilities of its effect. `to_effect`: a capability `minus`
## removes is replaced with its effect instead.
type Lower(elem: RowElem, minus: List[RowElem], widen: Bool, to_effect: Bool)

## Solves the inclusion constraints and reports those the solution does not satisfy. Later
## `resolve` calls use the solution.
pub fn solve() -> () uses { State[BodyState], State[Infer], State[TyLower] } {
  set_solving(True)
  solve_rounds()
  set_solving(False)
  check_subsets(subsets())
}

## Placing the solved sets of the group's definitions at their references adds constraints, so
## solving repeats until no new constraint appears.
fn solve_rounds() -> () {
  count = subsets().length()
  solve_round()
  place_instance_sets()
  if subsets().length() != count {
    solve_rounds()
  }
}

fn place_instance_sets() -> () {
  bs().instance_sets.each(|set| {
    placed = substitute_row(resolve_row(set.inferred), set.args, set.rows)
    add_subset_of(set.kind, placed, var_row(set.instance), Infer.Instance)
  })
}

fn push_lower(lowers: Map[Int, List[Lower]], v: Int, lower: Lower) -> Map[Int, List[Lower]] {
  lowers.insert(v, lowers.get(v).or([]).append([lower]))
}

## Computes the least solution of the constraints collected so far.
fn solve_round() -> () {
  clear_row_solution()
  b = bs()
  from_diffs = b.row_diffs.fold(Map.empty(), |acc, (d, v, minus)| {
    push_lower(acc, d, Lower(RVar(v), minus, False, False))
  })
  from_widens = b.row_widens.fold(from_diffs, |acc, (d, v, minus)| {
    push_lower(acc, d, Lower(RVar(v), minus, False, True))
  })
  (lowers, upper) = subsets().fold((from_widens, []), |(acc, up), c| {
    sub = resolve_row(c.sub)
    sup = resolve_row(c.sup)
    row_vars(sup).head() match {
      Some(v) -> {
        minus = sup.elems.filter(|e| effect_tag(e).is_some())
        next = sub.elems.fold(acc, |a, e| {
          if contains_elem(sup, e) { a } else { push_lower(a, v, Lower(e, minus, True, False)) }
        })
        (next, up)
      }
      None -> (acc, up.append(row_vars(sub)))
    }
  })
  # Set variables in negative positions without bounds are generalized.
  negative = b.pending.fold([], |acc, p| negative_row_vars(p.ty, True, acc))
  start = negative.fold(Map.empty(), |acc, v| {
    if lowers.contains(v) || upper.any(|w| w == v) { acc } else { acc.insert(v, var_row(v)) }
  })
  set_row_solution(widen_lowers(lowers, start))
}

## Widens the union of lower bounds until nothing changes.
fn widen_lowers(lowers: Map[Int, List[Lower]], solution: Map[Int, Row]) -> Map[Int, Row] {
  (next, changed) = lowers.fold((solution, False), |(sol, changed), v, entries| {
    entries.fold((sol, changed), |(s, ch), lower| {
      atoms = lower.elem match {
        RVar(w) -> s.get(w).or(EMPTY_ROW)
        e       -> resolve_row(row_of([e]))
      }
      atoms.elems.fold((s, ch), |(s2, ch2), a| {
        added = if removed(a, lower.minus, lower.widen) {
          a match {
            RCap(c) if lower.to_effect -> Some(RTag(c.tag))
            _                          -> None
          }
        } else {
          Some(a)
        }
        added match {
          Some(x) -> {
            target = s2.get(v).or(EMPTY_ROW)
            if target.elems.any(|y| y == x) {
              (s2, ch2)
            } else {
              (s2.insert(v, insert(target, x)), True)
            }
          }
          None -> (s2, ch2)
        }
      })
    })
  })
  if changed { widen_lowers(lowers, next) } else { next }
}

## Tags are matched with their type arguments, unifying undetermined ones. A capability is
## contained in a set that has it or its effect.
fn contains_elem(row: Row, e: RowElem) -> Bool {
  e match {
    RTag(t) -> row_has_tag(row, t)
    RCap(c) -> row.elems.any(|x| x == e) || row_has_tag(row, c.tag)
    _       -> row.elems.any(|x| x == e)
  }
}

## Whether `minus` removes the element `a` of a lower bound.
fn removed(a: RowElem, minus: List[RowElem], widen: Bool) -> Bool {
  a match {
    RTag(t) -> minus.any(|m| {
      m match {
        RTag(x) -> same_tag(x, t)
        _       -> False
      }
    })
    RCap(c) -> minus.any(|m| {
      m match {
        RCap(x) -> x.local == c.local
        RTag(x) -> widen && same_tag(x, c.tag)
        _       -> False
      }
    })
    _ -> False
  }
}

## Set variables in negative positions (the E and R of function-typed parameters). Inside type
## arguments of named types, both positions count.
fn negative_row_vars(ty: Ty, positive: Bool, out: List[Int]) -> List[Int] {
  add = |acc: List[Int], vs: List[Int]| {
    vs.fold(acc, |a, v| if a.any(|w| w == v) { a } else { a.append([v]) })
  }
  shallow_resolve(ty) match {
    TyFn(f) -> {
      here = if positive { out } else { add(out, row_vars(f.fails).append(row_vars(f.uses))) }
      params = f.params.fold(here, |acc, p| negative_row_vars(p, !positive, acc))
      negative_row_vars(f.ret, positive, params)
    }
    TyNamed(_, args) -> args.fold(out, |acc, a| {
      negative_row_vars(a, True, negative_row_vars(a, False, acc))
    })
    TySet(_, row) if !positive -> add(out, row_vars(row))
    TyList(elem)               -> negative_row_vars(elem, positive, out)
    TyTuple(elems)             -> elems.fold(out, |acc, e| negative_row_vars(e, positive, acc))
    _                          -> out
  }
}

# ---------------------------------------------------------------------------------------------
# Checking

## Reports the constraints the solution does not satisfy.
fn check_subsets(all: List[Subset]) -> () {
  all.each(|c| {
    sub = resolve_row(c.sub)
    sup = resolve_row(c.sup)
    missing0 = sub.elems.filter(|e| !contains_elem(sup, e))
    # A capability cannot be written in `uses`, so a missing one is reported as its effect.
    missing = if c.kind == Effects { widened_row(row_of(missing0)).elems } else { missing0 }
    if !missing.is_empty() && c.kind == Effects {
      c.origin match {
        Infer.Body(def)         -> report_unhandled_effects(def, missing)
        Infer.Closed(def)       -> report_unhandled_effects(def, missing)
        Infer.LayerArg(_, _, a) -> push_unhandled_effects(a, missing)
        Infer.MemberInit(h)     -> report_unhandled_member_init(h, missing)
        Infer.Coerce(span, _)   -> when_some(span, |s| diag(s, "E0403", "effect set mismatch"))
        Infer.LocalFnBody(local) -> when_some(bs().local_fns.get(local), |info| {
          if info.uses_written {
            push_unhandled_effects(info.body, missing)
          }
        })
        _                       -> ()
      }
    }
    if !missing.is_empty() && c.kind == Errors {
      c.origin match {
        Infer.Body(def)           -> report_unhandled(def, missing)
        Infer.HandlerOp(h, index) -> report_unhandled_op(h, index, missing)
        Infer.Release(h)          -> report_release_fails(h, missing)
        Infer.MemberInit(h)       -> report_unhandled_member_init(h, missing)
        Infer.LayerArg(_, _, arg) -> push_unhandled(arg, missing, "E0318")
        Infer.Coerce(span, _)     -> when_some(span, |s| diag(s, "E0321", "error set mismatch"))
        Infer.LocalFnBody(local)  -> report_local_fn_errors(local, missing)
        _                         -> ()
      }
    }
  })
  check_unraised()
}

fn report_unhandled(def: Int, missing: List[RowElem]) -> () {
  program = prog()
  body = program.items.get(def) match {
    Some(IConst(c)) -> Some(c.value)
    _               -> fn_parts(program, def).and_then(|(_, b)| b)
  }
  when_some(body, |b| push_unhandled(b, missing, "E0318"))
}

fn report_unhandled_op(hdl: Int, index: Int, missing: List[RowElem]) -> () {
  prog().items.get(hdl) match {
    Some(IHandler(item)) -> when_some(
      item.ops.get(index).and_then(|op| op.body),
      |b| push_unhandled(b, missing, "E0318"),
    )
    _ -> ()
  }
}

fn report_unhandled_member_init(hdl: Int, missing: List[RowElem]) -> () {
  prog().items.get(hdl) match {
    Some(IHandler(item)) -> when_some(item.init, |b| push_unhandled(b, missing, "E0318"))
    _                    -> ()
  }
}

## E0420 (spec 8.4).
fn report_release_fails(hdl: Int, missing: List[RowElem]) -> () {
  prog().items.get(hdl) match {
    Some(IHandler(item)) -> when_some(item.release, |(_, b)| push_unhandled(b, missing, "E0420"))
    _                    -> ()
  }
}

fn report_local_fn_errors(local: Int, missing: List[RowElem]) -> () {
  when_some(bs().local_fns.get(local), |info| {
    if info.fails_declared {
      push_unhandled(info.body, missing, "E0318")
    }
  })
}

## Reports `missing` of `body`, one diagnostic per expression that raised some of them.
fn push_unhandled(body: Int, missing: List[RowElem], code: String) -> () {
  report_origins(resolved_rows(bs().expr_rows), body, missing, code)
}

## E0402 for the effects `missing` of a definition's body.
fn report_unhandled_effects(def: Int, missing: List[RowElem]) -> () {
  program = prog()
  body = program.items.get(def) match {
    Some(IConst(c)) -> Some(c.value)
    _               -> fn_parts(program, def).and_then(|(_, b)| b)
  }
  when_some(body, |b| push_unhandled_effects(b, missing))
}

fn push_unhandled_effects(body: Int, missing: List[RowElem]) -> () {
  report_origins(resolved_rows(bs().expr_effects), body, missing, "E0402")
}

## One diagnostic per expression that raised some of `missing`.
fn report_origins(rows: Map[Int, Row], body: Int, missing: List[RowElem], code: String) -> () {
  origins = missing.fold([], |acc, e| {
    o = origin_of(rows, body, e)
    if acc.any(|x| x == o) { acc } else { acc.append([o]) }
  })
  origins.each(|o| diag(expr_span(o), code, "unhandled errors"))
}

fn resolved_rows(table: Map[Int, Row]) -> Map[Int, Row] {
  table.fold(Map.empty(), |acc, expr, row| acc.insert(expr, resolve_row(row)))
}

## The expression that raised `elem`: follows the first sub-expression in source order whose E
## contains it, down to one that cannot be followed (`fail` or a call).
fn origin_of(rows: Map[Int, Row], expr: Int, elem: RowElem) -> Int {
  next = sub_exprs(expr).find(|e| rows.get(e).map(|r| r.elems.any(|x| x == elem)).or(False))
  next match {
    Some(n) -> origin_of(rows, n, elem)
    None    -> expr
  }
}

## Sub-expressions whose E flows into this one, in source order. Lambda and local fn bodies are
## excluded.
fn sub_exprs(expr: Int) -> List[Int] {
  program = prog()
  program.exprs.get(expr).map(|e| e.kind) match {
    None -> []
    Some(kind) -> kind match {
      EInterpolated(parts) -> parts.filter_map(|p| {
        p match {
          SInterp(x) -> Some(x)
          _          -> None
        }
      })
      EField(base, _)    -> [base]
      ECall(callee, args) -> [callee, ..args.map(|a| a.value)]
      EUnary(_, operand) -> [operand]
      EBinary(_, lhs, rhs) -> [lhs, rhs]
      ETuple(elems)      -> elems
      EList(elems, rest) -> elems.append(rest.map(|r| [r]).or([]))
      EBlock(block) -> block.stmts.filter_map(|stmt| {
        stmt match {
          SLet(_, _, value) -> Some(value)
          SLocalFn(_)       -> None
          SExpr(x)          -> Some(x)
        }
      }).append(block.tail.map(|t| [t]).or([]))
      EIf(c, t, el)      -> [c, t].append(el.map(|x| [x]).or([]))
      EMatch(inner, arms) -> [inner].append(arm_exprs(arms))
      EEscape(inner, arms) -> [inner].append(arm_exprs(arms))
      EFail(x)           -> [x]
      EAssert(x)         -> [x]
      EUpdate(ctor, fields, base) -> [ctor].append(fields.map(|f| f.value)).append([base])
      EWith(items, body) -> Layer.evaluated_args(program, bs().table, bs().sigs, items).append(
        [body],
      )
      _                  -> []
    }
  }
}

fn arm_exprs(arms: List[Arm]) -> List[Int] {
  arms.flat_map(|arm| arm.guard.map(|g| [g]).or([]).append([arm.body]))
}

## W0302: an `escape` arm catches an error the inner expression cannot raise, or an arm `_` is on
## an inner expression whose E is empty. Not when the inner E has a set of unknown contents.
fn check_unraised() -> () {
  bs().escapes.reverse().each(|esc| {
    when_some(bs().expr_rows.get(esc.inner), |row0| {
      row = resolve_row(row0)
      known = row.elems.all(|e| {
        e match {
          RTag(_) -> True
          _       -> False
        }
      })
      if known {
        when_some(esc.wildcard, |pat| {
          if row.elems.is_empty() {
            Tylower.report_warning(Some(pat_span(pat)), "W0302", "no error is raised here")
          }
        })
        esc.caught.each(|(pat, tag)| {
          if !row.elems.any(|e| e == RTag(Tag(tag, []))) {
            Tylower.report_warning(Some(pat_span(pat)), "W0302", "this error is never raised here")
          }
        })
      }
    })
  })
}

# ---------------------------------------------------------------------------------------------
# Computing R (`body/effects.rs`)
#
# - The R of `use X` is `{X}`; a call adds the callee's R; a capability operation's R is its
#   effect, or the capability itself for a captured variable or a parameter.
# - `with` removes the effects it provides and adds its handlers' dependencies.
# - A capability is removed where its root `with` ends; at the end of the body that binds the
#   variable it is removed if bound to `use E`, and replaced with its effect otherwise.
# - A body's R is contained in the declared R; the R of `main`, tests and `@export` fns is empty
#   apart from the host effects the entry provides.

## Computes the R of the group's bodies and adds that they are contained in the declared R.
pub fn infer_effects() -> () uses { State[BodyState], State[Infer], State[TyLower] } {
  program = prog()
  bs().defs.each(|def| {
    bupd(|b| BodyState(current: Some(def), binder: None, ..b))
    program.items.get(def) match {
      # The arguments of a layer's items cannot have effects (`[effect.layer]`).
      Some(ILayer(item)) -> item.members.enumerate().each(|(member, m)| {
        m.args.map(|a| a.args).or([]).each(|arg| {
          add_subset_of(
            Effects,
            expr_effects(arg.value),
            EMPTY_ROW,
            Infer.LayerArg(def, member, arg.value),
          )
        })
      })
      # A const's value cannot have effects (spec 5.6).
      Some(IConst(c)) -> add_subset_of(Effects, expr_effects(c.value), EMPTY_ROW, Infer.Body(def))
      Some(IHandler(item)) -> handler_effects(def, item)
      _ -> fn_parts(program, def).and_then(|(_, body)| body) match {
        Some(body) -> def_ty(def).map(shallow_resolve) match {
          Some(TyFn(f)) -> {
            row = end_binder(expr_effects(body), def, None)
            closed = bs().closed.get(def)
            when_some(closed, |c| {
              add_subset_of(Effects, row, provided_hosts(program, c), Infer.Closed(def))
            })
            # When `main` or a test has a `uses` clause, only report that it is not empty.
            written_uses = program.items.get(def) match {
              Some(IFn(fi))      -> fi.sig.uses.is_some()
              Some(ITraitFn(fi)) -> fi.sig.uses.is_some()
              _                  -> False
            }
            if closed.is_none() || !written_uses {
              add_subset_of(Effects, row, f.uses, Infer.Body(def))
            }
          }
          _ -> ()
        }
        None -> ()
      }
    }
  })
}

## The host effects the entry provides to a closed definition.
fn provided_hosts(program: Program, c: Closed) -> Row {
  prelude = |name: String| prelude_def(program, name).map(|d| [RTag(Tag(d, []))]).or([])
  c match {
    ClosedMain       -> row_of(prelude("Async").append(prelude("ProcessHost")))
    ClosedExport(hs) -> row_of(prelude("Async").append(hs.map(|d| RTag(Tag(d, [])))))
  }
}

## A handler's dependencies are the union of the R of init, release and the operation bodies. A
## suspend fn implementation that may call resume later requires Async (spec 8.7). The
## requirements of inner handlers are the outer handler's.
fn handler_effects(def: Int, item: Hir.HandlerItem) -> () {
  program = prog()
  deps = handler_deps(def)
  bs().handler_bodies.filter(|hb| hb.owner == def).each(|hb| {
    row = end_binder(expr_effects(hb.body), def, None)
    async_def = if hb.resume_later { prelude_def(program, "Async") } else { None }
    with_async = async_def.map(|a| insert(row, RTag(Tag(a, [])))).or(row)
    add_subset_of(Effects, with_async, deps, Infer.HandlerOp(def, hb.index))
  })
  bs().handler_parts.filter(|p| p.owner == def).each(|p| {
    row = end_binder(expr_effects(p.body), def, None)
    add_subset_of(Effects, row, deps, Infer.HandlerPart)
  })
  item.inner.each(|inner| add_subset_of(Effects, handler_deps(inner), deps, Infer.HandlerPart))
}

## A handler's dependencies: computed in an earlier group, or a set variable within this group.
fn handler_deps(hdl: Int) -> Row {
  b = bs()
  b.facts.uses.get(hdl) match {
    Some(row) -> row
    None -> b.pending_handlers.find(|(h, _, _)| h == hdl).map(|(_, v, _)| var_row(v)).or(EMPTY_ROW)
  }
}

## Sub-expressions' R flows into the parent (spec 9.4). Records each expression's R.
fn expr_effects(expr: Int) -> Row {
  program = prog()
  kind = program.exprs.get(expr).map(|e| e.kind)
  row = kind match {
    None                     -> EMPTY_ROW
    # `use` of a host effect is E0414 and adds nothing.
    Some(EUse(ResDef(eff), _)) if Signature.is_host_effect(program, eff) -> EMPTY_ROW
    Some(EUse(_, _)) -> bs().expr_tys.get(expr) match {
      Some(TyCap(tags)) -> row_of(tags.map(RTag))
      _                 -> EMPTY_ROW
    }
    # The body's R is enclosed in the lambda type's R.
    Some(ELambda(_, body)) -> {
      outer = bs().binder
      set_binder(Some(expr))
      inner = expr_effects(body)
      set_binder(outer)
      body_row = end_binder_here(inner, Some(expr))
      when_some(bs().lambda_rows.get(expr), |(_, v)| {
        add_subset_of(Effects, body_row, var_row(v), Infer.Lambda)
      })
      EMPTY_ROW
    }
    Some(EBlock(block)) -> {
      block.stmts.each(|stmt| {
        stmt match {
          # The R of a local fn's body is enclosed in its type's R, as for a lambda.
          SLocalFn(f) -> when_some(bs().local_fns.get(f.local), |info| {
            outer = bs().binder
            set_binder(Some(info.body))
            inner = expr_effects(info.body)
            set_binder(outer)
            body_row = end_binder_here(inner, Some(info.body))
            add_subset_of(Effects, body_row, info.uses, Infer.LocalFnBody(f.local))
          })
          SLet(pat, _, value) -> note_use_binding(pat, value)
          _                   -> ()
        }
      })
      sub_effects(expr)
    }
    Some(EWith(items, body)) -> with_effects(expr, items, body)
    Some(ECall(callee, _)) -> {
      row = sub_effects(expr)
      # The arguments of `x |> f(a)` are recorded on the pipe expression.
      call = bs().piped_calls.get(expr).or(expr)
      union(row, replace_params(call, callee, callee_uses(callee)))
    }
    # `x |> f(a)` is `f(x, a)`. If the right side is a call, that call adds the callee's R.
    Some(EBinary(OpPipe, _, rhs)) -> {
      rhs_call = program.exprs.get(rhs).map(|r| r.kind) match {
        Some(ECall(_, _)) -> True
        _                 -> False
      }
      if rhs_call {
        bupd(|b| BodyState(piped_calls: b.piped_calls.insert(rhs, expr), ..b))
      }
      row = sub_effects(expr)
      if rhs_call { row } else { union(row, replace_params(expr, rhs, callee_uses(rhs))) }
    }
    _                        -> sub_effects(expr)
  }
  bupd(|b| BodyState(expr_effects: b.expr_effects.insert(expr, row), ..b))
  row
}

fn set_binder(binder: Option[Int]) -> () {
  bupd(|b| BodyState(binder:, ..b))
}

## A variable bound to `use E`: its capability is removed where the `with` providing E ends.
fn note_use_binding(pat: Int, value: Int) -> () {
  program = prog()
  local = program.pats.get(pat).map(|p| p.kind) match {
    Some(PBind(l)) -> Some(l)
    _              -> None
  }
  is_use = program.exprs.get(value).map(|e| e.kind) match {
    Some(EUse(_, _)) -> True
    _                -> False
  }
  tag = if is_use {
    bs().expr_tys.get(value) match {
      Some(TyCap(tags)) -> tags.head()
      _                 -> None
    }
  } else {
    None
  }
  (local, tag) match {
    (Some(l), Some(t)) -> {
      bupd(|b| BodyState(use_bound: b.use_bound.insert(l, True), ..b))
      when_some(innermost_with(t), |w| {
        bupd(|b| BodyState(cap_roots: b.cap_roots.insert(l, w), ..b))
      })
    }
    _ -> ()
  }
}

fn sub_effects(expr: Int) -> Row {
  sub_exprs(expr).fold(EMPTY_ROW, |row, e| union(row, expr_effects(e)))
}

fn callee_uses(callee: Int) -> Row {
  shallow_resolve(bs().expr_tys.get(callee).or(TyError)) match {
    TyFn(f) -> f.uses
    _       -> EMPTY_ROW
  }
}

## `uses`, the R of the callee of `call`, with each capability element that is a parameter of the
## callee replaced by what the argument is: the capability of the argument variable when it is
## itself an element, the effect otherwise. A capability of another definition's variable that is
## not a parameter of the callee is replaced with its effect.
fn replace_params(call: Int, callee: Int, uses0: Row) -> Row {
  program = prog()
  uses = resolve_row(uses0)
  has_cap = uses.elems.any(|e| {
    e match {
      RCap(_) -> True
      _       -> False
    }
  })
  if !has_cap {
    uses
  } else {
    b = bs()
    callee_def = program.exprs.get(callee).map(|e| e.kind) match {
      Some(EPath(ResDef(d))) -> Some(d)
      Some(EField(_, _))     -> b.methods.get(callee)
      _                      -> None
    }
    params = callee_def.and_then(|d| fn_parts(program, d)).map(|(ps, _)| ps.map(|p| p.local)).or([])
    args = b.calls.get(call).or([])
    uses.elems.fold(EMPTY_ROW, |out, e| {
      e match {
        RCap(c) -> {
          position = params.enumerate().find(|(_, p)| p == c.local).map(|(i, _)| i)
          position match {
            Some(i) -> {
              arg = args.get(i).and_then(|a| a)
              arg.and_then(named_capability) match {
                Some(local) -> insert(out, RCap(CapElem(local, local_name(local), c.tag)))
                None        -> insert(out, RTag(c.tag))
              }
            }
            None -> if b.local_owner.get(c.local) == b.current {
              insert(out, e)
            } else {
              insert(out, RTag(c.tag))
            }
          }
        }
        _ -> insert(out, e)
      }
    })
  }
}

fn local_name(local: Int) -> String {
  prog().locals.get(local).map(|l| l.name).or("")
}

## The R of `with H1, ..., Hn { body }` (spec 8.3, 8.5, 9.4).
fn with_effects(expr: Int, items: List[WithItem], body: Int) -> Row {
  program = prog()
  arg_rows = items.map(|item| item_args(item).map(expr_effects))
  entries = Layer.with_entries(program, bs().table, bs().sigs, items)
  provided = entries.filter(|e| e.named).map(|e| e.provided)
  # A variable bound to an item is the capability of that item; it cannot leave the `with`.
  items.each(|item| {
    when_some(item.bind, |local| {
      member = Layer.is_member_item(program, item)
      bupd(|b| {
        use_bound = if member { b.use_bound } else { b.use_bound.insert(local, True) }
        BodyState(cap_roots: b.cap_roots.insert(local, expr), use_bound:, ..b)
      })
    })
  })
  bupd(|b| BodyState(with_stack: [(expr, provided), ..b.with_stack], ..b))
  body_row = expr_effects(body)
  bupd(|b| BodyState(with_stack: b.with_stack.drop(1), ..b))
  deps = entries.map(|e| {
    e.supplier match {
      Layer.SHandler(h) -> handler_deps(h)
      Layer.SEffect(t)  -> row_of([RTag(t)])
    }
  })
  # A provider of an effect also provides its labels declared `default`, unless the same `with`
  # gives them a provider. They are removed from the body's R only.
  defaults = entries.filter(|e| e.named).fold([], |acc, e| {
    sigs = bs().sigs
    labels = sigs.default_labels.get(e.provided.def).or([]).filter(
      |l| Signature.label_base(sigs, l) == Some(e.provided),
    )
    labels.fold(acc, |a, label| {
      tag = Tag(label, [])
      if provided.any(|p| p == tag) || a.any(|t| t == tag) { a } else { a.append([tag]) }
    })
  })
  subtracted = subtract(body_row, provided.append(defaults))
  # The capabilities whose root is this `with`.
  roots = bs().cap_roots.fold([], |acc, local, w| {
    if w == expr { acc.append(cap_elems(local)) } else { acc }
  })
  row = if roots.is_empty() { subtracted } else { subtract_elems(subtracted, roots) }
  # Handler dependencies may be met by handlers in the same `with` providing other effects (spec
  # 14.2); a handler's own effects are met from outside.
  with_deps = entries.zip(deps).fold(row, |acc, (entry, dep)| {
    others = provided.filter(|p| !entry.own.any(|o| o == p))
    union(acc, subtract(dep, others))
  })
  # An item that opens a handler member requires the effect that declares it, or the capability
  # it is opened through; a provider of that effect in the same `with` meets it.
  with_members = bs().with_members.get(expr).or([]).fold(with_deps, |acc, (_, f)| {
    union(acc, subtract(f.uses, provided))
  })
  items.enumerate().zip(arg_rows).fold(with_members, |acc, ((i, _), rows)| {
    if Layer.item_evaluated(program, entries, items, i) {
      rows.fold(acc, union)
    } else {
      acc
    }
  })
}

## The innermost enclosing `with` that provides `tag`.
fn innermost_with(tag: Tag) -> Option[Int] {
  bs().with_stack.find(|(_, provides)| provides.any(|p| same_tag(p, tag))).map(|(w, _)| w)
}

## The capability elements of a local holding a capability value, one per effect.
fn cap_elems(local: Int) -> List[RowElem] {
  bs().locals.get(local).map(resolve) match {
    Some(TyCap(tags)) -> tags.map(|t| RCap(CapElem(local, local_name(local), t)))
    _                 -> []
  }
}

## `row` without the capabilities of the variables bound in `binder` of `def`: their binding ends
## with that body. A variable bound to `use E` has already added E, so its capability is removed;
## another is replaced with its effect.
fn end_binder(row: Row, def: Int, binder: Option[Int]) -> Row {
  b = bs()
  locals = b.local_binder.fold([], |acc, local, bound| {
    mine = bound == binder && b.local_owner.get(local) == Some(def)
    if mine && !is_fn_param(local) { acc.append([local]) } else { acc }
  })
  used = locals.filter(|l| b.use_bound.contains(l)).flat_map(|l| cap_or_self_elems(l, def))
  others = locals.filter(|l| !b.use_bound.contains(l)).flat_map(|l| cap_or_self_elems(l, def))
  removed_row = if used.is_empty() { row } else { subtract_elems(row, used) }
  if others.is_empty() { removed_row } else { widen_elems(removed_row, others) }
}

## The capability elements of a local, or else the element of a handler's `self`, which stands
## for the capabilities in its fields.
fn cap_or_self_elems(local: Int, def: Int) -> List[RowElem] {
  elems = cap_elems(local)
  if !elems.is_empty() {
    elems
  } else {
    is_self = prog().locals.get(local).map(|l| l.kind == Hir.SelfLocal).or(False)
    if is_self { [RCap(CapElem(local, local_name(local), Tag(def, [])))] } else { [] }
  }
}

## Replaces the capabilities `caps` in `row` with their effects. Set variables are replaced with
## fresh ones whose solutions do the same.
fn widen_elems(row: Row, caps: List[RowElem]) -> Row {
  resolve_row(row).elems.fold(EMPTY_ROW, |out, e| {
    e match {
      RCap(c) if caps.any(|m| same_local(m, c.local)) -> insert(out, RTag(c.tag))
      RVar(v) -> {
        d = new_row_var()
        bupd(|b| BodyState(row_widens: b.row_widens.append([(d, v, caps)]), ..b))
        insert(out, RVar(d))
      }
      _                                               -> insert(out, e)
    }
  })
}

fn same_local(m: RowElem, local: Int) -> Bool {
  m match {
    RCap(x) -> x.local == local
    _       -> False
  }
}

fn end_binder_here(row: Row, binder: Option[Int]) -> Row {
  bs().current.map(|def| end_binder(row, def, binder)).or(row)
}

## Removes tags and capabilities from `row`: a tag only the same tag, a capability only the same
## variable.
fn subtract_elems(row: Row, minus: List[RowElem]) -> Row {
  resolve_row(row).elems.fold(EMPTY_ROW, |out, e| {
    e match {
      RTag(t) -> {
        gone = minus.any(|m| {
          m match {
            RTag(x) -> same_tag(x, t)
            _       -> False
          }
        })
        if gone { out } else { insert(out, e) }
      }
      RCap(c) -> if minus.any(|m| same_local(m, c.local)) { out } else { insert(out, e) }
      RVar(v) -> {
        d = new_row_var()
        bupd(|b| BodyState(row_diffs: b.row_diffs.append([(d, v, minus)]), ..b))
        insert(out, RVar(d))
      }
      _       -> insert(out, e)
    }
  })
}

## Removes the tags `tags` from `row`. Set variables are replaced with fresh ones whose solutions
## exclude them; nothing is removed from set type parameters.
fn subtract(row: Row, tags: List[Tag]) -> Row {
  resolve_row(row).elems.fold(EMPTY_ROW, |out, e| {
    e match {
      RTag(t) if tags.any(|p| same_tag(p, t)) -> out
      RVar(v) if !tags.is_empty() -> {
        d = new_row_var()
        minus = tags.map(RTag)
        bupd(|b| BodyState(row_diffs: b.row_diffs.append([(d, v, minus)]), ..b))
        insert(out, RVar(d))
      }
      _                                       -> insert(out, e)
    }
  })
}

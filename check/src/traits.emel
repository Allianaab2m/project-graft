## Traits and impls (spec 10.1 to 10.3): supertraits, the table of impls, the signatures of impl
## functions, and whether a type satisfies a trait. Follows `traits.rs` and `methods.rs` of the
## reference type checker.
##
## An impl is keyed by its trait and the definition of its type (`impl Pair[A: Eq]: Eq` is
## `(Eq, Pair)`). The head has only distinct type parameters (E0328), so impls never overlap.
import Std.Map.{Map}
import Std.State.{State}
import Hir.{
  Program,
  DefModule,
  SourceModule,
  BuiltinPrelude,
  TraitKind,
  TraitFnKind,
  Res,
  ResDef,
  Span,
  TPath,
  Fields,
  NoFields,
  NamedFields,
  PositionalFields,
  ImplItem,
  Item,
  IType,
  IEnum,
  IError,
  ICtor,
  ITrait,
  IImpl,
}
import Infer.{Infer, new_infer, substitute}
import Ty.{
  Ty,
  TyPrim,
  TyNever,
  TyVar,
  TyBound,
  TyFn,
  TyTuple,
  TyList,
  TyNamed,
  TySet,
  TyCap,
  TyError,
  PFloat,
  Row,
  RBound,
  TyParam,
  Scheme,
  EMPTY_ROW,
  SetParamKind,
  row_of,
  ty_param,
}
import Tylower.{
  TyTable,
  TyLower,
  TyDiag,
  con_def,
  con_of,
  def_of,
  lower,
  lw,
  new_lower,
  prelude_def,
}
import Signature.{Signature, Signatures, insert_sig, param_labels, with_traits}

## The head of an impl: `impl Pair[A: Eq, B: Eq]: Eq`. `self_ty` is the type applied to the
## impl's type parameters.
pub type ImplHead(trait_def: Int, ty_def: Int, self_ty: Ty, params: List[TyParam])

## An impl generated by `derive` (spec 10.5), and the trait's name in the `derive` clause.
pub type Derived(head: ImplHead, span: Span)

pub type Traits(
  ## Trait → its direct supertraits. The Prelude's Ord has Eq.
  supers: Map[Int, List[Int]],
  ## (trait, the definition of the type) → the impl.
  impls: Map[(Int, Int), Int],
  ## Registered impls → their heads.
  heads: Map[Int, ImplHead],
  derived: Map[(Int, Int), Derived],
)

pub fn empty_traits() -> Traits {
  Traits(Map.empty(), Map.empty(), Map.empty(), Map.empty())
}

## A type and a trait it does not satisfy (E0326): within a type, the innermost part that fails.
pub type Unsatisfied(ty: Ty, trait_def: Int) derive Eq

## Whether a type satisfies a trait, and the derived impls it went through (W0303).
pub type Satisfied(err: Option[Unsatisfied], used: List[(Int, Int)])

pub fn head_of(traits: Traits, impl_def: Int) -> Option[ImplHead] {
  traits.heads.get(impl_def)
}

pub fn supertraits(traits: Traits, trait_def: Int) -> List[Int] {
  traits.supers.get(trait_def).or([])
}

## The head of an impl of `trait_def` for the type `ty_def`, written or derived.
fn head_for(traits: Traits, trait_def: Int, ty_def: Int) -> Option[ImplHead] {
  traits.impls.get((trait_def, ty_def)) match {
    Some(i) -> head_of(traits, i)
    None    -> traits.derived.get((trait_def, ty_def)).map(|d| d.head)
  }
}

## Whether the constraint `trait_def` gives `target`: it is `target` or one of its supertraits,
## transitively.
pub fn implies(traits: Traits, trait_def: Int, target: Int) -> Bool {
  implies_from(traits, [trait_def], [], target)
}

fn implies_from(traits: Traits, stack: List[Int], seen: List[Int], target: Int) -> Bool {
  stack match {
    [] -> False
    [t, ..rest] -> if t == target {
      True
    } else if seen.any(|s| s == t) {
      implies_from(traits, rest, seen, target)
    } else {
      implies_from(traits, rest.append(supertraits(traits, t)), [t, ..seen], target)
    }
  }
}

## The definition naming a type's head, the key of impls: the type's definition, or the Prelude's
## definition of a built-in type.
pub fn head_def(program: Program, table: TyTable, ty: Ty) -> Option[Int] {
  ty match {
    TyNamed(id, _)   -> Some(con_def(table, id))
    TyPrim(Ty.PUnit) -> None
    TyPrim(p)        -> prelude_def(program, Ty.prim_name(p))
    TyList(_)        -> prelude_def(program, "List")
    _                -> None
  }
}

## Whether `ty` satisfies `trait_def`. `env` are the type parameters `TyBound(i)` stands for.
## A derived impl of `exempt` does not count as used.
pub fn satisfies(
  program: Program,
  table: TyTable,
  traits: Traits,
  ty: Ty,
  trait_def: Int,
  env: List[TyParam],
  exempt: Option[Int],
) -> Satisfied {
  refused = Satisfied(Some(Unsatisfied(ty, trait_def)), [])
  all = |tys: List[Ty], traits_of: fn(Int) -> List[Int], used: List[(Int, Int)]| {
    tys.enumerate().fold(Satisfied(None, used), |acc, (i, t)| {
      traits_of(i).fold(acc, |a, tr| {
        a.err match {
          Some(_) -> a
          None -> {
            s = satisfies(program, table, traits, t, tr, env, exempt)
            Satisfied(s.err, a.used.append(s.used))
          }
        }
      })
    })
  }
  ty match {
    TyError     -> Satisfied(None, [])
    TyNever     -> Satisfied(None, [])
    TyVar(_)    -> Satisfied(None, [])
    TySet(_, _) -> Satisfied(None, [])
    TyBound(i) -> {
      given = env.get(i).map(|p| p.traits).or([])
      if given.any(|t| implies(traits, t, trait_def)) { Satisfied(None, []) } else { refused }
    }
    # No trait is implemented for a function or a capability.
    TyFn(_)     -> refused
    TyCap(_)    -> refused
    _ -> {
      args = ty match {
        TyNamed(_, a) -> a
        TyTuple(a)    -> a
        TyList(e)     -> [e]
        _             -> []
      }
      found = head_def(program, table, ty).and_then(
        |d| head_for(traits, trait_def, d).map(|h| (d, h)),
      )
      found match {
        Some((d, h)) -> {
          used = if traits.impls.get((trait_def, d)).is_none() && exempt != Some(d) {
            [(trait_def, d)]
          } else {
            []
          }
          all(args, |i| h.params.get(i).map(|p| p.traits).or([]), used)
        }
        None -> {
          data = def_of(program, trait_def)
          builtin_trait = data.module == BuiltinPrelude
            && ["Eq", "Ord", "Show"].any(|n| n == data.name)
          builtin_ty = ty match {
            TyPrim(PFloat) -> data.name != "Ord"
            TyPrim(_)      -> True
            TyTuple(_)     -> True
            _              -> False
          }
          if builtin_trait && builtin_ty { all(args, |_| [trait_def], []) } else { refused }
        }
      }
    }
  }
}

# ---------------------------------------------------------------------------------------------
# Collecting

## The name of a derivable trait, by the module that defines it and its name (spec 10.5).
pub fn derivable(program: Program, trait_def: Int) -> Option[String] {
  data = def_of(program, trait_def)
  module = data.module match {
    BuiltinPrelude -> Some("Prelude")
    SourceModule(m) -> program.modules.get(m) match {
      Some(items) if items.is_core -> Some(String.join(items.name, "."))
      _                            -> None
    }
  }
  allowed = [
    ("Prelude", "Eq"),
    ("Prelude", "Ord"),
    ("Prelude", "Show"),
    ("Std.Dynamic", "Encode"),
    ("Std.Dynamic", "Decode"),
    ("Std.Dynamic", "ObjectKey"),
    ("Std.Shape", "Shaped"),
  ]
  module.and_then(|m| allowed.find(|(am, an)| am == m && an == data.name).map(|(_, n)| n))
}

fn tdiag(span: Option[Span], code: String, message: String) -> () uses { State[TyLower] } {
  Tylower.report(span, code, message)
}

## Collects supertraits and impls, adds the signatures of impl functions, and checks supertrait
## cycles (E0329), impl heads (E0330, E0331), impl function parameter counts (E0332) and
## supertrait impls (E0326). Also returns the derived impls used by those checks.
pub fn collect(
  program: Program,
  table: TyTable,
  sigs0: Signatures,
) -> (Traits, Signatures, List[TyDiag], List[(Int, Int)]) {
  ((result, _), lowered) = State.run(new_lower(program, table, []), || {
    State.run(new_infer(), || collect_in(program, table, sigs0))
  })
  (traits, sigs, used) = result
  (traits, sigs, lowered.diags.reverse(), used)
}

fn collect_in(
  program: Program,
  table: TyTable,
  sigs0: Signatures,
) -> (Traits, Signatures, List[(Int, Int)]) uses { State[TyLower], State[Infer] } {
  supers0 = program.defs.fold(Map.empty(), |m, def, data| {
    if data.kind != TraitKind {
      m
    } else {
      supers = program.items.get(def) match {
        Some(ITrait(t)) -> t.supertraits.filter_map(|(res, _)| {
          res match {
            ResDef(s) if def_of(program, s).kind == TraitKind -> Some(s)
            _                                                 -> None
          }
        })
        _ -> []
      }
      m.insert(def, supers)
    }
  })
  # The Prelude's traits are built in: only Ord has a supertrait.
  supers1 = (prelude_def(program, "Ord"), prelude_def(program, "Eq")) match {
    (Some(ord), Some(eq)) if supers0.get(ord).or([]).is_empty() -> supers0.insert(ord, [eq])
    _                                                           -> supers0
  }
  t0 = Traits(supers: check_cycles(program, supers1), ..empty_traits())
  impls = program.items.to_list().filter_map(|(def, item)| {
    item match {
      IImpl(i) -> Some((def, i))
      _        -> None
    }
  })
  (t1, sigs) = impls.fold(
    (t0, sigs0),
    |(t, s), (def, item)| register(program, table, t, s, def, item),
  )
  t2 = register_derives(program, table, t1)
  # Supertraits are checked once every impl is known.
  used = impls.flat_map(|(def, item)| {
    head_of(t2, def).map(|h| {
      supertraits(t2, h.trait_def).flat_map(|s| {
        r = satisfies(program, table, t2, h.self_ty, s, h.params, None)
        when_some(
          r.err,
          |e| tdiag(head_span(program, def, item), "E0326", not_implemented(program, e)),
        )
        r.used
      })
    }).or([])
  })
  (t2, sigs, used.append(check_derives(program, table, sigs, t2)))
}

fn when_some[A](o: Option[A], f: fn(A) -> ()) -> () {
  o match {
    Some(x) -> f(x)
    None    -> ()
  }
}

pub fn not_implemented(program: Program, e: Unsatisfied) -> String {
  "the trait `#{def_of(program, e.trait_def).name}` is not implemented"
}

## The type before `:`, or the whole impl.
fn head_span(program: Program, def: Int, item: ImplItem) -> Option[Span] {
  item.self_ty.and_then(|t| program.types.get(t)).and_then(|r| r.span) match {
    Some(s) -> Some(s)
    None    -> def_of(program, def).span
  }
}

## Reports each cycle of supertraits once, at the trait of the cycle defined first (E0329), and
## breaks the cycles.
fn check_cycles(program: Program, supers: Map[Int, List[Int]]) -> Map[Int, List[Int]]
  uses { State[TyLower] } {
  order = supers.keys()
  reported = order.fold([], |reported, start| {
    if reported.any(|r| r == start) {
      reported
    } else {
      cycle_through(supers, start) match {
        None -> reported
        Some(cycle) -> {
          index = |d: Int| order.find_index(|o| o == d).or(1000000000)
          first = List.range(0, cycle.length()).fold(0, |best, i| {
            if index(cycle.get(i).or(0)) < index(cycle.get(best).or(0)) { i } else { best }
          })
          rotated = cycle.drop(first).append(cycle.take(first))
          names = rotated.map(|t| def_of(program, t).name)
          tdiag(
            def_of(program, rotated.head().or(start)).span,
            "E0329",
            "supertrait cycle: #{String.join(names.append(names.take(1)), " -> ")}",
          )
          reported.append(cycle)
        }
      }
    }
  })
  reported.fold(supers, |m, t| if m.contains(t) { m.insert(t, []) } else { m })
}

## A path of supertraits from `start` back to itself, if any (`start` first, once).
fn cycle_through(supers: Map[Int, List[Int]], start: Int) -> Option[List[Int]] {
  (found, path, _) = cycle_go(supers, start, start, [start], [])
  if found { Some(path) } else { None }
}

fn cycle_go(
  supers: Map[Int, List[Int]],
  t: Int,
  start: Int,
  path: List[Int],
  seen: List[Int],
) -> (Bool, List[Int], List[Int]) {
  supers.get(t).or([]).fold((False, path, seen), |(found, p, sn), s| {
    if found {
      (found, p, sn)
    } else if s == start {
      (True, p, sn)
    } else if sn.any(|x| x == s) {
      (False, p, sn)
    } else {
      (f2, p2, sn2) = cycle_go(supers, s, start, p.append([s]), [s, ..sn])
      if f2 { (True, p2, sn2) } else { (False, p, sn2) }
    }
  })
}

fn in_core(program: Program, module: DefModule) -> Bool {
  module match {
    SourceModule(m) -> program.modules.get(m).map(|items| items.is_core).or(False)
    _               -> True
  }
}

## Registers an impl and gives its functions their signatures: the trait function's type with
## `Self` replaced by the impl's type; the impl's type parameters first, then the trait
## function's own. An orphan impl (E0331) is still registered; the second impl of a pair (E0330)
## is not.
fn register(
  program: Program,
  table: TyTable,
  traits: Traits,
  sigs: Signatures,
  def: Int,
  item: ImplItem,
) -> (Traits, Signatures) uses { State[TyLower], State[Infer] } {
  trait_res = item.trait_ref match {
    ResDef(t) if def_of(program, t).kind == TraitKind && !item.malformed_head -> Some(t)
    _                                                                         -> None
  }
  ty_res = item.self_ty.and_then(|r| program.types.get(r).map(|tr| (r, tr))) match {
    Some((r, tr)) -> tr.kind match {
      TPath(ResDef(d), _) -> Some((r, d))
      _                   -> None
    }
    None -> None
  }
  (trait_res, ty_res) match {
    (Some(trait_def), Some((self_ref, ty_def))) -> {
      param_defs = item.type_params.map(|tp| tp.def)
      self_ty = lower(param_defs, self_ref)
      if self_ty == TyError {
        (traits, sigs)
      } else {
        params = item.type_params.map(
          |tp| with_traits(program, ty_param(def_of(program, tp.def).name), tp),
        )
        span = head_span(program, def, item)
        trait_name = def_of(program, trait_def).name
        module = def_of(program, def).module
        core = [def, ty_def, trait_def].all(|d| in_core(program, def_of(program, d).module))
        if module != def_of(program, ty_def).module
          && module != def_of(program, trait_def).module
          && !core {
          tdiag(
            span,
            "E0331",
            "an impl of `#{trait_name}` must be in the module of its type or trait",
          )
        }
        if traits.impls.contains((trait_def, ty_def)) {
          tdiag(span, "E0330", "a second impl of `#{trait_name}`")
          (traits, sigs)
        } else {
          n = params.length()
          next_sigs = item.fns.fold(sigs, |s, f| {
            f.trait_fn match {
              ResDef(trait_fn) -> Signature.get(s, trait_fn) match {
                Some(sig) -> sig.scheme.ty match {
                  TyFn(fn_ty) -> {
                    if fn_ty.params.length() != f.params.length() {
                      tdiag(
                        Some(f.name.span),
                        "E0332",
                        "`#{f.name.name}` takes #{fn_ty.params.length()} parameters in `#{trait_name}`",
                      )
                    }
                    own = if sig.scheme.params.is_empty() {
                      0
                    } else {
                      sig.scheme.params.length() - 1
                    }
                    tys = [self_ty].append(List.range(0, own).map(|k| TyBound(n + k)))
                    rows = [EMPTY_ROW].append(List.range(0, own).map(|k| row_of([RBound(n + k)])))
                    ty = substitute(sig.scheme.ty, tys, rows)
                    scheme_params = params.append(sig.scheme.params.drop(1))
                    insert_sig(
                      s,
                      f.def,
                      Signature(Scheme(scheme_params, ty), param_labels(program, f.params)),
                    )
                  }
                  _ -> s
                }
                None -> s
              }
              _ -> s
            }
          })
          next = Traits(
            impls: traits.impls.insert((trait_def, ty_def), def),
            heads: traits.heads.insert(def, ImplHead(trait_def, ty_def, self_ty, params)),
            ..traits,
          )
          (next, next_sigs)
        }
      }
    }
    _ -> (traits, sigs)
  }
}

fn field_count(fields: Fields) -> Int {
  fields match {
    NoFields            -> 0
    NamedFields(fs)     -> fs.length()
    PositionalFields(t) -> t.length()
  }
}

## Why `trait_name` cannot be derived for `ty_def` whatever its fields: the code and message.
fn derive_form_error(
  program: Program,
  ty_def: Int,
  trait_name: String,
) -> Option[(String, String)] {
  item = program.items.get(ty_def)
  host = item match {
    Some(IType(t)) -> t.ctor.is_none()
    _              -> False
  }
  ty = def_of(program, ty_def).name
  if ["Encode", "Decode", "ObjectKey", "Shaped"].any(|n| n == trait_name) && host {
    Some(("E0336", "`#{trait_name}` cannot be derived for `#{ty}`, whose values are host objects"))
  } else if ["Decode", "ObjectKey"].any(|n| n == trait_name) && def_of(program, ty_def).is_opaque {
    Some(("E0336", "`#{trait_name}` cannot be derived for the opaque type `#{ty}`"))
  } else if trait_name != "ObjectKey" {
    None
  } else {
    bad = item match {
      Some(IEnum(e)) -> e.variants.any(|v| {
        program.items.get(v) match {
          Some(ICtor(c)) -> field_count(c.fields) > 0
          _              -> False
        }
      })
      Some(IType(t))  -> field_count(t.fields) != 1
      Some(IError(e)) -> field_count(e.fields) != 1
      _               -> False
    }
    if bad { Some(("E0339", "`ObjectKey` cannot be derived for `#{ty}`")) } else { None }
  }
}

## Registers the impls `derive` generates (spec 10.5): every ordinary type parameter gets the
## trait. A trait that cannot be derived is E0326; a pair that already has an impl is E0330.
fn register_derives(program: Program, table: TyTable, traits: Traits) -> Traits
  uses { State[TyLower] } {
  program.items.fold(traits, |t, ty_def, item| {
    derives = item match {
      IType(x)  -> x.derives
      IEnum(x)  -> x.derives
      IError(x) -> x.derives
      _         -> []
    }
    (Tylower.self_ty(table, ty_def), con_of(table, ty_def)) match {
      (Some(self_ty), Some(con)) -> derives.fold(t, |acc, (res, span)| {
        res match {
          ResDef(trait_def) if def_of(program, trait_def).kind == TraitKind -> {
            trait_name = def_of(program, trait_def).name
            derivable(program, trait_def) match {
              None -> {
                tdiag(Some(span), "E0326", "`#{trait_name}` cannot be derived")
                acc
              }
              Some(name) -> {
                when_some(derive_form_error(program, ty_def, name), |(code, message)| {
                  tdiag(Some(span), code, message)
                })
                params = table.cons.get(con).map(|c| c.params).or([]).map(|p| {
                  if p.kind == SetParamKind { p } else { TyParam(traits: [trait_def], ..p) }
                })
                if (
                  acc.impls.contains((trait_def, ty_def))
                    || acc.derived.contains((trait_def, ty_def))
                ) {
                  tdiag(Some(span), "E0330", "a second impl of `#{trait_name}`")
                  acc
                } else {
                  head = ImplHead(trait_def, ty_def, self_ty, params)
                  Traits(
                    derived: acc.derived.insert((trait_def, ty_def), Derived(head, span)),
                    ..acc,
                  )
                }
              }
            }
          }
          _ -> acc
        }
      })
      _ -> t
    }
  })
}

## Checks that each derived impl can be generated (E0326): the type satisfies the trait's
## supertraits, and every field's type satisfies the trait.
fn check_derives(
  program: Program,
  table: TyTable,
  sigs: Signatures,
  traits: Traits,
) -> List[(Int, Int)] uses { State[TyLower] } {
  derived = traits.derived.values().sort_by(
    |a, b| Ord.compare((a.head.ty_def, a.span.start), (b.head.ty_def, b.span.start)),
  )
  derived.flat_map(|d| {
    h = d.head
    checked = supertraits(traits, h.trait_def).map(|s| {
      satisfies(program, table, traits, h.self_ty, s, h.params, None)
    })
    supers = checked.filter_map(|r| r.err)
    form = derivable(program, h.trait_def).map(
      |name| derive_form_error(program, h.ty_def, name).is_some(),
    ).or(False)
    fields = if form { [] } else { field_tys(program, sigs, h.ty_def) }
    field_checks = fields.map(|field| {
      satisfies(program, table, traits, field, h.trait_def, h.params, Some(h.ty_def))
    })
    failures = field_checks.fold(supers, |acc, r| {
      r.err match {
        Some(e) if !acc.any(|x| x == e) -> acc.append([e])
        _                               -> acc
      }
    })
    failures.each(|e| tdiag(Some(d.span), "E0326", not_implemented(program, e)))
    checked.append(field_checks).flat_map(|r| r.used)
  })
}

## The types of the fields of every constructor of a type, with its type parameters as `TyBound`.
pub fn field_tys(program: Program, sigs: Signatures, ty_def: Int) -> List[Ty] {
  ctors = program.items.get(ty_def) match {
    Some(IType(t))  -> t.ctor.map(|c| [c]).or([])
    Some(IEnum(e))  -> e.variants
    Some(IError(_)) -> [ty_def]
    _               -> []
  }
  ctors.flat_map(|c| {
    Signature.get(sigs, c).map(|s| s.scheme.ty) match {
      Some(TyFn(f)) -> f.params
      _             -> []
    }
  })
}

## W0303 (spec 10.5): a derived impl of a type that is not `pub`, which nothing required. An
## error's Show is not reported.
pub fn unused_derives(
  program: Program,
  traits: Traits,
  used: Map[(Int, Int), Bool],
) -> List[TyDiag] {
  show = prelude_def(program, "Show")
  unused = traits.derived.to_list().filter(|(key, d)| {
    ty = def_of(program, d.head.ty_def)
    is_error = program.items.get(d.head.ty_def) match {
      Some(IError(_)) -> True
      _               -> False
    }
    error_show = Some(d.head.trait_def) == show && is_error
    source = ty.module match {
      SourceModule(_) -> True
      _               -> False
    }
    !ty.is_pub && source && !used.contains(key) && !error_show
  }).map(|(_, d)| d).sort_by(
    |a, b| Ord.compare((a.head.ty_def, a.span.start), (b.head.ty_def, b.span.start)),
  )
  unused.map(|d| {
    TyDiag(
      Some(d.span),
      "W0303",
      "`#{def_of(program, d.head.trait_def).name}` is derived for `#{def_of(program, d.head.ty_def).name}` but never used",
      True,
    )
  })
}

# ---------------------------------------------------------------------------------------------
# Method lookup (`methods.rs`)

## The traits looked up for a value of type `ty` in `module`: those visible by name there and,
## for a type parameter, the traits of its bounds and their supertraits.
pub fn candidate_traits(
  program: Program,
  traits: Traits,
  module: Int,
  ty: Ty,
  env: List[TyParam],
) -> List[Int] {
  visible = program.modules.get(module).map(|m| m.traits).or([])
  ty match {
    TyBound(i) -> add_bounds(traits, env.get(i).map(|p| p.traits).or([]), visible)
    _          -> visible
  }
}

fn add_bounds(traits: Traits, stack: List[Int], found: List[Int]) -> List[Int] {
  stack match {
    [] -> found
    _ -> {
      t = stack.last().or(0)
      rest = stack.take(stack.length() - 1)
      if found.any(|f| f == t) {
        add_bounds(traits, rest, found)
      } else {
        add_bounds(traits, rest.append(supertraits(traits, t)), found.append([t]))
      }
    }
  }
}

## The functions of a trait, in declaration order.
pub fn trait_fns(program: Program, trait_def: Int) -> List[Int] {
  program.items.get(trait_def) match {
    Some(ITrait(t)) -> t.fns
    # The traits of the Prelude have no source.
    _ -> program.defs.to_list().filter(
      |(_, d)| d.kind == TraitFnKind && d.parent == Some(trait_def),
    ).map(|(f, _)| f)
  }
}

## Whether the trait function `f` takes `self` as its first parameter.
pub fn takes_self(sigs: Signatures, f: Int) -> Bool {
  Signature.get(sigs, f).and_then(|s| s.labels.head()).map(|l| l == Some("self")).or(False)
}

## The type with its type arguments replaced by `TyError`, which satisfies every trait.
pub fn erase_args(ty: Ty) -> Ty {
  ty match {
    TyNamed(id, args) -> TyNamed(id, args.map(|_| TyError))
    TyList(_)         -> TyList(TyError)
    TyTuple(elems)    -> TyTuple(elems.map(|_| TyError))
    _                 -> ty
  }
}

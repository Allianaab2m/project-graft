## Type checking of a resolved program. Follows `check.rs` of the reference type checker: builds
## the table of named types, collects the declared signatures and the impls, then infers the
## bodies group by group, callees first.
import Std.Map.{Map}
import Std.State.{State}
import Hir.{Program}
import Body
import Bodystate.{HandlerFacts, Closed, ClosedMain, ClosedExport, Fibers}
import Cycles
import Groups
import Layer
import Capture
import Export
import Signature.{Signatures, insert_sig}
import Traits
import Tylower.{TyDiag, TyLower, TyTable, con_def, def_of, new_lower, new_table}
import Hir.{SourceModule, FnKind, IFn, IEffect, IOp, TFn, TPath, ResDef}
import Ty.{TyFn, TyPrim, TyNever, TyError, TyBound, TyVar, TyNamed}

## The diagnostics of type checking, sorted by module and start position (stable), as the
## reference reports them. Those without a location come first.
## `entry` is the entry module, if there is one; with `library_only`, it has no `main`.
pub fn check(given: Program, entry_module: Option[Int], library_only: Bool) -> List[TyDiag] {
  (program, made, entry_diags) = Export.add_entry_exports(given, entry_module)
  entry = if library_only { None } else { entry_module }
  table = new_table(program)
  (declared, sig_diags) = Signature.collect(program, table)
  (traits, sigs, trait_diags, collect_used) = Traits.collect(program, table, declared)
  groups = Groups.groups(program, sigs)
  closed = closed_defs(program, entry, made)
  fibers = fibers_of(program)
  (inferred, lowered) = State.run(new_lower(program, table, []), || {
    groups.fold(
      (
        sigs,
        collect_used.fold(Map.empty(), |m, k| m.insert(k, True)),
        HandlerFacts(Map.empty(), Map.empty()),
        Map.empty(),
        [],
      ),
      |(known, used, facts, summaries, captures), group| {
        (inferred, group_used, next_facts, types) = Body.infer_group(
          program,
          table,
          traits,
          known,
          facts,
          closed,
          fibers,
          group,
        )
        next = inferred.fold(known, |acc, (def, sig)| insert_sig(acc, def, sig))
        input = Capture.CaptureInput(
          program,
          table,
          next,
          fibers,
          types.exprs,
          types.locals,
          types.calls,
          types.ops,
          types.methods,
        )
        (next_summaries, escapes) = Capture.check_group(input, summaries, group)
        (
          next,
          group_used.fold(used, |m, k, v| m.insert(k, v)),
          next_facts,
          next_summaries,
          captures.append(escapes),
        )
      },
    )
  })
  (final_sigs, used, facts, _, captures) = inferred
  diags = sig_diags.append(trait_diags).append(Cycles.check(program)).append(
    lowered.diags.reverse(),
  ).append(Traits.unused_derives(program, traits, used)).append(
    main_value(program, table, final_sigs, entry),
  ).append(Layer.check_layers(program, sigs, facts.uses)).append(captures)
  main = entry_main(program, entry).and_then(|d| if is_test(program, d) { None } else { Some(d) })
  checked = Export.check(program, table, final_sigs, entry, main, made, diags).append(entry_diags)
  checked.sort_by(|a, b| Ord.compare(position(a), position(b)))
}

fn position(d: TyDiag) -> (Int, Int, Int) {
  d.span match {
    Some(s) -> (1, s.module, s.start)
    None    -> (0, 0, 0)
  }
}

## W0304: the entry's `main` returns a type other than `()`, `ExitCode` of `Std.Process` and Never,
## whose value would be discarded. Reported at the written return type, or at `main`.
fn main_value(
  program: Program,
  table: TyTable,
  sigs: Signatures,
  entry: Option[Int],
) -> List[TyDiag] {
  main = entry.and_then(|m| program.modules.get(m)).and_then(|items| {
    items.items.find(|d| def_of(program, d).name == "main" && def_of(program, d).kind == FnKind)
  })
  main.and_then(|def| {
    Signature.get(sigs, def).map(|s| s.scheme.ty).and_then(|ty| {
      ty match {
        TyFn(f) -> {
          ignored = f.ret match {
            TyPrim(Ty.PUnit) -> True
            TyNever          -> True
            TyError          -> True
            TyBound(_)       -> True
            TyVar(_)         -> True
            r                -> is_exit_code(program, table, r)
          }
          if ignored {
            None
          } else {
            written = program.items.get(def) match {
              Some(IFn(item)) -> item.sig.ret.and_then(|t| program.types.get(t)).and_then(
                |r| r.span,
              )
              _ -> None
            }
            span = written match {
              Some(s) -> Some(s)
              None    -> def_of(program, def).span
            }
            Some(TyDiag(span, "W0304", "the value `main` returns is discarded", True))
          }
        }
        _ -> None
      }
    })
  }).map(|d| [d]).or([])
}

## Whether `ty` is `ExitCode` of the bundled `Std.Process`.
fn is_exit_code(program: Program, table: TyTable, ty: Ty.Ty) -> Bool {
  ty match {
    TyNamed(con, args) -> {
      data = def_of(program, con_def(table, con))
      std_process = data.module match {
        SourceModule(m) -> program.modules.get(m).map(|items| items.name == ["Std", "Process"]).or(
          False,
        )
        _ -> False
      }
      args.is_empty() && data.name == "ExitCode" && std_process
    }
    _ -> False
  }
}

## The definitions whose R must be empty apart from the host effects the entry provides: the
## entry's `main` and the tests (spec 8.3, 13.3), and `@export` fns and the fns `@entry` makes
## (`[ext.export]`).
fn closed_defs(
  program: Program,
  entry: Option[Int],
  made: List[Export.EntryExport],
) -> Map[Int, Closed] {
  fns = program.items.fold([], |acc, def, item| {
    item match {
      IFn(f) -> acc.append([(def, f)])
      _      -> acc
    }
  })
  tests = fns.filter(|(def, _)| is_test(program, def)).map(|(def, _)| def)
  exports = fns.filter(|(_, f)| !f.exports.is_empty() && f.body.is_some()).fold(
    Map.empty(),
    |m, (def, _)| m.insert(def, ClosedExport(Export.adapter_hosts(program, def))),
  )
  entries = made.fold(
    exports,
    |m, e| m.insert(e.def, ClosedExport(Export.adapter_hosts(program, e.adapter))),
  )
  with_tests = tests.fold(entries, |m, def| m.insert(def, ClosedMain))
  entry_main(program, entry).and_then(|d| if tests.any(|t| t == d) { None } else { Some(d) }).map(
    |d| with_tests.insert(d, ClosedMain),
  ).or(with_tests)
}

## Whether `def` is a test of the project (not of the bundled modules).
fn is_test(program: Program, def: Int) -> Bool {
  in_project = def_of(program, def).module match {
    SourceModule(m) -> program.modules.get(m).map(|items| !items.is_core).or(False)
    _               -> False
  }
  test = program.items.get(def) match {
    Some(IFn(f)) -> f.is_test
    _            -> False
  }
  test && in_project
}

fn entry_main(program: Program, entry: Option[Int]) -> Option[Int] {
  entry.and_then(|m| program.modules.get(m)).and_then(|items| {
    items.items.find(|d| def_of(program, d).name == "main" && def_of(program, d).kind == FnKind)
  })
}

## The built-in effects' scope functions and handle types (`fiber.rs`). A built-in effect is an
## `@intrinsic effect`; its provider is the `@intrinsic` fn of the same module whose parameter's
## function type names the effect in `uses`. The named types its operations return are handles.
fn fibers_of(program: Program) -> Fibers {
  effects = program.items.fold([], |acc, def, item| {
    item match {
      IEffect(e) if e.is_intrinsic -> acc.append([(def, e)])
      _                            -> acc
    }
  })
  handles = effects.fold([], |acc, (_, e)| {
    e.ops.fold(acc, |a, op| {
      ret = program.items.get(op) match {
        Some(IOp(o)) -> o.sig.ret.and_then(|r| program.types.get(r)).map(|r| r.kind)
        _            -> None
      }
      ret match {
        Some(TPath(ResDef(t), _)) if def_of(program, t).kind == Hir.TypeKind
          && !a.any(|x| x == t) -> a.append([t])
        _ -> a
      }
    })
  })
  effect_defs = effects.map(|(d, _)| d)
  names_effect = |ty: Int| {
    program.types.get(ty).map(|r| r.kind) match {
      Some(TFn(_, _, _, Some(set))) -> set.items.fold(None, |found, u| {
        (found, u.res) match {
          (Some(_), _)                                     -> found
          (None, ResDef(d)) if effect_defs.any(|e| e == d) -> Some(d)
          _                                                -> None
        }
      })
      _ -> None
    }
  }
  provides = program.items.fold(Map.empty(), |acc, def, item| {
    item match {
      IFn(f) if f.is_intrinsic -> {
        module = def_of(program, def).module
        same = effect_defs.any(|e| def_of(program, e).module == module)
        provided = f.sig.params.filter_map(|p| p.ty).fold(None, |found, t| {
          found match {
            Some(_) -> found
            None    -> names_effect(t)
          }
        })
        provided match {
          Some(eff) if same -> acc.insert(def, eff)
          _                 -> acc
        }
      }
      _ -> acc
    }
  })
  scope_fns = provides.fold([], |acc, def, _| acc.append([def]))
  Fibers(scope_fns, handles, provides)
}

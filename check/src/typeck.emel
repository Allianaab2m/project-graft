## Type checking of a resolved program. Follows `check.rs` of the reference type checker: builds
## the table of named types, collects the declared signatures and the impls, then infers the
## bodies group by group, callees first.
import Std.Map.{Map}
import Std.State.{State}
import Hir.{Program}
import Body
import Bodystate.{HandlerFacts, Closed, ClosedMain, ClosedExport}
import Cycles
import Groups
import Signature.{Signatures, insert_sig}
import Traits
import Tylower.{TyDiag, TyLower, TyTable, con_def, def_of, new_lower, new_table}
import Hir.{SourceModule, FnKind, IFn, TFn, ResDef}
import Ty.{TyFn, TyPrim, TyNever, TyError, TyBound, TyVar, TyNamed}

## The diagnostics of type checking, sorted by module and start position (stable), as the
## reference reports them. Those without a location come first.
## `entry` is the module whose `main` is the program's entry, if there is one.
pub fn check(program: Program, entry: Option[Int]) -> List[TyDiag] {
  table = new_table(program)
  (declared, sig_diags) = Signature.collect(program, table)
  (traits, sigs, trait_diags, collect_used) = Traits.collect(program, table, declared)
  groups = Groups.groups(program, sigs)
  closed = closed_defs(program, entry)
  (inferred, lowered) = State.run(new_lower(program, table, []), || {
    groups.fold(
      (
        sigs,
        collect_used.fold(Map.empty(), |m, k| m.insert(k, True)),
        HandlerFacts(Map.empty(), Map.empty()),
      ),
      |(known, used, facts), group| {
        (inferred, group_used, next_facts) = Body.infer_group(
          program,
          table,
          traits,
          known,
          facts,
          closed,
          group,
        )
        next = inferred.fold(known, |acc, (def, sig)| insert_sig(acc, def, sig))
        (next, group_used.fold(used, |m, k, v| m.insert(k, v)), next_facts)
      },
    )
  })
  (final_sigs, used, _) = inferred
  diags = sig_diags.append(trait_diags).append(Cycles.check(program)).append(
    lowered.diags.reverse(),
  ).append(Traits.unused_derives(program, traits, used)).append(
    main_value(program, table, final_sigs, entry),
  ).append(export_fails(program, final_sigs))
  diags.sort_by(|a, b| Ord.compare(position(a), position(b)))
}

fn position(d: TyDiag) -> (Int, Int, Int) {
  d.span match {
    Some(s) -> (1, s.module, s.start)
    None    -> (0, 0, 0)
  }
}

## W0304: the entry's `main` returns a type other than `()`, `ExitCode` of `Std.Process` and Never,
## whose value would be discarded. Reported at the written return type, or at `main`.
fn main_value(
  program: Program,
  table: TyTable,
  sigs: Signatures,
  entry: Option[Int],
) -> List[TyDiag] {
  main = entry.and_then(|m| program.modules.get(m)).and_then(|items| {
    items.items.find(|d| def_of(program, d).name == "main" && def_of(program, d).kind == FnKind)
  })
  main.and_then(|def| {
    Signature.get(sigs, def).map(|s| s.scheme.ty).and_then(|ty| {
      ty match {
        TyFn(f) -> {
          ignored = f.ret match {
            TyPrim(Ty.PUnit) -> True
            TyNever          -> True
            TyError          -> True
            TyBound(_)       -> True
            TyVar(_)         -> True
            r                -> is_exit_code(program, table, r)
          }
          if ignored {
            None
          } else {
            written = program.items.get(def) match {
              Some(IFn(item)) -> item.sig.ret.and_then(|t| program.types.get(t)).and_then(
                |r| r.span,
              )
              _ -> None
            }
            span = written match {
              Some(s) -> Some(s)
              None    -> def_of(program, def).span
            }
            Some(TyDiag(span, "W0304", "the value `main` returns is discarded", True))
          }
        }
        _ -> None
      }
    })
  }).map(|d| [d]).or([])
}

## Whether `ty` is `ExitCode` of the bundled `Std.Process`.
fn is_exit_code(program: Program, table: TyTable, ty: Ty.Ty) -> Bool {
  ty match {
    TyNamed(con, args) -> {
      data = def_of(program, con_def(table, con))
      std_process = data.module match {
        SourceModule(m) -> program.modules.get(m).map(|items| items.name == ["Std", "Process"]).or(
          False,
        )
        _ -> False
      }
      args.is_empty() && data.name == "ExitCode" && std_process
    }
    _ -> False
  }
}

## The definitions whose R must be empty apart from the host effects the entry provides: the
## entry's `main` and the tests (spec 8.3, 13.3), and `@export` fns (`[ext.export]`).
fn closed_defs(program: Program, entry: Option[Int]) -> Map[Int, Closed] {
  in_project = |def: Int| {
    def_of(program, def).module match {
      SourceModule(m) -> program.modules.get(m).map(|items| !items.is_core).or(False)
      _               -> False
    }
  }
  fns = program.items.fold([], |acc, def, item| {
    item match {
      IFn(f) -> acc.append([(def, f)])
      _      -> acc
    }
  })
  tests = fns.filter(|(def, f)| f.is_test && in_project(def)).map(|(def, _)| def)
  exports = fns.filter(|(_, f)| !f.exports.is_empty() && f.body.is_some()).fold(
    Map.empty(),
    |m, (def, f)| m.insert(def, ClosedExport(adapter_hosts(program, f))),
  )
  with_tests = tests.fold(exports, |m, def| m.insert(def, ClosedMain))
  entry_main(program, entry).and_then(|d| if tests.any(|t| t == d) { None } else { Some(d) }).map(
    |d| with_tests.insert(d, ClosedMain),
  ).or(with_tests)
}

fn entry_main(program: Program, entry: Option[Int]) -> Option[Int] {
  entry.and_then(|m| program.modules.get(m)).and_then(|items| {
    items.items.find(|d| def_of(program, d).name == "main" && def_of(program, d).kind == FnKind)
  })
}

## The host effects (other than Async) that the function type of an `@export` fn's first
## parameter uses: an entry adapter gives them (`[ext.entry]`).
fn adapter_hosts(program: Program, f: Hir.FnItem) -> List[Int] {
  f.sig.params.head().and_then(|p| p.ty).and_then(|t| program.types.get(t)).map(|r| r.kind) match {
    Some(TFn(_, _, _, Some(uses))) -> uses.items.filter_map(|e| {
      e.res match {
        ResDef(d) if Signature.is_host_effect(program, d)
          && def_of(program, d).name != "Async" -> Some(d)
        _ -> None
      }
    })
    _ -> []
  }
}

## E0402: an `@export` fn whose E is not empty. A hidden set of a parameter's function type
## counts, so a callback parameter is written with `fails {}` (`export.rs`).
fn export_fails(program: Program, sigs: Signatures) -> List[TyDiag] {
  program.items.fold([], |acc, def, item| {
    item match {
      IFn(f) if !f.exports.is_empty() && f.body.is_some() -> {
        fails = Signature.get(sigs, def).map(|s| s.scheme.ty) match {
          Some(TyFn(t)) -> !t.fails.elems.is_empty()
          _             -> False
        }
        span = f.exports.head().map(|e| e.span)
        if fails {
          acc.append([TyDiag(span, "E0402", "an exported function cannot fail", False)])
        } else {
          acc
        }
      }
      _ -> acc
    }
  })
}

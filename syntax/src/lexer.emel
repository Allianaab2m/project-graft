## Splits a source into tokens, keeping trivia. Follows `[lex]` and `[grammar.lex]` of the
## specification and the token boundaries of the reference implementation (emela-syntax).
##
## The source is read as an array of code points, and token and diagnostic positions count code
## points.
import Std.Array.{Array}
import Continuation
import Source.{slice}
import Tree.{Diagnostic}
import Token.{
  Kind,
  Token,
  Whitespace,
  Newline,
  Comment,
  DocComment,
  IntLit,
  FloatLit,
  StringQuote,
  TripleQuote,
  StringText,
  InterpStart,
  InterpEnd,
  LowerName,
  TypeName,
  UpperName,
  Underscore,
  FnKw,
  TypeKw,
  EnumKw,
  ErrorKw,
  ConstKw,
  TraitKw,
  ImplKw,
  EffectKw,
  HandlerKw,
  LayerKw,
  ImportKw,
  PubKw,
  OpaqueKw,
  SuspendKw,
  IfKw,
  ElseKw,
  MatchKw,
  FailKw,
  EscapeKw,
  UseKw,
  WithKw,
  AssertKw,
  SelfKw,
  SelfTypeKw,
  AsKw,
  ReservedKw,
  LParen,
  RParen,
  LBrack,
  RBrack,
  LBrace,
  RBrace,
  Comma,
  Dot,
  Dot2,
  Colon,
  Eq,
  ThinArrow,
  Pipe,
  PipeGt,
  Plus,
  Minus,
  Star,
  Slash,
  Percent,
  Bang,
  Eq2,
  Neq,
  Lt,
  LtEq,
  Gt,
  GtEq,
  Amp2,
  Pipe2,
  At,
  ErrorToken,
}

const TAB = 0x09
const LF = 0x0A
const CR = 0x0D
const SPACE = 0x20
const BANG = 0x21
const QUOTE = 0x22
const HASH = 0x23
const PERCENT = 0x25
const AMP = 0x26
const L_PAREN = 0x28
const R_PAREN = 0x29
const STAR = 0x2A
const PLUS = 0x2B
const COMMA = 0x2C
const MINUS = 0x2D
const DOT = 0x2E
const SLASH = 0x2F
const COLON = 0x3A
const LT = 0x3C
const EQ = 0x3D
const GT = 0x3E
const AT = 0x40
const L_BRACK = 0x5B
const BACKSLASH = 0x5C
const R_BRACK = 0x5D
const UNDERSCORE = 0x5F
const L_BRACE = 0x7B
const PIPE = 0x7C
const R_BRACE = 0x7D

## What the lexer is inside. The bottom of the stack is always Code. `open` is where the string
## or interpolation starts.
enum Mode {
  Code
  Str(open: Int)
  ## A multiline string, with the start of each line of its body so far (newest first), to check
  ## their indentation when it closes.
  MultiStr(open: Int, lines: List[Int])
  ## An interpolation, with the number of `{` open inside it.
  Interp(open: Int, depth: Int)
}

## The result of one step: the token read (if any), the next position, the modes after it and
## the diagnostics.
type Step(tokens: List[Token], next: Int, modes: List[Mode], diagnostics: List[Diagnostic])

## The tokens of a source and the lexer's diagnostics, sorted by position (keeping the order they
## were found in for ties).
pub type Lexed(tokens: List[Token], diagnostics: List[Diagnostic])

pub fn lex(text: String) -> List[Token] {
  tokens(Array.from_list(text.code_points()))
}

pub fn tokens(src: Array[Int]) -> List[Token] {
  lex_all(src).tokens
}

pub fn lex_all(src: Array[Int]) -> Lexed {
  (raw, diagnostics) = run(src, 0, [Code], [], [])
  marked = Continuation.mark(src, Array.from_list(raw.reverse()))
  sorted = diagnostics.reverse().sort_by(|a, b| Ord.compare((a.start, a.end), (b.start, b.end)))
  Lexed(marked, sorted)
}

## Tokens and diagnostics newest first.
fn run(
  src: Array[Int],
  pos: Int,
  modes: List[Mode],
  acc: List[Token],
  diagnostics: List[Diagnostic],
) -> (List[Token], List[Diagnostic]) {
  if pos >= src.size() {
    (acc, unclosed(src.size(), modes, diagnostics))
  } else {
    step = modes match {
      [Str(open), ..]      -> string_step(src, pos, open, modes)
      [MultiStr(_, _), ..] -> multi_string_step(src, pos, modes)
      _                    -> code_step(src, pos, modes)
    }
    run(
      src,
      step.next,
      step.modes,
      step.tokens.reverse().append(acc),
      step.diagnostics.reverse().append(diagnostics),
    )
  }
}

## Reports what is still open at the end of the input, innermost first.
fn unclosed(end: Int, modes: List[Mode], diagnostics: List[Diagnostic]) -> List[Diagnostic] {
  modes match {
    [] -> diagnostics
    [mode, ..outer] -> {
      found = mode match {
        Str(open)         -> [Diagnostic("E0101", open, end, "unterminated string literal")]
        MultiStr(open, _) -> [Diagnostic("E0101", open, end, "unterminated string literal")]
        Interp(open, _)   -> [Diagnostic("E0102", open, end, "unterminated interpolation")]
        Code              -> []
      }
      unclosed(end, outer, found.append(diagnostics))
    }
  }
}

## The code point at `i`, or -1 past the end.
fn at(src: Array[Int], i: Int) -> Int {
  src.get(i) match {
    Some(c) -> c
    None    -> -1
  }
}

## The first position from `i` whose code point does not satisfy `f`.
fn skip_while(src: Array[Int], i: Int, f: fn(Int) -> Bool) -> Int {
  c = at(src, i)
  if c >= 0 && f(c) { skip_while(src, i + 1, f) } else { i }
}

fn one(kind: Kind, start: Int, end: Int, modes: List[Mode]) -> Step {
  Step([Token(kind, start, end)], end, modes, [])
}

fn with_diagnostics(step: Step, diagnostics: List[Diagnostic]) -> Step {
  Step(diagnostics: step.diagnostics.append(diagnostics), ..step)
}

fn pop(modes: List[Mode]) -> List[Mode] {
  modes.tail()
}

# Code

fn code_step(src: Array[Int], pos: Int, modes: List[Mode]) -> Step {
  (kind, end) = scan_code(src, pos)
  step = kind match {
    StringQuote -> one(StringQuote, pos, end, [Str(pos), ..modes])
    TripleQuote -> one(TripleQuote, pos, end, [MultiStr(pos, []), ..modes])
    LBrace -> modes match {
      [Interp(open, depth), ..rest] -> one(LBrace, pos, end, [Interp(open, depth + 1), ..rest])
      _                             -> one(LBrace, pos, end, modes)
    }
    RBrace -> modes match {
      [Interp(_, 0), ..rest]        -> one(InterpEnd, pos, end, rest)
      [Interp(open, depth), ..rest] -> one(RBrace, pos, end, [Interp(open, depth - 1), ..rest])
      _                             -> one(RBrace, pos, end, modes)
    }
    _           -> one(kind, pos, end, modes)
  }
  bad = if kind == ErrorToken { [error_token(src, pos, end)] } else { [] }
  next = at(src, end)
  opening = if kind == TripleQuote && next != LF && next != CR {
    [Diagnostic("E0109", pos, end, "expected a newline after the opening `\"\"\"`")]
  } else {
    []
  }
  with_diagnostics(step, bad.append(opening))
}

## What an ErrorToken is: a word that is no name, a malformed number, or a character the lexer
## does not know.
fn error_token(src: Array[Int], start: Int, end: Int) -> Diagnostic {
  c = at(src, start)
  text = slice(src, start, end)
  if is_word_start(c) {
    Diagnostic("E0103", start, end, "invalid name `#{text}`: not a lower, type, or upper name")
  } else if is_digit(c) {
    Diagnostic("E0104", start, end, "invalid number literal `#{text}`")
  } else {
    Diagnostic("E0105", start, end, "unrecognized character `#{text}`")
  }
}

fn scan_code(src: Array[Int], pos: Int) -> (Kind, Int) {
  c = at(src, pos)
  next = at(src, pos + 1)
  if is_blank(c) {
    (Whitespace, skip_while(src, pos + 1, is_blank))
  } else if c == LF {
    (Newline, pos + 1)
  } else if c == CR {
    if next == LF { (Newline, pos + 2) } else { (ErrorToken, pos + 1) }
  } else if c == HASH {
    kind = if next == HASH { DocComment } else { Comment }
    (kind, skip_while(src, pos + 1, |d| d != LF && d != CR))
  } else if is_word_start(c) {
    end = skip_while(src, pos + 1, is_word)
    (classify_word(slice(src, pos, end)), end)
  } else if is_digit(c) {
    scan_number(src, pos)
  } else if c == QUOTE {
    if next == QUOTE && at(src, pos + 2) == QUOTE {
      (TripleQuote, pos + 3)
    } else {
      (StringQuote, pos + 1)
    }
  } else {
    scan_punct(src, pos, c, next)
  }
}

fn scan_punct(src: Array[Int], pos: Int, c: Int, next: Int) -> (Kind, Int) {
  single = |kind| (kind, pos + 1)
  double = |kind| (kind, pos + 2)
  c match {
    L_PAREN -> single(LParen)
    R_PAREN -> single(RParen)
    L_BRACK -> single(LBrack)
    R_BRACK -> single(RBrack)
    L_BRACE -> single(LBrace)
    R_BRACE -> single(RBrace)
    COMMA   -> single(Comma)
    COLON   -> single(Colon)
    PLUS    -> single(Plus)
    STAR    -> single(Star)
    SLASH   -> single(Slash)
    PERCENT -> single(Percent)
    AT      -> single(At)
    DOT     -> if next == DOT { double(Dot2) } else { single(Dot) }
    EQ      -> if next == EQ { double(Eq2) } else { single(Eq) }
    MINUS   -> if next == GT { double(ThinArrow) } else { single(Minus) }
    BANG    -> if next == EQ { double(Neq) } else { single(Bang) }
    GT      -> if next == EQ { double(GtEq) } else { single(Gt) }
    LT      -> if next == EQ { double(LtEq) } else { single(Lt) }
    PIPE -> next match {
      GT   -> double(PipeGt)
      PIPE -> double(Pipe2)
      _    -> single(Pipe)
    }
    AMP     -> if next == AMP { double(Amp2) } else { single(ErrorToken) }
    _       -> single(ErrorToken)
  }
}

## Numbers are cut by the longest of the following matches. A well-formed literal wins a tie
## with a malformed chunk (`0xFF`, `1.0e9`).
##
## - an integer `[0-9][0-9_]*`, or `0x` / `0b` followed by its digits
## - a float `[0-9][0-9_]*.[0-9][0-9_]*`, with an optional exponent
## - a malformed chunk: a number followed directly by letters (`1e9` `3px` `0XFF`), or a hex or
##   binary fraction (`0x1.5`)
fn scan_number(src: Array[Int], pos: Int) -> (Kind, Int) {
  int_end = skip_while(src, pos + 1, is_digit_)
  first = at(src, pos)
  prefix = at(src, pos + 1)
  radix_end = if first == 0x30 && prefix == 0x78 && is_hex(at(src, pos + 2)) {
    skip_while(src, pos + 3, |c| is_hex(c) || c == UNDERSCORE)
  } else if first == 0x30 && prefix == 0x62 && is_bin(at(src, pos + 2)) {
    skip_while(src, pos + 3, |c| is_bin(c) || c == UNDERSCORE)
  } else {
    -1
  }
  fraction_end = if at(src, int_end) == DOT && is_digit(at(src, int_end + 1)) {
    skip_while(src, int_end + 2, is_digit_)
  } else {
    -1
  }
  float_end = if fraction_end < 0 { -1 } else { exponent_end(src, fraction_end) }
  # A number followed by letters, with or without a fraction.
  letters_after = |i| if i >= 0 && is_letter(at(src, i)) {
    skip_while(src, i + 1, is_word)
  } else {
    -1
  }
  bad_fraction = if first == 0x30 && (prefix == 0x78 || prefix == 0x62) {
    j = skip_while(src, pos + 2, is_word)
    if at(src, j) == DOT && is_digit(at(src, j + 1)) {
      skip_while(src, j + 2, is_word)
    } else {
      -1
    }
  } else {
    -1
  }
  good = Int.max(int_end, radix_end)
  bad = Int.max(Int.max(letters_after(int_end), letters_after(fraction_end)), bad_fraction)
  if bad > Int.max(good, float_end) {
    (ErrorToken, bad)
  } else if float_end > good {
    (FloatLit, float_end)
  } else {
    (IntLit, good)
  }
}

## The end of a float that may have an exponent after `end`. An exponent without digits is not
## part of it.
fn exponent_end(src: Array[Int], end: Int) -> Int {
  e = at(src, end)
  if e == 0x65 || e == 0x45 {
    sign = at(src, end + 1)
    digits = if sign == PLUS || sign == MINUS { end + 2 } else { end + 1 }
    if is_digit(at(src, digits)) { skip_while(src, digits + 1, is_digit_) } else { end }
  } else {
    end
  }
}

## Classifies a word cut as `[A-Za-z_][A-Za-z0-9_]*` (`[lex.name]`, `[kw]`).
fn classify_word(word: String) -> Kind {
  word match {
    "fn"      -> FnKw
    "type"    -> TypeKw
    "enum"    -> EnumKw
    "error"   -> ErrorKw
    "const"   -> ConstKw
    "trait"   -> TraitKw
    "impl"    -> ImplKw
    "effect"  -> EffectKw
    "handler" -> HandlerKw
    "layer"   -> LayerKw
    "import"  -> ImportKw
    "pub"     -> PubKw
    "opaque"  -> OpaqueKw
    "suspend" -> SuspendKw
    "if"      -> IfKw
    "else"    -> ElseKw
    "match"   -> MatchKw
    "fail"    -> FailKw
    "escape"  -> EscapeKw
    "use"     -> UseKw
    "with"    -> WithKw
    "assert"  -> AssertKw
    "self"    -> SelfKw
    "Self"    -> SelfTypeKw
    "as"      -> AsKw
    "var"     -> ReservedKw
    "return"  -> ReservedKw
    "while"   -> ReservedKw
    "loop"    -> ReservedKw
    "let"     -> ReservedKw
    "mut"     -> ReservedKw
    "in"      -> ReservedKw
    "where"   -> ReservedKw
    "do"      -> ReservedKw
    "try"     -> ReservedKw
    "catch"   -> ReservedKw
    "throw"   -> ReservedKw
    "async"   -> ReservedKw
    "yield"   -> ReservedKw
    "defer"   -> ReservedKw
    "macro"   -> ReservedKw
    "mod"     -> ReservedKw
    "_"       -> Underscore
    _         -> classify_name(word.code_points())
  }
}

fn classify_name(cs: List[Int]) -> Kind {
  cs match {
    [c, ..] if is_lower(c) || c == UNDERSCORE -> LowerName
    [c, ..] if is_upper(c) -> {
      if cs.all(|d| is_upper(d) || is_digit(d) || d == UNDERSCORE) {
        UpperName
      } else if cs.all(|d| is_letter(d) || is_digit(d)) {
        TypeName
      } else {
        ErrorToken
      }
    }
    _                                         -> ErrorToken
  }
}

# Strings

fn string_step(src: Array[Int], pos: Int, open: Int, modes: List[Mode]) -> Step {
  c = at(src, pos)
  if c == QUOTE {
    one(StringQuote, pos, pos + 1, pop(modes))
  } else if c == HASH && at(src, pos + 1) == L_BRACE {
    one(InterpStart, pos, pos + 2, [Interp(pos, 0), ..modes])
  } else if c == LF || c == CR {
    # An unterminated string. The newline is read again as code.
    Step([], pos, pop(modes), [Diagnostic("E0101", open, pos, "unterminated string literal")])
  } else {
    (end, diagnostics) = scan_string_text(src, pos, [])
    with_diagnostics(one(StringText, pos, end, modes), diagnostics)
  }
}

## Stops before the closing `"`, an interpolation `#{`, a newline, or the end of the input. Also
## returns the diagnostics of the escapes.
fn scan_string_text(src: Array[Int], i: Int, found: List[Diagnostic]) -> (Int, List[Diagnostic]) {
  c = at(src, i)
  if c < 0 || c == QUOTE || c == LF || c == CR {
    (i, found)
  } else if c == HASH && at(src, i + 1) == L_BRACE {
    (i, found)
  } else if c == BACKSLASH {
    (next, diagnostics) = read_escape(src, i)
    next match {
      Some(n) -> scan_string_text(src, n, found.append(diagnostics))
      None    -> (i + 1, found.append(diagnostics))
    }
  } else {
    scan_string_text(src, i + 1, found)
  }
}

fn multi_string_step(src: Array[Int], pos: Int, modes: List[Mode]) -> Step {
  lines = modes match {
    [MultiStr(_, ls), ..] -> ls
    _                     -> []
  }
  closing = if at(src, pos - 1) == LF { closing_indent(src, pos) } else { None }
  closing match {
    Some(indent) -> {
      step = one(TripleQuote, pos, pos + indent + 3, pop(modes))
      with_diagnostics(step, under_indented(src, lines.reverse(), pos, indent))
    }
    None -> {
      if is_triple_quote(src, pos) {
        step = one(TripleQuote, pos, pos + 3, pop(modes))
        message = "the closing `\"\"\"` must be on its own line"
        with_diagnostics(step, [Diagnostic("E0109", pos, pos + 3, message)])
      } else if at(src, pos) == HASH && at(src, pos + 1) == L_BRACE {
        one(InterpStart, pos, pos + 2, [Interp(pos, 0), ..modes])
      } else {
        (end, new_lines, diagnostics) = scan_multiline_text(src, pos, [], [])
        more = modes match {
          [MultiStr(open, ls), ..rest] -> [MultiStr(open, new_lines.append(ls)), ..rest]
          _                            -> modes
        }
        with_diagnostics(one(StringText, pos, end, more), diagnostics)
      }
    }
  }
}

## The lines of a multiline string indented less than its closing line, whose indentation is the
## `indent` code points from `close`. Lines of only whitespace are not counted.
fn under_indented(src: Array[Int], lines: List[Int], close: Int, indent: Int) -> List[Diagnostic] {
  prefix = src.slice(close, close + indent)
  lines.filter_map(|start| {
    line_end = skip_while(src, start, |c| c != LF)
    ws = skip_while(src, start, is_blank) - start
    blank = skip_while(src, start, |c| is_blank(c) || c == CR) == line_end
    if start == close || blank || src.slice(start, start + indent) == prefix {
      None
    } else {
      message = "this line is indented less than the closing `\"\"\"`"
      Some(Diagnostic("E0109", start, start + ws + 1, message))
    }
  })
}

## Stops before `"""` and `#{`, and at the start of a line holding only the closing `"""`. Also
## returns the start of each line begun inside the body (newest first) and the diagnostics of the
## escapes.
fn scan_multiline_text(
  src: Array[Int],
  i: Int,
  lines: List[Int],
  found: List[Diagnostic],
) -> (Int, List[Int], List[Diagnostic]) {
  c = at(src, i)
  if c < 0 || is_triple_quote(src, i) {
    (i, lines, found)
  } else if c == HASH && at(src, i + 1) == L_BRACE {
    (i, lines, found)
  } else if c == LF {
    closing_indent(src, i + 1) match {
      Some(_) -> (i + 1, [i + 1, ..lines], found)
      None    -> scan_multiline_text(src, i + 1, [i + 1, ..lines], found)
    }
  } else if c == BACKSLASH {
    # A `\` before a newline does not end the body.
    (next, diagnostics) = read_escape(src, i)
    scan_multiline_text(src, next.or(i + 1), lines, found.append(diagnostics))
  } else {
    scan_multiline_text(src, i + 1, lines, found)
  }
}

## If the line from `i` holds only whitespace and `"""`, the width of the whitespace.
fn closing_indent(src: Array[Int], i: Int) -> Option[Int] {
  j = skip_while(src, i, is_blank)
  if is_triple_quote(src, j) { Some(j - i) } else { None }
}

fn is_triple_quote(src: Array[Int], i: Int) -> Bool {
  at(src, i) == QUOTE && at(src, i + 1) == QUOTE && at(src, i + 2) == QUOTE
}

## The end of the escape whose `\` is at `i`, and its diagnostics. The end is None if nothing
## follows the `\` on its line (the `\` stays in the body). Accepts `\" \\ \n \t \r \#` and
## `\u{...}`; any other escape gets a diagnostic over `\` and the next character.
fn read_escape(src: Array[Int], i: Int) -> (Option[Int], List[Diagnostic]) {
  c = at(src, i + 1)
  if c < 0 || c == LF || c == CR {
    (None, [Diagnostic("E0106", i, i + 1, "missing character after `\\`")])
  } else if c == QUOTE || c == BACKSLASH || c == 0x6E || c == 0x74 || c == 0x72 || c == HASH {
    (Some(i + 2), [])
  } else if c == 0x75 {
    (end, diagnostics) = unicode_escape(src, i)
    (Some(end), diagnostics)
  } else {
    message = "unknown escape sequence `\\#{slice(src, i + 1, i + 2)}`"
    (Some(i + 2), [Diagnostic("E0107", i, i + 2, message)])
  }
}

## A `\u{...}` ends after `}`; a malformed one at the last character read. Reports E0108 if it is
## malformed or its value is a surrogate or above 10FFFF.
fn unicode_escape(src: Array[Int], i: Int) -> (Int, List[Diagnostic]) {
  after_u = i + 2
  report = |end, message| (end, [Diagnostic("E0108", i, end, message)])
  if at(src, after_u) != L_BRACE {
    report(after_u, "expected `{` after `\\u`")
  } else {
    digits_end = skip_while(src, after_u + 1, is_hex)
    count = digits_end - after_u - 1
    if at(src, digits_end) != R_BRACE {
      report(digits_end, "unterminated unicode escape: expected `}`")
    } else if count < 1 || count > 6 {
      report(digits_end + 1, "a unicode escape needs 1 to 6 hex digits")
    } else {
      value = src.slice(after_u + 1, digits_end).fold(0, |v, d| v * 16 + hex_value(d))
      if value >= 0xD800 && value <= 0xDFFF {
        report(digits_end + 1, "a surrogate is not a Unicode scalar value")
      } else if value > 0x10FFFF {
        report(digits_end + 1, "out of range: the maximum is `\\u{10FFFF}`")
      } else {
        (digits_end + 1, [])
      }
    }
  }
}

fn hex_value(c: Int) -> Int {
  if is_digit(c) {
    c - 0x30
  } else if c >= 0x61 {
    c - 0x61 + 10
  } else {
    c - 0x41 + 10
  }
}

# Character classes

fn is_blank(c: Int) -> Bool { c == SPACE || c == TAB }

fn is_digit(c: Int) -> Bool { c >= 0x30 && c <= 0x39 }

fn is_digit_(c: Int) -> Bool { is_digit(c) || c == UNDERSCORE }

fn is_hex(c: Int) -> Bool {
  is_digit(c) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
}

fn is_bin(c: Int) -> Bool { c == 0x30 || c == 0x31 }

fn is_lower(c: Int) -> Bool { c >= 0x61 && c <= 0x7A }

fn is_upper(c: Int) -> Bool { c >= 0x41 && c <= 0x5A }

fn is_letter(c: Int) -> Bool { is_lower(c) || is_upper(c) }

fn is_word_start(c: Int) -> Bool { is_letter(c) || c == UNDERSCORE }

fn is_word(c: Int) -> Bool { is_letter(c) || is_digit(c) || c == UNDERSCORE }

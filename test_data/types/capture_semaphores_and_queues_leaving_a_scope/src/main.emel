import Std.Fiber.{Fiber}
import Std.Queue.{Queue}

fn semaphore_in_a_closure() -> fn() -> Int {
  Fiber.scope(|| {
    s = Fiber.semaphore(1)
    || s.available()
  })
}

fn queue_in_a_list() -> List[fn() -> Option[Int]] {
  Fiber.scope(|| {
    q: Queue[Int] = Fiber.queue(1)
    [|| q.poll()]
  })
}

fn piped() -> fn() -> Bool {
  (|| {
    q: Queue[Int] = Fiber.queue(1)
    || q.try_offer(1)
  }) |> Fiber.scope()
}

error Boom
error Bad(n: Int)

fn steady() -> Int { 1 }
fn fy(n: Int) -> Int fails Bad { fail Bad(n:) }

fn nothing_raised() -> Int {
  steady() escape { _ -> 0 }
}

fn below_on_nothing() -> Int {
  steady() escape {
    _ -> 0
    Boom -> 1
  }
}

fn below() -> Int {
  fy(1) escape {
    _ -> 0
    Bad(_) -> 1
    _ -> 2
  }
}

fn below_opaque[A](f: fn() -> A) -> A {
  f() escape {
    _ -> f()
    Boom -> f()
  }
}

fn after_total() -> Int {
  fy(1) escape {
    Bad(_) -> 0
    _ -> 1
  }
}

fn guarded(c: Bool) -> Int {
  fy(1) escape { _ if c -> 0 }
}

fn variable() -> Int {
  fy(1) escape { e -> 0 }
}

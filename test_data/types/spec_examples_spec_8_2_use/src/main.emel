error NotFound(id: Int)  # 補
type User(name: String)  # 補

effect Logger {  # 補
  fn info(msg: String) -> ()
}

effect Users {  # 補
  fn find(id: Int) -> Option[User]
}

effect Clock {  # 補
  fn sleep(ms: Int) -> ()
}

fn greet(id: Int) {
  log   = use Logger
  users = use Users

  user = users.find(id) match {  # 補: Option.or_fail はまだ同梱していない
    Some(u) -> u
    None -> fail NotFound(id:)
  }
  log.info("hello #{user.name}")

  (use Clock).sleep(1000)
  user
}

effect ReadFile {
  fn read(max: Int) -> Int
}

effect Files {
  handler Open(path: String): ReadFile
}

effect Logger {
  fn info(msg: String) -> ()
}

handler MemFiles: Files {
  handler Open(path: String): ReadFile {
    init(path: String) { Self(path:) }
    fn read(max) { max }
  }
}

handler Quiet: Logger {
  fn info(msg) { () }
}

handler Loud: Logger {
  fn info(msg) { () }
}

fn order() {
  with a = Files.Open("a"), MemFiles, quiet = Quiet, b = Files.Open("b"), Loud {
    quiet.info("x")
    (use Logger).info("y")
    a.read(1) + b.read(2)
  }
}

fn outside() {
  with a = Files.Open("a"), Quiet {
    a.read(1)
  }
}

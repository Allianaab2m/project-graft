import Std.Array.{Array}
import Std.Map.{Map}
import Std.Set.{Set}

error Boom

fn check(n: Int) -> () fails Boom { if n < 0 { fail Boom } }

fn lists(xs: List[Int]) {
  List.each(xs, check)
  xs.each(|_| ())
}

fn arrays(a: Array[Int]) {
  Array.each(a, check)
}

fn maps(m: Map[Int, String]) {
  Map.each(m, |key, _| check(key))
}

fn sets(s: Set[Int]) {
  Set.each(s, check)
}

fn returns_a_value(xs: List[Int]) {
  List.each(xs, |x| x + 1)
}
